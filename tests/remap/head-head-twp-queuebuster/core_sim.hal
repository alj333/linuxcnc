# Minimal XYZBC simulation for TWP remap regression coverage.

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

addf motion-command-handler servo-thread
addf motion-controller servo-thread

net Xpos joint.0.motor-pos-cmd => joint.0.motor-pos-fb
net Ypos joint.1.motor-pos-cmd => joint.1.motor-pos-fb
net Zpos joint.2.motor-pos-cmd => joint.2.motor-pos-fb
net Bpos joint.3.motor-pos-cmd => joint.3.motor-pos-fb
net Cpos joint.4.motor-pos-cmd => joint.4.motor-pos-fb

loadusr -Wn headheadtwp python3 ../../../configs/sim/head_head_5axis/head_head_twp_state.py

net Xpos => headheadtwp.current_joint_x
net Ypos => headheadtwp.current_joint_y
net Zpos => headheadtwp.current_joint_z
net Bpos => headheadtwp.current_joint_b
net Cpos => headheadtwp.current_joint_c

setp headheadtwp.nominal_c_to_b_x 0.0
setp headheadtwp.nominal_c_to_b_y 0.0
setp headheadtwp.nominal_c_to_b_z -270.0
setp headheadtwp.nominal_b_to_tool_x 2.0
setp headheadtwp.nominal_b_to_tool_y -22.0
setp headheadtwp.nominal_b_to_tool_z -305.517
setp headheadtwp.cal_c_to_b_x 0.0
setp headheadtwp.cal_c_to_b_y 0.0
setp headheadtwp.cal_c_to_b_z 0.0
setp headheadtwp.cal_b_to_tool_x 0.0
setp headheadtwp.cal_b_to_tool_y 0.0
setp headheadtwp.cal_b_to_tool_z 0.0
setp headheadtwp.b_zero_offset 0.0
setp headheadtwp.c_zero_offset 0.0
setp headheadtwp.requested_normal_rotation 0.0

net estop-loop iocontrol.0.user-enable-out iocontrol.0.emc-enable-in
net tool-prep-loop iocontrol.0.tool-prepare iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change iocontrol.0.tool-changed
