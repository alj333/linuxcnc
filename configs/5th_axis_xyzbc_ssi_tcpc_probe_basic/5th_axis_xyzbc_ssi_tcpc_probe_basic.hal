# TCPC test overlay for the real XYZBC SSI Probe Basic machine config.
#
# The INI loads the proven Mesa/SSI motion HAL first as a separate HALFILE.
# Keep this overlay free of "source" commands so twopass handles [KINS]/[EMCMOT]
# substitutions in the base HAL correctly.
# Do not use this for normal maintenance/setup until fixed-tip validation is
# complete on the real machine.

# First visual TCPC starting geometry from the saved C-sweep and B-vector
# candidate fit. Use for slow no-cut validation only; not final cutting data.
# First correction candidate from the 2026-04-29 expanded fixed-tip data.
# Keep this in the TCPC test config only until slow no-cut validation passes.
#
# TCPC test convention: commanded B+ is clockwise looking at the front of the
# head. The reused maintenance HAL currently labels the opposite physical
# direction as positive, so this TCPC overlay also flips the B SSI feedback
# scale and zero offset after the base HAL loads.
loadrt rotaryunwrap names=c_ssi_unwrap
loadrt oneshot names=tcpc_probe_gate_ignore,tcpc_probe_fault_pause
loadrt timedelay names=tcpc_spindle_air_hold,tcpc_spindle_air_precharge

# Temporary supervised TCPC calibration workaround for unreliable wireless probe
# pulses. The base HAL still builds the raw probe/toolsetter mux as "probe-mux";
# this overlay gates that signal with motion.digital-out-00. TCPC calibration
# G-code must use M64 P0 only during the actual G38 probe move and M65 P0
# immediately after, so false trips during transport/retract do not abort motion.
unlinkp motion.probe-input
unlinkp hm2_7i95.0.ssr.00.out-02
net probe-mux => and2.1.in0
net tcpc-probe-gate-enable <= motion.digital-out-00 => and2.1.in1
net tcpc-probe-gated <= and2.1.out => motion.probe-input hm2_7i95.0.ssr.00.out-02

# SSR out-03 supplies bearing air for the ceramic spindle. In this TCPC work
# config, a spindle request forces the air output on, holds it briefly after
# spindle-off, and delays the physical spindle relay/PWM enable for precharge.
unlinkp hm2_7i95.0.ssr.00.out-03
unlinkp hm2_7i95.0.ssr.00.out-00
unlinkp hm2_7i95.0.pwmgen.00.enable
unlinkp spindle.0.at-speed
setp tcpc_spindle_air_hold.on-delay 0.0
setp tcpc_spindle_air_hold.off-delay 5.0
setp tcpc_spindle_air_precharge.on-delay 1.0
setp tcpc_spindle_air_precharge.off-delay 0.0
net spindle-enable => tcpc_spindle_air_hold.in
net tcpc-spindle-air-hold <= tcpc_spindle_air_hold.out
net coolant-flood => or2.1.in0
net tcpc-spindle-air-hold => or2.1.in1
net tcpc-spindle-air <= or2.1.out => hm2_7i95.0.ssr.00.out-03
net spindle-enable => tcpc_spindle_air_precharge.in
net tcpc-spindle-enable-delayed <= tcpc_spindle_air_precharge.out
net tcpc-spindle-enable-delayed => hm2_7i95.0.ssr.00.out-00
net tcpc-spindle-enable-delayed => hm2_7i95.0.pwmgen.00.enable
net tcpc-spindle-enable-delayed => spindle.0.at-speed
addf tcpc_spindle_air_hold servo-thread
addf tcpc_spindle_air_precharge servo-thread

# Pause the running program on abnormal wireless probe activity without
# feeding that noise into motion.probe-input. A short ignore window after M65
# lets the valid G38 contact release before monitoring gate-closed pulses.
setp tcpc_probe_gate_ignore.width 0.25
setp tcpc_probe_gate_ignore.rising false
setp tcpc_probe_gate_ignore.falling true
setp tcpc_probe_gate_ignore.retriggerable true
setp tcpc_probe_fault_pause.width 0.25
setp tcpc_probe_fault_pause.rising true
setp tcpc_probe_fault_pause.falling false
setp tcpc_probe_fault_pause.retriggerable true

net tcpc-probe-gate-enable => tcpc_probe_gate_ignore.in
net tcpc-probe-ignore-active <= tcpc_probe_gate_ignore.out => not.2.in
net tcpc-probe-ignore-inactive <= not.2.out => and2.3.in1
net tcpc-probe-monitor-inhibit <= motion.digital-out-01 => not.3.in
net tcpc-probe-monitor-active <= not.3.out => and2.4.in1
net tcpc-probe-gate-enable => not.1.in
net tcpc-probe-gate-closed <= not.1.out => and2.2.in1
net t_probe-in => and2.2.in0
net tcpc-probe-closed-raw <= and2.2.out => and2.3.in0
net tcpc-probe-not-ignored <= and2.3.out => and2.4.in0
net tcpc-probe-abnormal-level <= and2.4.out => tcpc_probe_fault_pause.in
net tcpc-probe-fault-pause <= tcpc_probe_fault_pause.out

addf tcpc_probe_gate_ignore servo-thread
addf not.1 servo-thread
addf and2.2 servo-thread
addf not.2 servo-thread
addf and2.3 servo-thread
addf not.3 servo-thread
addf and2.4 servo-thread
addf tcpc_probe_fault_pause servo-thread

setp c_ssi_unwrap.wrap-period 360.0
setp hm2_7i95.0.ssi.00.abs.scale 2912.711111111111
# TCPC flips the B SSI sign. Keep the calibrated B0 equivalent near 0 deg,
# not +360 deg, so HOME_ABSOLUTE_ENCODER homing remains inside B soft limits.
setp b_ssi_zero.in1 -177.0848

setp headheadkins.nominal-c-to-b.x 0.010934
setp headheadkins.nominal-c-to-b.y 0.0
setp headheadkins.nominal-c-to-b.z -270.0
setp headheadkins.nominal-b-to-tool.x -0.668710
setp headheadkins.nominal-b-to-tool.y -26.721365
# B-to-tool is the B-axis centerline to spindle nose. The previous value was
# the short probe tip baseline, so T3 H3 is removed here and added back through
# active G43 tool length in headheadkins.
setp headheadkins.nominal-b-to-tool.z -180.373272
setp headheadkins.cal-c-to-b.x 0.035886006
setp headheadkins.cal-c-to-b.y 0.009526306
setp headheadkins.cal-c-to-b.z 0.0
setp headheadkins.cal-b-to-tool.x 0.0
setp headheadkins.cal-b-to-tool.y 0.0
setp headheadkins.cal-b-to-tool.z 0.815000
net tcpc-active-tool-offset-x motion.tooloffset.x => headheadkins.active-tool-offset.x
net tcpc-active-tool-offset-y motion.tooloffset.y => headheadkins.active-tool-offset.y
net tcpc-active-tool-offset-z motion.tooloffset.z => headheadkins.active-tool-offset.z
setp headheadkins.b-zero-offset 0.0
setp headheadkins.c-zero-offset -0.024500

# Refined persistent TCPC correction candidate.
# This work config is not released for production use yet. These terms are the
# best live-tested short-probe fit to date and are kept active here so the
# remaining commissioning tests exercise the full candidate system.
setp headheadkins.bharm-m.sin.x 0.015577123
setp headheadkins.bharm-m.sin.y 0.060508594
setp headheadkins.bharm-m.sin.z 0.312123080
setp headheadkins.bharm-m.omc.x 0.141330042
setp headheadkins.bharm-m.omc.y 0.111703959
setp headheadkins.bharm-m.omc.z -0.338104991
setp headheadkins.bharm-m.sin2.x -0.013271805
setp headheadkins.bharm-m.sin2.y 0.050707231
setp headheadkins.bharm-m.sin2.z -0.156014210

setp headheadkins.bharm-c.sin.x 0.000000000
setp headheadkins.bharm-c.sin.y 0.000000000
setp headheadkins.bharm-c.sin.z 0.000000000
setp headheadkins.bharm-c.omc.x 0.000000000
setp headheadkins.bharm-c.omc.y 0.000000000
setp headheadkins.bharm-c.omc.z 0.000000000
setp headheadkins.bharm-c.sin2.x 0.000000000
setp headheadkins.bharm-c.sin2.y 0.000000000
setp headheadkins.bharm-c.sin2.z 0.000000000

setp headheadkins.charm.cos.x 0.000000000
setp headheadkins.charm.cos.y 0.000000000
setp headheadkins.charm.cos.z 0.000000000
setp headheadkins.charm.sin.x 0.000000000
setp headheadkins.charm.sin.y 0.000000000
setp headheadkins.charm.sin.z 0.000000000
setp headheadkins.charm.cos2.x 0.000000000
setp headheadkins.charm.cos2.y 0.000000000
setp headheadkins.charm.cos2.z 0.000000000
setp headheadkins.charm.sin2.x 0.000000000
setp headheadkins.charm.sin2.y 0.000000000
setp headheadkins.charm.sin2.z 0.000000000

setp headheadkins.bmid.base.x 0.000000000
setp headheadkins.bmid.base.y 0.000000000
setp headheadkins.bmid.base.z 0.000000000
setp headheadkins.bmid.cosc.x 0.000000000
setp headheadkins.bmid.cosc.y 0.000000000
setp headheadkins.bmid.cosc.z 0.000000000
setp headheadkins.bmid.sinc.x 0.000000000
setp headheadkins.bmid.sinc.y 0.000000000
setp headheadkins.bmid.sinc.z 0.000000000
setp headheadkins.bmid.cos2c.x 0.000000000
setp headheadkins.bmid.cos2c.y 0.000000000
setp headheadkins.bmid.cos2c.z 0.000000000
setp headheadkins.bmid.sin2c.x 0.000000000
setp headheadkins.bmid.sin2c.y 0.000000000
setp headheadkins.bmid.sin2c.z 0.000000000

setp headheadkins.bcross.sinb-sinc.x -0.006371196
setp headheadkins.bcross.sinb-sinc.y 0.325723886
setp headheadkins.bcross.sinb-sinc.z 0.130042953
setp headheadkins.bcross.omcb-sinc.x -0.074687973
setp headheadkins.bcross.omcb-sinc.y 0.012622224
setp headheadkins.bcross.omcb-sinc.z -0.001729459
setp headheadkins.bcross.omcb-sin2c.x -0.017723675
setp headheadkins.bcross.omcb-sin2c.y -0.255875638
setp headheadkins.bcross.omcb-sin2c.z -0.055414262
setp headheadkins.bcross.sinb-cosc.x -0.048238059
setp headheadkins.bcross.sinb-cosc.y -0.063070849
setp headheadkins.bcross.sinb-cosc.z -0.018239994
setp headheadkins.bcross.omcb-cosc.x -0.030283175
setp headheadkins.bcross.omcb-cosc.y 0.071683484
setp headheadkins.bcross.omcb-cosc.z 0.000165632
setp headheadkins.bcross.sinb-sin2c.x 0.000000000
setp headheadkins.bcross.sinb-sin2c.y 0.000000000
setp headheadkins.bcross.sinb-sin2c.z 0.000000000
setp headheadkins.bcross.sinb-cos2c.x 0.000000000
setp headheadkins.bcross.sinb-cos2c.y 0.000000000
setp headheadkins.bcross.sinb-cos2c.z 0.000000000
setp headheadkins.sim-bharm-enable 1

setp headheadkins.tcpc-enable 0
setp headheadkins.tcpc-origin.x 0.0
setp headheadkins.tcpc-origin.y 0.0
setp headheadkins.tcpc-origin.z 0.0

# Start TCPC/TWP fail-safe: G43.4 enables TCPC after homing and G68.2 is
# rejected until TCPC is active.
loadusr -Wn headheadtwp python3 ./python/headhead_twp_state_safe.py

# Use the actual kinematics tool offset, including the refined fitted
# correction, for TCPC/TWP state calculations.
setp headheadtwp.use_external_tool_offset 1
net headhead-kins-tool-offset-x headheadkins.tool-offset.x => headheadtwp.external_tool_offset_x
net headhead-kins-tool-offset-y headheadkins.tool-offset.y => headheadtwp.external_tool_offset_y
net headhead-kins-tool-offset-z headheadkins.tool-offset.z => headheadtwp.external_tool_offset_z

# Snapshot the current commanded joint pose for the TWP state component.
net x-pos-cmd => headheadtwp.current_joint_x
net y-pos-cmd => headheadtwp.current_joint_y
net z-pos-cmd => headheadtwp.current_joint_z
net b-pos-cmd => headheadtwp.current_joint_b
net c-pos-cmd => headheadtwp.current_joint_c

# C uses a single-turn absolute SSI encoder. The base SSI HAL normalizes the
# startup angle, but that still jumps at the +/-180 deg encoder wrap. For TCPC
# quadrant testing the joint feedback must remain continuous, so unwrap the
# signed SSI feedback to the nearest commanded C angle before feeding joint.4.
unlinkp c_ssi_axis_scale.out
net c-ssi-wrapped-signed c_ssi_axis_scale.out => c_ssi_unwrap.wrapped
net c-pos-cmd => c_ssi_unwrap.command
net c-pos-fb <= c_ssi_unwrap.unwrapped
addf c_ssi_unwrap servo-thread

net headhead-joint-0-homed joint.0.homed => headheadtwp.joint_0_homed
net headhead-joint-1-homed joint.1.homed => headheadtwp.joint_1_homed
net headhead-joint-2-homed joint.2.homed => headheadtwp.joint_2_homed
net headhead-joint-3-homed joint.3.homed => headheadtwp.joint_3_homed
net headhead-joint-4-homed joint.4.homed => headheadtwp.joint_4_homed

# Keep the TWP state geometry in sync with headheadkins.
setp headheadtwp.nominal_c_to_b_x 0.010934
setp headheadtwp.nominal_c_to_b_y 0.0
setp headheadtwp.nominal_c_to_b_z -270.0
setp headheadtwp.nominal_b_to_tool_x -0.668710
setp headheadtwp.nominal_b_to_tool_y -26.721365
setp headheadtwp.nominal_b_to_tool_z -308.980001
setp headheadtwp.cal_c_to_b_x 0.035886006
setp headheadtwp.cal_c_to_b_y 0.009526306
setp headheadtwp.cal_c_to_b_z 0.0
setp headheadtwp.cal_b_to_tool_x 0.0
setp headheadtwp.cal_b_to_tool_y 0.0
setp headheadtwp.cal_b_to_tool_z 0.815000
setp headheadtwp.b_zero_offset 0.0
setp headheadtwp.c_zero_offset -0.024500
setp headheadtwp.requested_normal_rotation 0.0

# Feed the kinematics layer from the stored TWP state only after G68.2 enables
# TWP motion. With TWP off, ordinary headheadkins TCPC math is still active.
net headhead-tcpc-enabled headheadtwp.tcpc_enabled => headheadkins.tcpc-enable
net headhead-tcpc-origin-x headheadtwp.tcpc_origin_x => headheadkins.tcpc-origin.x
net headhead-tcpc-origin-y headheadtwp.tcpc_origin_y => headheadkins.tcpc-origin.y
net headhead-tcpc-origin-z headheadtwp.tcpc_origin_z => headheadkins.tcpc-origin.z
net headhead-twp-motion-enabled headheadtwp.motion_enabled => headheadkins.twp-mode
net headhead-twp-b-angle headheadtwp.twp_b_angle => headheadkins.twp-angle.b
net headhead-twp-c-angle headheadtwp.twp_c_angle => headheadkins.twp-angle.c
net headhead-twp-normal-rotation headheadtwp.twp_normal_rotation => headheadkins.twp-normal-rotation
net machine-is-enabled => headheadtwp.machine_is_enabled
