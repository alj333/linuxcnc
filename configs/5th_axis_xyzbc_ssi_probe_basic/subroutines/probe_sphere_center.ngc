(Measure a fixed sphere center at the current rotary pose without changing WCO)
(Assumes the probe is already at a safe clearance above the sphere and roughly)
(over the sphere center in X/Y before the cycle starts)
(Custom sphere measurement wrapper. Probe Basic has no native sphere routine;)
(only reuse its basic probe setup values where the mapping is explicit.)

o<probe_sphere_center> sub

  #<probe_tool_number> = #1
  #<sphere_diameter> = #2
  #<calibration_offset> = #3
  #<max_z_distance> = #4
  #<max_xy_distance> = #5
  #<xy_clearance> = #6
  #<z_clearance> = #7
  #<step_off_width> = #8
  #<probe_slow_fr> = #9
  #<probe_fast_fr> = #10
  #<x_hint> = #11
  #<y_hint> = #12
  #<probe_traverse_fr> = #13

  G92.1

  o<100> if [#<_hal[iocontrol.0.tool-number]> NE #<probe_tool_number>]
    (MSG, Specified probe tool not in spindle, aborting sphere cycle)
    o<probe_sphere_center> return
  o<100> endif

  #<sphere_radius> = [#<sphere_diameter> / 2.0]
  #<probe_diameter> = #<_hal[halui.tool.diameter]>
  o<probe_diameter_check> if [#<probe_diameter> LE 0]
      (abort, Probe tool diameter is zero in tool table, aborting)
  o<probe_diameter_check> endif
  #<probe_radius> = [#<probe_diameter> / 2.0]
  #<effective_probe_radius> = [#<probe_radius> - #<calibration_offset>]

  #<x_rel_to_abs> = [#<_abs_x> - #<_x>]
  #<y_rel_to_abs> = [#<_abs_y> - #<_y>]
  #<z_rel_to_abs> = [#<_abs_z> - #<_z>]

  o<90> if [#<probe_traverse_fr> LE 0]
    #<probe_traverse_fr> = 300.0
  o<90> endif
  o<91> if [#<probe_traverse_fr> GT 300.0]
    #<probe_traverse_fr> = 300.0
  o<91> endif

  (Top touch for sphere Z center)
  G90
  F#<probe_traverse_fr>
  G1 X#<x_hint> Y#<y_hint>
  o<probe_z_minus_sub> call [#<probe_tool_number>] [#<probe_slow_fr>] [#<probe_fast_fr>] [#<probe_traverse_fr>] [#<max_z_distance>] [#<z_clearance>] [1]

  o<110> if [#5070 EQ 0]
    (MSG, Sphere top probe failed)
    o<probe_sphere_center> return
  o<110> endif

  #<z_top_contact> = #5063
  #<sphere_center_z> = [#<z_top_contact> - #<sphere_radius> - #<effective_probe_radius>]
  #<top_clearance_z> = [#<z_top_contact> + #<z_clearance>]
  #<side_probe_z> = [#<sphere_center_z> + 1.5]

  (X plus surface from the left side)
  G90
  F#<probe_traverse_fr>
  G1 Z#<top_clearance_z>
  G1 X[#<x_hint> - #<sphere_radius> - #<step_off_width>] Y#<y_hint>
  G1 Z#<side_probe_z>
  o<probe_x_plus> call [#<probe_tool_number>] [#<probe_slow_fr>] [#<probe_fast_fr>] [#<probe_traverse_fr>] [#<max_xy_distance>] [#<xy_clearance>] [#<calibration_offset>]

  o<120> if [#<_value_returned> EQ 0]
    (MSG, Sphere X+ probe failed)
    o<probe_sphere_center> return
  o<120> endif

  #<x_plus_surface> = #<_value>

  (X minus surface from the right side)
  G90
  F#<probe_traverse_fr>
  G1 Z#<top_clearance_z>
  G1 X[#<x_hint> + #<sphere_radius> + #<step_off_width>] Y#<y_hint>
  G1 Z#<side_probe_z>
  o<probe_x_minus> call [#<probe_tool_number>] [#<probe_slow_fr>] [#<probe_fast_fr>] [#<probe_traverse_fr>] [#<max_xy_distance>] [#<xy_clearance>] [#<calibration_offset>]

  o<130> if [#<_value_returned> EQ 0]
    (MSG, Sphere X- probe failed)
    o<probe_sphere_center> return
  o<130> endif

  #<x_minus_surface> = #<_value>
  #<sphere_center_x> = [[#<x_plus_surface> + #<x_minus_surface>] / 2.0]
  #<x_equator_diameter> = [#<x_minus_surface> - #<x_plus_surface>]

  (Y plus surface from the front side)
  G90
  F#<probe_traverse_fr>
  G1 Z#<top_clearance_z>
  G1 X#<sphere_center_x> Y[#<y_hint> - #<sphere_radius> - #<step_off_width>]
  G1 Z#<side_probe_z>
  o<probe_y_plus> call [#<probe_tool_number>] [#<probe_slow_fr>] [#<probe_fast_fr>] [#<probe_traverse_fr>] [#<max_xy_distance>] [#<xy_clearance>] [#<calibration_offset>]

  o<140> if [#<_value_returned> EQ 0]
    (MSG, Sphere Y+ probe failed)
    o<probe_sphere_center> return
  o<140> endif

  #<y_plus_surface> = #<_value>

  (Y minus surface from the back side)
  G90
  F#<probe_traverse_fr>
  G1 Z#<top_clearance_z>
  G1 X#<sphere_center_x> Y[#<y_hint> + #<sphere_radius> + #<step_off_width>]
  G1 Z#<side_probe_z>
  o<probe_y_minus> call [#<probe_tool_number>] [#<probe_slow_fr>] [#<probe_fast_fr>] [#<probe_traverse_fr>] [#<max_xy_distance>] [#<xy_clearance>] [#<calibration_offset>]

  o<150> if [#<_value_returned> EQ 0]
    (MSG, Sphere Y- probe failed)
    o<probe_sphere_center> return
  o<150> endif

  #<y_minus_surface> = #<_value>
  #<sphere_center_y> = [[#<y_plus_surface> + #<y_minus_surface>] / 2.0]
  #<y_equator_diameter> = [#<y_minus_surface> - #<y_plus_surface>]

  #<sphere_center_abs_x> = [#<sphere_center_x> + #<x_rel_to_abs>]
  #<sphere_center_abs_y> = [#<sphere_center_y> + #<y_rel_to_abs>]
  #<sphere_center_abs_z> = [#<sphere_center_z> + #<z_rel_to_abs>]

  #113 = #<_abs_b>
  #114 = #<_abs_c>
  #115 = #<probe_tool_number>
  #116 = #<calibration_offset>
  #117 = #<sphere_center_x>
  #118 = #<sphere_center_y>
  #119 = #<sphere_center_z>
  #120 = #<sphere_center_abs_x>
  #121 = #<sphere_center_abs_y>
  #122 = #<sphere_center_abs_z>
  #123 = #<x_equator_diameter>
  #124 = #<y_equator_diameter>
  #125 = #<z_top_contact>

  G90
  F#<probe_traverse_fr>
  G1 Z#<top_clearance_z>
  G1 X#<sphere_center_x> Y#<sphere_center_y>

  (LOG,#113,#114,#115,#116,#117,#118,#119,#120,#121,#122,#123,#124,#125)

  (DEBUG, SPHERE_RESULT pose_abs_b=#<_abs_b> pose_abs_c=#<_abs_c>)
  (DEBUG, SPHERE_RESULT rel_center_x=#<sphere_center_x> rel_center_y=#<sphere_center_y> rel_center_z=#<sphere_center_z>)
  (DEBUG, SPHERE_RESULT abs_center_x=#<sphere_center_abs_x> abs_center_y=#<sphere_center_abs_y> abs_center_z=#<sphere_center_abs_z>)
  (DEBUG, SPHERE_RESULT x_equator_diameter=#<x_equator_diameter> y_equator_diameter=#<y_equator_diameter> top_contact_z=#<z_top_contact>)

o<probe_sphere_center> endsub

M2
