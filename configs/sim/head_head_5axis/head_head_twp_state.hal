# Prototype TWP state component for the head-head simulation.

loadusr -Wn headheadtwp python3 ./head_head_twp_state.py

# Snapshot the current simulated joint pose.
net Xpos => headheadtwp.current_joint_x
net Ypos => headheadtwp.current_joint_y
net Zpos => headheadtwp.current_joint_z
net Bpos => headheadtwp.current_joint_b
net Cpos => headheadtwp.current_joint_c

# Keep the TWP state geometry in sync with the current nominal simulation model.
setp headheadtwp.nominal_c_to_b_x 0.0
setp headheadtwp.nominal_c_to_b_y 0.0
setp headheadtwp.nominal_c_to_b_z -270.0
setp headheadtwp.nominal_b_to_tool_x 0.0
setp headheadtwp.nominal_b_to_tool_y 25.0
setp headheadtwp.nominal_b_to_tool_z -180.0
setp headheadtwp.cal_c_to_b_x 0.0
setp headheadtwp.cal_c_to_b_y 0.0
setp headheadtwp.cal_c_to_b_z 0.0
setp headheadtwp.cal_b_to_tool_x 0.0
setp headheadtwp.cal_b_to_tool_y 0.0
setp headheadtwp.cal_b_to_tool_z 0.0
setp headheadtwp.b_zero_offset 0.0
setp headheadtwp.c_zero_offset 0.0
setp headheadtwp.requested_normal_rotation 0.0
