#!/bin/bash
# Snapshot TWP origin from the current tool-tip position.
set -e
if [ -f /home/cnc5/linuxcnc-dev/scripts/rip-environment ]; then
    . /home/cnc5/linuxcnc-dev/scripts/rip-environment
fi
halcmd setp headheadtwp.cmd_set_origin_from_current 1
sleep 0.3
halcmd setp headheadtwp.cmd_set_origin_from_current 0
exit 0
