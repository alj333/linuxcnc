# Rough articulated visual model for the head-head XYZBC simulation.

loadusr -Wn headheadvismach ./head_head_vismach.py

net vis-x joint.0.motor-pos-fb => headheadvismach.joint_x
net vis-y joint.1.motor-pos-fb => headheadvismach.joint_y
net vis-z joint.2.motor-pos-fb => headheadvismach.joint_z
net vis-b joint.3.motor-pos-fb => headheadvismach.joint_b
net vis-c joint.4.motor-pos-fb => headheadvismach.joint_c

# Mirror the same nominal geometry used by headheadkins.
setp headheadvismach.c_to_b_x 0.0
setp headheadvismach.c_to_b_y 0.0
setp headheadvismach.c_to_b_z 0.0
setp headheadvismach.b_to_tool_x 0.0
setp headheadvismach.b_to_tool_y 25.0
setp headheadvismach.b_to_tool_z -180.0
setp headheadvismach.b_zero_offset 0.0
setp headheadvismach.c_zero_offset 0.0
setp headheadvismach.tool_length 0.0
setp headheadvismach.tool_diameter 20.0
