# user space components
#loadusr -W hal_manualtoolchange

# Kinematics
loadrt [KINS]KINEMATICS


# Motion Controller - info from the INI file
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS


# standard components
#loadrt pid num_chan=6
# loadrt pid names=pid.x,pid.y,pid.z,pid.b,pid.c,pid.s

# Joint/axis support
loadrt pid names=pid.x,pid.y,pid.z,pid.b,pid.c,pid.w,pid.s,J0_pid,J1_pid,J2_pid,J3_pid,J4_pid,J5_pid,J6_pid 
