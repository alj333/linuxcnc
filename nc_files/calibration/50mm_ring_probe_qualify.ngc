%
(50 mm ring qualification plus a three-round verification attempt for the guarded T3/T4 campaign.)
(Start 3-4 mm onto the left wall from the bore, centered in Y, within 15 mm above the top.)
(The fixed +X 10 mm step places the 6 mm ball center safely inside the bore.)
(This cycle keeps G43 H3/H4 and stops after logging the first failed verification gate.)
(The averaged-diameter capability gate is 0.010 mm; directional behavior remains diagnostic.)

G21 G17 G40 G64 P0.001 G80 G90 G94

o<preview_guard> if [#<_task> EQ 0]
  (DEBUG, RING_QUALIFY_50MM preview only)
  M2
o<preview_guard> endif

(Required operator selectors. Sentinel defaults abort before motion.)
#715 = 2026082201.0   (campaign ID YYYYMMDDNN)
#727 = 0.0            (reserved 4-ID base; set explicitly before a reviewed run)

M65 P0
M65 P1

o<campaign_integral> if [ABS[#715 - FIX[#715]] GT 0.000001]
  (abort, Ring campaign ID #715 must be an integer YYYYMMDDNN)
o<campaign_integral> endif
o<campaign_low> if [#715 LT 2020010100.0]
  (abort, Set ring campaign ID #715 to YYYYMMDDNN)
o<campaign_low> endif
o<campaign_high> if [#715 GT 2099123199.0]
  (abort, Ring campaign ID #715 is outside the accepted YYYYMMDDNN range)
o<campaign_high> endif
o<attempt_integral> if [ABS[#727 - FIX[#727]] GT 0.000001]
  (abort, Ring qualification attempt #727 must be a positive integer)
o<attempt_integral> endif
o<attempt_low> if [#727 LT 0.5]
  (abort, Set ring qualification attempt #727 to 1 or the next retry)
o<attempt_low> endif

o<machine_on_required> if [#<_hal[halui.machine.is-on]> LT 0.5]
  (abort, Ring qualification requires the machine enabled)
o<machine_on_required> endif
o<all_homed_required> if [[#<_hal[joint.0.homed]> + #<_hal[joint.1.homed]> + #<_hal[joint.2.homed]> + #<_hal[joint.3.homed]> + #<_hal[joint.4.homed]>] LT 4.5]
  (abort, Ring qualification requires all five joints homed)
o<all_homed_required> endif
o<spindle_off_required> if [#<_hal[spindle.0.on]> GT 0.5]
  (abort, Ring qualification requires the spindle stopped)
o<spindle_off_required> endif
o<tcpc_off_required> if [#<_hal[headheadtwp.tcpc_enabled]> GT 0.5]
  (abort, Exit TCPC with G49.1 before ring qualification)
o<tcpc_off_required> endif
o<twp_clear_required> if [[#<_hal[headheadtwp.active]> + #<_hal[headheadtwp.motion_enabled]> + #<_hal[headheadtwp.valid]>] GT 0.5]
  (abort, Ring qualification requires TWP off and undefined)
o<twp_clear_required> endif
o<ssi_valid_required> if [[#<_hal[b-ssi-invalid]> + #<_hal[c-ssi-invalid]>] GT 0.5]
  (abort, Ring qualification requires valid B and C SSI feedback)
o<ssi_valid_required> endif

#<b_cmd_zero_error> = ABS[[[#<_hal[headheadtwp.current_joint_b]> + 540.0] MOD 360.0] - 180.0]
#<b_fb_zero_error> = ABS[[[#<_hal[joint.3.pos-fb]> + 540.0] MOD 360.0] - 180.0]
#<b_ssi_zero_error> = ABS[[[#<_hal[b-ssi-zeroed-position]> + 540.0] MOD 360.0] - 180.0]
#<c_cmd_zero_error> = ABS[[[#<_hal[headheadtwp.current_joint_c]> + 540.0] MOD 360.0] - 180.0]
#<c_fb_zero_error> = ABS[[[#<_hal[joint.4.pos-fb]> + 540.0] MOD 360.0] - 180.0]
#<c_ssi_zero_error> = ABS[[[#<_hal[c-ssi-zeroed-position]> + 540.0] MOD 360.0] - 180.0]
o<b_zero_required> if [[#<b_cmd_zero_error> GT 0.005] OR [#<b_fb_zero_error> GT 0.005] OR [#<b_ssi_zero_error> GT 0.005]]
  (abort, Ring qualification requires B command feedback and SSI at B0)
o<b_zero_required> endif
o<c_zero_required> if [[#<c_cmd_zero_error> GT 0.005] OR [#<c_fb_zero_error> GT 0.005] OR [#<c_ssi_zero_error> GT 0.005]]
  (abort, Ring qualification requires C command feedback and SSI at C0)
o<c_zero_required> endif

o<raw_probe_clear> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
  (abort, Ring qualification requires all probe inputs clear)
o<raw_probe_clear> endif
o<probe_gates_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5]]
  (abort, Ring qualification requires both probe gates clear)
o<probe_gates_clear> endif

#<probe_tool_number> = #<_hal[iocontrol.0.tool-number]>
#<expected_tool_length> = 0.0
o<short_probe_selected> if [ABS[#<probe_tool_number> - 3.0] LT 0.1]
  #<expected_tool_length> = 128.606729
o<short_probe_selected> endif
o<long_probe_selected> if [ABS[#<probe_tool_number> - 4.0] LT 0.1]
  #<expected_tool_length> = 229.407000
o<long_probe_selected> endif
o<known_probe_required> if [#<expected_tool_length> LT 1.0]
  (abort, Ring qualification requires live T3 H3 or T4 H4)
o<known_probe_required> endif

#<probe_diameter> = #<_hal[halui.tool.diameter]>
o<diameter_low> if [#<probe_diameter> LT 5.99]
  (abort, Ring qualification requires a live 6 mm probe diameter)
o<diameter_low> endif
o<diameter_high> if [#<probe_diameter> GT 6.01]
  (abort, Ring qualification requires a live 6 mm probe diameter)
o<diameter_high> endif

#<motion_tlo_z> = #<_hal[motion.tooloffset.z]>
#<halui_tlo_z> = #<_hal[halui.tool.length_offset.z]>
#<kins_tlo_z> = #<_hal[headheadkins.active-tool-offset.z]>
o<motion_tlo_required> if [ABS[#<motion_tlo_z> - #<expected_tool_length>] GT 0.002]
  (abort, Ring qualification motion TLO does not match H3 or H4)
o<motion_tlo_required> endif
o<halui_tlo_required> if [ABS[#<halui_tlo_z> - #<expected_tool_length>] GT 0.002]
  (abort, Ring qualification HALUI TLO does not match H3 or H4)
o<halui_tlo_required> endif
o<kins_tlo_required> if [ABS[#<kins_tlo_z> - #<expected_tool_length>] GT 0.002]
  (abort, Ring qualification kinematics TLO does not match H3 or H4)
o<kins_tlo_required> endif
o<tlo_x_zero> if [ABS[#<_hal[motion.tooloffset.x]>] GT 0.002]
  (abort, Ring qualification requires zero active X tool offset)
o<tlo_x_zero> endif
o<tlo_y_zero> if [ABS[#<_hal[motion.tooloffset.y]>] GT 0.002]
  (abort, Ring qualification requires zero active Y tool offset)
o<tlo_y_zero> endif
o<tlo_abc_zero> if [[ABS[#<_hal[motion.tooloffset.a]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.b]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.c]>] GT 0.002]]
  (abort, Ring qualification requires zero active A B and C tool offsets)
o<tlo_abc_zero> endif
o<tlo_uvw_zero> if [[ABS[#<_hal[motion.tooloffset.u]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.v]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.w]>] GT 0.002]]
  (abort, Ring qualification requires zero active U V and W tool offsets)
o<tlo_uvw_zero> endif

o<g92_x_zero> if [ABS[#5211] GT 0.0001]
  (abort, Ring qualification requires G92 X zero)
o<g92_x_zero> endif
o<g92_y_zero> if [ABS[#5212] GT 0.0001]
  (abort, Ring qualification requires G92 Y zero)
o<g92_y_zero> endif
o<g92_z_zero> if [ABS[#5213] GT 0.0001]
  (abort, Ring qualification requires G92 Z zero)
o<g92_z_zero> endif

o<wcs_index_valid> if [[#5220 LT 0.5] OR [#5220 GT 9.5] OR [ABS[#5220 - FIX[#5220]] GT 0.000001]]
  (abort, Ring qualification requires a valid integral active WCS index)
o<wcs_index_valid> endif
o<wcs_rotary_offsets_zero> if [[ABS[#[5205 + [20 * #5220]]] GT 0.0001] OR [ABS[#[5206 + [20 * #5220]]] GT 0.0001]]
  (abort, Ring qualification requires active WCS B and C offsets zero)
o<wcs_rotary_offsets_zero> endif
o<wcs_xy_rotation_zero> if [ABS[#[5210 + [20 * #5220]]] GT 0.0001]
  (abort, Ring qualification requires zero active WCS XY rotation)
o<wcs_xy_rotation_zero> endif

#<wcs_index> = #5220
#<wcs_x_before> = #[5201 + [20 * #<wcs_index>]]
#<wcs_y_before> = #[5202 + [20 * #<wcs_index>]]
#<wcs_z_before> = #[5203 + [20 * #<wcs_index>]]
#<wcs_a_before> = #[5204 + [20 * #<wcs_index>]]
#<wcs_b_before> = #[5205 + [20 * #<wcs_index>]]
#<wcs_c_before> = #[5206 + [20 * #<wcs_index>]]
#<wcs_u_before> = #[5207 + [20 * #<wcs_index>]]
#<wcs_v_before> = #[5208 + [20 * #<wcs_index>]]
#<wcs_w_before> = #[5209 + [20 * #<wcs_index>]]
#<wcs_rotation_before> = #[5210 + [20 * #<wcs_index>]]
#<calibration_before> = #3032
#<campaign_snapshot> = #715
#<attempt_snapshot> = #727
#<hold_abs_x> = #<_abs_x>
#<hold_abs_y> = #<_abs_y>
#<hold_abs_z> = #<_abs_z>

(MSG, Confirm T3 or T4, G43, left-wall start, +X10 bore entry, and clearance. Qualification will replace #3032.)
M0

(Reject selector or coordinate-state changes made across the operator hold.)
o<campaign_unchanged_after_hold> if [ABS[#715 - #<campaign_snapshot>] GT 0.000001]
  (abort, Ring campaign ID changed during the operator hold; reload the program)
o<campaign_unchanged_after_hold> endif
o<attempt_unchanged_after_hold> if [ABS[#727 - #<attempt_snapshot>] GT 0.000001]
  (abort, Ring qualification attempt changed during the operator hold; reload the program)
o<attempt_unchanged_after_hold> endif
o<calibration_unchanged_after_hold> if [ABS[#3032 - #<calibration_before>] GT 0.0005]
  (abort, Live #3032 changed during the operator hold; reload the program)
o<calibration_unchanged_after_hold> endif
o<wcs_index_unchanged_after_hold> if [ABS[#5220 - #<wcs_index>] GT 0.0001]
  (abort, Active WCS changed during the operator hold; reload the program)
o<wcs_index_unchanged_after_hold> endif
o<wcs_xyz_unchanged_after_hold> if [[ABS[#[5201 + [20 * #<wcs_index>]] - #<wcs_x_before>] GT 0.0001] OR [ABS[#[5202 + [20 * #<wcs_index>]] - #<wcs_y_before>] GT 0.0001] OR [ABS[#[5203 + [20 * #<wcs_index>]] - #<wcs_z_before>] GT 0.0001]]
  (abort, Active WCS offsets changed during the operator hold; reload the program)
o<wcs_xyz_unchanged_after_hold> endif
o<wcs_abc_unchanged_after_hold> if [[ABS[#[5204 + [20 * #<wcs_index>]] - #<wcs_a_before>] GT 0.0001] OR [ABS[#[5205 + [20 * #<wcs_index>]] - #<wcs_b_before>] GT 0.0001] OR [ABS[#[5206 + [20 * #<wcs_index>]] - #<wcs_c_before>] GT 0.0001]]
  (abort, Active WCS ABC offsets changed during the operator hold; reload the program)
o<wcs_abc_unchanged_after_hold> endif
o<wcs_uvw_unchanged_after_hold> if [[ABS[#[5207 + [20 * #<wcs_index>]] - #<wcs_u_before>] GT 0.0001] OR [ABS[#[5208 + [20 * #<wcs_index>]] - #<wcs_v_before>] GT 0.0001] OR [ABS[#[5209 + [20 * #<wcs_index>]] - #<wcs_w_before>] GT 0.0001]]
  (abort, Active WCS UVW offsets changed during the operator hold; reload the program)
o<wcs_uvw_unchanged_after_hold> endif
o<wcs_rotation_unchanged_after_hold> if [ABS[#[5210 + [20 * #<wcs_index>]] - #<wcs_rotation_before>] GT 0.0001]
  (abort, Active WCS rotation changed during the operator hold; reload the program)
o<wcs_rotation_unchanged_after_hold> endif
o<xyz_unchanged_after_hold> if [[ABS[#<_abs_x> - #<hold_abs_x>] GT 0.001] OR [ABS[#<_abs_y> - #<hold_abs_y>] GT 0.001] OR [ABS[#<_abs_z> - #<hold_abs_z>] GT 0.001]]
  (abort, XYZ position changed during the operator hold; re-establish the reviewed ring start)
o<xyz_unchanged_after_hold> endif

(Rewrite the fixed campaign contract after the operator hold, then validate it.)
G21 G17 G40 G64 P0.001 G80 G90 G94
#3014 = #<probe_tool_number>
#3015 = 50.0          (slow probe feed)
#3016 = 100.0         (fast probe feed)
#3017 = 300.0         (bounded traverse feed)
#3018 = 35.0          (maximum XY probe distance)
#3019 = 1.0           (XY clearance)
#3020 = 15.0          (maximum Z probe distance)
#3021 = 2.0           (Z clearance)
#3022 = 0.0           (extra probe depth)
#3023 = 10.0          (left wall to safe bore position for 6 mm ball)
#3024 = 5.0           (edge width)
#3025 = 50.001        (certified stamped ring diameter hint)
#3030 = 1.0           (measurement-only; never write WCS)
#3033 = 50.001        (certified stamped qualification ring diameter)
#3036 = 0.0           (average X/Y calibration)
o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [0.0] [0.0]

(DEBUG, RING_QUALIFY_50MM start campaign=#715 attempt=#727 tool=#<probe_tool_number>)
o<tcpc_ring_cal_round_pocket> call

M65 P0
M65 P1

o<new_calibration_low> if [#3032 LE 0.0]
  (abort, Ring qualification produced a nonpositive calibration offset)
o<new_calibration_low> endif
o<new_calibration_high> if [#3032 GT 1.0]
  (abort, Ring qualification produced a calibration offset over 1 mm)
o<new_calibration_high> endif
o<wcs_index_preserved> if [ABS[#5220 - #<wcs_index>] GT 0.0001]
  (abort, Ring qualification changed the active WCS)
o<wcs_index_preserved> endif
o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#3032]

#<motion_tlo_z> = #<_hal[motion.tooloffset.z]>
#<halui_tlo_z> = #<_hal[halui.tool.length_offset.z]>
#<kins_tlo_z> = #<_hal[headheadkins.active-tool-offset.z]>

#<wcs_x_after> = #[5201 + [20 * #<wcs_index>]]
#<wcs_y_after> = #[5202 + [20 * #<wcs_index>]]
#<wcs_z_after> = #[5203 + [20 * #<wcs_index>]]
#<wcs_a_after> = #[5204 + [20 * #<wcs_index>]]
#<wcs_b_after> = #[5205 + [20 * #<wcs_index>]]
#<wcs_c_after> = #[5206 + [20 * #<wcs_index>]]
#<wcs_u_after> = #[5207 + [20 * #<wcs_index>]]
#<wcs_v_after> = #[5208 + [20 * #<wcs_index>]]
#<wcs_w_after> = #[5209 + [20 * #<wcs_index>]]
#<wcs_rotation_after> = #[5210 + [20 * #<wcs_index>]]
o<wcs_unchanged> if [[ABS[#<wcs_x_after> - #<wcs_x_before>] GT 0.0001] OR [ABS[#<wcs_y_after> - #<wcs_y_before>] GT 0.0001] OR [ABS[#<wcs_z_after> - #<wcs_z_before>] GT 0.0001]]
  (abort, Ring qualification unexpectedly changed the active WCS)
o<wcs_unchanged> endif
o<wcs_abc_unchanged> if [[ABS[#<wcs_a_after> - #<wcs_a_before>] GT 0.0001] OR [ABS[#<wcs_b_after> - #<wcs_b_before>] GT 0.0001] OR [ABS[#<wcs_c_after> - #<wcs_c_before>] GT 0.0001]]
  (abort, Ring qualification unexpectedly changed active WCS ABC offsets)
o<wcs_abc_unchanged> endif
o<wcs_uvw_unchanged> if [[ABS[#<wcs_u_after> - #<wcs_u_before>] GT 0.0001] OR [ABS[#<wcs_v_after> - #<wcs_v_before>] GT 0.0001] OR [ABS[#<wcs_w_after> - #<wcs_w_before>] GT 0.0001]]
  (abort, Ring qualification unexpectedly changed active WCS UVW offsets)
o<wcs_uvw_unchanged> endif
o<wcs_rotation_unchanged> if [ABS[#<wcs_rotation_after> - #<wcs_rotation_before>] GT 0.0001]
  (abort, Ring qualification unexpectedly changed active WCS rotation)
o<wcs_rotation_unchanged> endif
o<probe_released> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5]]
  (abort, Probe did not release after ring qualification)
o<probe_released> endif

#<qualified_calibration> = #3032
#<inter_round_z_lift> = 5.0

(Validate the known center and Z-clearance endpoint before automatic repositioning.)
M66 E0 L0
#<expected_finish_z> = [#1009 + #3021]
o<qv_qual_finish_xy> if [[ABS[#5420 - #1002] GT 0.010] OR [ABS[#5421 - #1004] GT 0.010]]
  (abort, Qualification did not finish at its measured XY center)
o<qv_qual_finish_xy> endif
o<qv_qual_finish_z> if [ABS[#5422 - #<expected_finish_z>] GT 0.010]
  (abort, Qualification did not finish at its expected Z clearance)
o<qv_qual_finish_z> endif

(Lift before crossing the ring wall, then derive an exact left-wall start.)
o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
o<tcpc_ring_position_no_contact> call [3] [0] [#<inter_round_z_lift>] [#3017]
o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
#<wall_target_y> = #1004
#<wall_target_x> = [#1002 - [#3033 / 2.0] - 3.5]
#<wall_target_z> = [#<expected_finish_z> + #<inter_round_z_lift>]
o<qv_qual_y_adjust> if [ABS[#5421 - #<wall_target_y>] GT 0.001]
  o<tcpc_ring_position_no_contact> call [2] [1] [#<wall_target_y>] [#3017]
  o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
o<qv_qual_y_adjust> endif
o<tcpc_ring_position_no_contact> call [1] [1] [#<wall_target_x>] [#3017]
o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
o<qv_qual_wall_xy> if [[ABS[#5420 - #<wall_target_x>] GT 0.010] OR [ABS[#5421 - #<wall_target_y>] GT 0.010]]
  (abort, Qualification could not establish the calculated verification wall start)
o<qv_qual_wall_xy> endif
o<qv_qual_wall_z> if [ABS[#5422 - #<wall_target_z>] GT 0.010]
  (abort, Qualification verification wall start has unexpected Z clearance)
o<qv_qual_wall_z> endif

(Log qualification only after the protected return reached a safe wall start.)
#1100 = #<probe_tool_number>
#1101 = #<expected_tool_length>
#1102 = #<calibration_before>
#1103 = #<wcs_index>
#1104 = #<wcs_x_before>
#1105 = #<wcs_y_before>
#1106 = #<wcs_z_before>
#1107 = #<wcs_x_after>
#1108 = #<wcs_y_after>
#1109 = #<wcs_z_after>
#1110 = #<motion_tlo_z>
#1111 = #<halui_tlo_z>
#1112 = #<kins_tlo_z>
(LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-long-short-ring-results.csv)
(LOG,#<campaign_snapshot>,#<attempt_snapshot>,1,#1100,#1101,#1102,#3032,#1001,#1003,#1010,#1002,#1004,#1103,#1104,#1105,#1106,#1107,#1108,#1109,#1110,#1111,#1112)
(LOGCLOSE)

(Freeze every state item across the candidate-review hold.)
M65 P0
M65 P1
#<qv_campaign_snapshot> = #715
#<qv_attempt_snapshot> = #727
#<qv_calibration_snapshot> = #3032
#<qv_wcs_index_snapshot> = #5220
#<qv_wcs_x_snapshot> = #[5201 + [20 * #5220]]
#<qv_wcs_y_snapshot> = #[5202 + [20 * #5220]]
#<qv_wcs_z_snapshot> = #[5203 + [20 * #5220]]
#<qv_wcs_a_snapshot> = #[5204 + [20 * #5220]]
#<qv_wcs_b_snapshot> = #[5205 + [20 * #5220]]
#<qv_wcs_c_snapshot> = #[5206 + [20 * #5220]]
#<qv_wcs_u_snapshot> = #[5207 + [20 * #5220]]
#<qv_wcs_v_snapshot> = #[5208 + [20 * #5220]]
#<qv_wcs_w_snapshot> = #[5209 + [20 * #5220]]
#<qv_wcs_rotation_snapshot> = #[5210 + [20 * #5220]]
#<qv_hold_abs_x> = #<_abs_x>
#<qv_hold_abs_y> = #<_abs_y>
#<qv_hold_abs_z> = #<_abs_z>

(DEBUG, RING_QUALIFY_50MM qualification logged candidate=#3032)
(MSG, Qualification logged and wall start restored. Review #3032, then resume to attempt three verifications; first failed gate stops.)
M0

o<qv_campaign_unchanged> if [ABS[#715 - #<qv_campaign_snapshot>] GT 0.000001]
  (abort, Ring campaign ID changed during the verification hold)
o<qv_campaign_unchanged> endif
o<qv_attempt_unchanged> if [ABS[#727 - #<qv_attempt_snapshot>] GT 0.000001]
  (abort, Ring base attempt changed during the verification hold)
o<qv_attempt_unchanged> endif
o<qv_calibration_unchanged> if [ABS[#3032 - #<qv_calibration_snapshot>] GT 0.000001]
  (abort, Live #3032 changed during the verification hold)
o<qv_calibration_unchanged> endif
o<qv_wcs_index_unchanged> if [ABS[#5220 - #<qv_wcs_index_snapshot>] GT 0.0001]
  (abort, Active WCS changed during the verification hold)
o<qv_wcs_index_unchanged> endif
o<qv_wcs_xyz_unchanged> if [[ABS[#[5201 + [20 * #5220]] - #<qv_wcs_x_snapshot>] GT 0.0001] OR [ABS[#[5202 + [20 * #5220]] - #<qv_wcs_y_snapshot>] GT 0.0001] OR [ABS[#[5203 + [20 * #5220]] - #<qv_wcs_z_snapshot>] GT 0.0001]]
  (abort, Active WCS XYZ changed during the verification hold)
o<qv_wcs_xyz_unchanged> endif
o<qv_wcs_abc_unchanged> if [[ABS[#[5204 + [20 * #5220]] - #<qv_wcs_a_snapshot>] GT 0.0001] OR [ABS[#[5205 + [20 * #5220]] - #<qv_wcs_b_snapshot>] GT 0.0001] OR [ABS[#[5206 + [20 * #5220]] - #<qv_wcs_c_snapshot>] GT 0.0001]]
  (abort, Active WCS ABC changed during the verification hold)
o<qv_wcs_abc_unchanged> endif
o<qv_wcs_uvw_unchanged> if [[ABS[#[5207 + [20 * #5220]] - #<qv_wcs_u_snapshot>] GT 0.0001] OR [ABS[#[5208 + [20 * #5220]] - #<qv_wcs_v_snapshot>] GT 0.0001] OR [ABS[#[5209 + [20 * #5220]] - #<qv_wcs_w_snapshot>] GT 0.0001]]
  (abort, Active WCS UVW changed during the verification hold)
o<qv_wcs_uvw_unchanged> endif
o<qv_wcs_rotation_unchanged> if [ABS[#[5210 + [20 * #5220]] - #<qv_wcs_rotation_snapshot>] GT 0.0001]
  (abort, Active WCS rotation changed during the verification hold)
o<qv_wcs_rotation_unchanged> endif
o<qv_xyz_unchanged> if [[ABS[#<_abs_x> - #<qv_hold_abs_x>] GT 0.001] OR [ABS[#<_abs_y> - #<qv_hold_abs_y>] GT 0.001] OR [ABS[#<_abs_z> - #<qv_hold_abs_z>] GT 0.001]]
  (abort, XYZ changed during the verification hold)
o<qv_xyz_unchanged> endif

(Restore and validate the fixed contract before the automatic set.)
G21 G17 G40 G64 P0.001 G80 G90 G94
#717 = #<qualified_calibration>
#3014 = #<probe_tool_number>
#3015 = 50.0
#3016 = 100.0
#3017 = 300.0
#3018 = 35.0
#3019 = 1.0
#3020 = 15.0
#3021 = 2.0
#3022 = 0.0
#3023 = 10.0
#3024 = 5.0
#3025 = 50.001
#3030 = 1.0
#3032 = #717
#3033 = 50.001
#3036 = 0.0
o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]

#<qv_index> = 0
#<qv_max_diameter_error> = 0.0
#<qv_x_min> = 0.0
#<qv_x_max> = 0.0
#<qv_y_min> = 0.0
#<qv_y_max> = 0.0
#<qv_average_min> = 0.0
#<qv_average_max> = 0.0

o<qv_loop> repeat [3]
  #<qv_index> = [#<qv_index> + 1]
  #<qv_attempt> = [#<qv_attempt_snapshot> + #<qv_index>]
  o<qv_round_start_campaign> if [ABS[#715 - #<qv_campaign_snapshot>] GT 0.000001]
    (abort, Campaign selector changed before an integrated ring verification round)
  o<qv_round_start_campaign> endif
  o<qv_round_start_attempt> if [ABS[#727 - #<qv_attempt_snapshot>] GT 0.000001]
    (abort, Base attempt selector changed before an integrated ring verification round)
  o<qv_round_start_attempt> endif
  o<qv_round_start_wcs_index> if [ABS[#5220 - #<qv_wcs_index_snapshot>] GT 0.000001]
    (abort, Active WCS changed before an integrated ring verification round)
  o<qv_round_start_wcs_index> endif
  o<qv_round_start_calibration> if [ABS[#3032 - #<qualified_calibration>] GT 0.000001]
    (abort, Live #3032 changed before an integrated ring verification round)
  o<qv_round_start_calibration> endif
  #<calibration_before> = #3032
  #<wcs_x_before> = #[5201 + [20 * #<qv_wcs_index_snapshot>]]
  #<wcs_y_before> = #[5202 + [20 * #<qv_wcs_index_snapshot>]]
  #<wcs_z_before> = #[5203 + [20 * #<qv_wcs_index_snapshot>]]

  o<qv_round_start_wcs_xyz> if [[ABS[#<wcs_x_before> - #<qv_wcs_x_snapshot>] GT 0.0001] OR [ABS[#<wcs_y_before> - #<qv_wcs_y_snapshot>] GT 0.0001] OR [ABS[#<wcs_z_before> - #<qv_wcs_z_snapshot>] GT 0.0001]]
    (abort, Integrated ring verification start WCS XYZ differs from the frozen state)
  o<qv_round_start_wcs_xyz> endif
  o<qv_round_start_frozen> if [ABS[#717 - #<qualified_calibration>] GT 0.000001]
    (abort, Integrated ring verification frozen selector changed)
  o<qv_round_start_frozen> endif
  o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
  (DEBUG, RING_VERIFY_INTEGRATED start campaign=#715 attempt=#<qv_attempt> tool=#<probe_tool_number>)
  o<tcpc_ring_round_pocket> call

  M65 P0
  M65 P1
  M66 E0 L0
  #<expected_finish_z> = [#1009 + #3021]
  o<qv_round_finish_xy> if [[ABS[#5420 - #1002] GT 0.010] OR [ABS[#5421 - #1004] GT 0.010]]
    (abort, Integrated ring verification did not finish at its measured XY center)
  o<qv_round_finish_xy> endif
  o<qv_round_finish_z> if [ABS[#5422 - #<expected_finish_z>] GT 0.010]
    (abort, Integrated ring verification did not finish at expected Z clearance)
  o<qv_round_finish_z> endif
  o<qv_round_calibration> if [ABS[#3032 - #<qualified_calibration>] GT 0.000001]
    (abort, Integrated ring verification changed the frozen calibration offset)
  o<qv_round_calibration> endif
  o<qv_round_frozen> if [ABS[#717 - #<qualified_calibration>] GT 0.000001]
    (abort, Integrated ring verification changed the frozen selector)
  o<qv_round_frozen> endif
  o<qv_round_wcs_index> if [ABS[#5220 - #<qv_wcs_index_snapshot>] GT 0.000001]
    (abort, Integrated ring verification changed the active WCS)
  o<qv_round_wcs_index> endif
  o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]

  #<motion_tlo_z> = #<_hal[motion.tooloffset.z]>
  #<halui_tlo_z> = #<_hal[halui.tool.length_offset.z]>
  #<kins_tlo_z> = #<_hal[headheadkins.active-tool-offset.z]>
  #<wcs_x_after> = #[5201 + [20 * #<qv_wcs_index_snapshot>]]
  #<wcs_y_after> = #[5202 + [20 * #<qv_wcs_index_snapshot>]]
  #<wcs_z_after> = #[5203 + [20 * #<qv_wcs_index_snapshot>]]
  o<qv_round_wcs_xyz> if [[ABS[#<wcs_x_after> - #<wcs_x_before>] GT 0.0001] OR [ABS[#<wcs_y_after> - #<wcs_y_before>] GT 0.0001] OR [ABS[#<wcs_z_after> - #<wcs_z_before>] GT 0.0001]]
    (abort, Integrated ring verification unexpectedly changed WCS XYZ)
  o<qv_round_wcs_xyz> endif
  o<qv_round_frozen_wcs_xyz> if [[ABS[#<wcs_x_after> - #<qv_wcs_x_snapshot>] GT 0.0001] OR [ABS[#<wcs_y_after> - #<qv_wcs_y_snapshot>] GT 0.0001] OR [ABS[#<wcs_z_after> - #<qv_wcs_z_snapshot>] GT 0.0001]]
    (abort, Integrated ring verification WCS XYZ differs from the frozen state)
  o<qv_round_frozen_wcs_xyz> endif
  o<qv_round_wcs_abc> if [[ABS[#[5204 + [20 * #<wcs_index>]] - #<wcs_a_before>] GT 0.0001] OR [ABS[#[5205 + [20 * #<wcs_index>]] - #<wcs_b_before>] GT 0.0001] OR [ABS[#[5206 + [20 * #<wcs_index>]] - #<wcs_c_before>] GT 0.0001]]
    (abort, Integrated ring verification unexpectedly changed WCS ABC)
  o<qv_round_wcs_abc> endif
  o<qv_round_wcs_uvw> if [[ABS[#[5207 + [20 * #<wcs_index>]] - #<wcs_u_before>] GT 0.0001] OR [ABS[#[5208 + [20 * #<wcs_index>]] - #<wcs_v_before>] GT 0.0001] OR [ABS[#[5209 + [20 * #<wcs_index>]] - #<wcs_w_before>] GT 0.0001]]
    (abort, Integrated ring verification unexpectedly changed WCS UVW)
  o<qv_round_wcs_uvw> endif
  o<qv_round_wcs_rotation> if [ABS[#[5210 + [20 * #<wcs_index>]] - #<wcs_rotation_before>] GT 0.0001]
    (abort, Integrated ring verification unexpectedly changed WCS rotation)
  o<qv_round_wcs_rotation> endif
  o<qv_round_probe_released> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5]]
    (abort, Probe did not release after integrated ring verification)
  o<qv_round_probe_released> endif

  #1100 = #<probe_tool_number>
  #1101 = #<expected_tool_length>
  #1102 = #<calibration_before>
  #1103 = #<qv_wcs_index_snapshot>
  #1104 = #<wcs_x_before>
  #1105 = #<wcs_y_before>
  #1106 = #<wcs_z_before>
  #1107 = #<wcs_x_after>
  #1108 = #<wcs_y_after>
  #1109 = #<wcs_z_after>
  #1110 = #<motion_tlo_z>
  #1111 = #<halui_tlo_z>
  #1112 = #<kins_tlo_z>
  #1113 = #<qv_attempt>
  (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-long-short-ring-results.csv)
  (LOG,#<qv_campaign_snapshot>,#1113,2,#1100,#1101,#1102,#3032,#1001,#1003,#1010,#1002,#1004,#1103,#1104,#1105,#1106,#1107,#1108,#1109,#1110,#1111,#1112)
  (LOGCLOSE)

  o<qv_first_result> if [#<qv_index> EQ 1]
    #<qv_x_min> = #1002
    #<qv_x_max> = #1002
    #<qv_y_min> = #1004
    #<qv_y_max> = #1004
    #<qv_average_min> = #1010
    #<qv_average_max> = #1010
  o<qv_first_result> else
    o<qv_x_min_update> if [#1002 LT #<qv_x_min>]
      #<qv_x_min> = #1002
    o<qv_x_min_update> endif
    o<qv_x_max_update> if [#1002 GT #<qv_x_max>]
      #<qv_x_max> = #1002
    o<qv_x_max_update> endif
    o<qv_y_min_update> if [#1004 LT #<qv_y_min>]
      #<qv_y_min> = #1004
    o<qv_y_min_update> endif
    o<qv_y_max_update> if [#1004 GT #<qv_y_max>]
      #<qv_y_max> = #1004
    o<qv_y_max_update> endif
    o<qv_average_min_update> if [#1010 LT #<qv_average_min>]
      #<qv_average_min> = #1010
    o<qv_average_min_update> endif
    o<qv_average_max_update> if [#1010 GT #<qv_average_max>]
      #<qv_average_max> = #1010
    o<qv_average_max_update> endif
  o<qv_first_result> endif
  #<qv_diameter_error> = ABS[#1010 - #3033]
  o<qv_max_diameter_update> if [#<qv_diameter_error> GT #<qv_max_diameter_error>]
    #<qv_max_diameter_error> = #<qv_diameter_error>
  o<qv_max_diameter_update> endif
  #<qv_x_range> = [#<qv_x_max> - #<qv_x_min>]
  #<qv_y_range> = [#<qv_y_max> - #<qv_y_min>]
  #<qv_average_range> = [#<qv_average_max> - #<qv_average_min>]
  o<qv_round_diameter_gate> if [#<qv_diameter_error> GT 0.010]
    (abort, Integrated ring average exceeded 0.010 mm; diagnostic row retained at measured-center clearance)
  o<qv_round_diameter_gate> endif
  o<qv_round_average_range_gate> if [#<qv_average_range> GT 0.010]
    (abort, Integrated ring average range exceeded 0.010 mm; rows retained at measured-center clearance)
  o<qv_round_average_range_gate> endif
  o<qv_round_x_range_gate> if [#<qv_x_range> GT 0.010]
    (abort, Integrated ring X center range exceeded 0.010 mm; rows retained at measured-center clearance)
  o<qv_round_x_range_gate> endif
  o<qv_round_y_range_gate> if [#<qv_y_range> GT 0.010]
    (abort, Integrated ring Y center range exceeded 0.010 mm; rows retained at measured-center clearance)
  o<qv_round_y_range_gate> endif

  o<qv_more_rounds> if [#<qv_index> LT 3]
    o<qv_reposition_campaign> if [ABS[#715 - #<qv_campaign_snapshot>] GT 0.000001]
      (abort, Campaign selector changed before integrated ring repositioning)
    o<qv_reposition_campaign> endif
    o<qv_reposition_attempt> if [ABS[#727 - #<qv_attempt_snapshot>] GT 0.000001]
      (abort, Base attempt selector changed before integrated ring repositioning)
    o<qv_reposition_attempt> endif
    o<qv_reposition_wcs_index> if [ABS[#5220 - #<qv_wcs_index_snapshot>] GT 0.000001]
      (abort, Active WCS changed before integrated ring repositioning)
    o<qv_reposition_wcs_index> endif
    o<qv_reposition_calibration> if [ABS[#3032 - #<qualified_calibration>] GT 0.000001]
      (abort, Live #3032 changed before integrated ring repositioning)
    o<qv_reposition_calibration> endif
    o<qv_reposition_frozen> if [ABS[#717 - #<qualified_calibration>] GT 0.000001]
      (abort, Frozen selector changed before integrated ring repositioning)
    o<qv_reposition_frozen> endif
    o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
    o<tcpc_ring_position_no_contact> call [3] [0] [#<inter_round_z_lift>] [#3017]
    o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
    #<wall_target_y> = #1004
    #<wall_target_x> = [#1002 - [#3033 / 2.0] - 3.5]
    #<wall_target_z> = [#<expected_finish_z> + #<inter_round_z_lift>]
    o<qv_round_y_adjust> if [ABS[#5421 - #<wall_target_y>] GT 0.001]
      o<tcpc_ring_position_no_contact> call [2] [1] [#<wall_target_y>] [#3017]
      o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
    o<qv_round_y_adjust> endif
    o<tcpc_ring_position_no_contact> call [1] [1] [#<wall_target_x>] [#3017]
    o<tcpc_ring_live_guard> call [#<probe_tool_number>] [#<expected_tool_length>] [1.0] [#<qualified_calibration>]
    o<qv_round_wall_xy> if [[ABS[#5420 - #<wall_target_x>] GT 0.010] OR [ABS[#5421 - #<wall_target_y>] GT 0.010]]
      (abort, Integrated ring verification could not restore its calculated wall start)
    o<qv_round_wall_xy> endif
    o<qv_round_wall_z> if [ABS[#5422 - #<wall_target_z>] GT 0.010]
      (abort, Integrated ring verification wall start has unexpected Z clearance)
    o<qv_round_wall_z> endif
  o<qv_more_rounds> endif
o<qv_loop> endrepeat

#<qv_x_range> = [#<qv_x_max> - #<qv_x_min>]
#<qv_y_range> = [#<qv_y_max> - #<qv_y_min>]
#<qv_average_range> = [#<qv_average_max> - #<qv_average_min>]
(DEBUG, RING_VERIFY_INTEGRATED max_diameter_error=#<qv_max_diameter_error> average_range=#<qv_average_range> x_range=#<qv_x_range> y_range=#<qv_y_range>)
o<qv_diameter_gate> if [#<qv_max_diameter_error> GT 0.010]
  (abort, One or more integrated ring averages exceeded the 0.010 mm diameter gate)
o<qv_diameter_gate> endif
o<qv_average_range_gate> if [#<qv_average_range> GT 0.010]
  (abort, Integrated ring verification average-diameter range exceeded 0.010 mm)
o<qv_average_range_gate> endif
o<qv_x_range_gate> if [#<qv_x_range> GT 0.010]
  (abort, Integrated ring verification X center range exceeded 0.010 mm)
o<qv_x_range_gate> endif
o<qv_y_range_gate> if [#<qv_y_range> GT 0.010]
  (abort, Integrated ring verification Y center range exceeded 0.010 mm)
o<qv_y_range_gate> endif

(DEBUG, RING_QUALIFY_VERIFY_50MM numeric gates passed - review directional trend before acceptance)
M2
%
