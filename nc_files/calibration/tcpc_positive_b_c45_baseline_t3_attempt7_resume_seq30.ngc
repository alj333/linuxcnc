o<tcpc_c45_sweep_at_b> sub
  #<sweep_b> = #1
  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
  o<skip_bminus30_c45> if [ABS[#<sweep_b> + 30.0] GT 0.001]
    o<tcpc_measure_pose> call [#<sweep_b>] [45.0]
  o<skip_bminus30_c45> endif
  o<tcpc_measure_pose> call [#<sweep_b>] [90.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [135.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [180.0]
  o<skip_bplus30_c225> if [ABS[#<sweep_b> - 30.0] GT 0.001]
    o<tcpc_measure_pose> call [#<sweep_b>] [225.0]
  o<skip_bplus30_c225> endif
  o<tcpc_measure_pose> call [#<sweep_b>] [270.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [315.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
o<tcpc_c45_sweep_at_b> endsub

o<run_detailed_c45_sweep> if [#711 GT 6.5]
  o<run_detailed_c45_sweep_only> if [#711 LT 7.5]
    (Detailed C sweep for C-center/reference and low-B TCPC diagnostics.)
    (Sequence per B group: C0/C45/C90/C135/C180/C225/C270/C315/C0.)
    (Run with headheadkins.sim-bharm-enable FALSE unless deliberately testing it.)
    (Safety skips: B-30 C45 and B+30 C225 are omitted for sphere stand clearance.)
    (C45 and C225 align near the sphere stand; monitor the first sweep closely.)
    o<tcpc_c45_sweep_at_b> call [0.0]
    o<tcpc_c45_sweep_at_b> call [10.0]
    o<tcpc_c45_sweep_at_b> call [-10.0]
    o<tcpc_c45_sweep_at_b> call [30.0]
    o<tcpc_c45_sweep_at_b> call [-30.0]
  o<run_detailed_c45_sweep_only> endif
o<run_detailed_c45_sweep> endif

o<tcpc_tool_length_c_sweep_at_b> sub
  #<sweep_b> = #1
  #<include_quadrants> = #2

  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [45.0]
  o<tool_length_include_c90> if [#<include_quadrants> GT 0.5]
    o<tcpc_measure_pose> call [#<sweep_b>] [90.0]
  o<tool_length_include_c90> endif
  #<skip_c135> = 0.0
  o<skip_c135_nonzero_b> if [ABS[#<sweep_b>] GT 0.001]
    #<skip_c135> = 1.0
  o<skip_c135_nonzero_b> endif
  o<run_c135_when_safe> if [#<skip_c135> LT 0.5]
    o<tcpc_measure_pose> call [#<sweep_b>] [135.0]
  o<run_c135_when_safe> endif
  o<tcpc_measure_pose> call [#<sweep_b>] [180.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [225.0]
  o<tool_length_include_c270> if [#<include_quadrants> GT 0.5]
    o<tcpc_measure_pose> call [#<sweep_b>] [270.0]
  o<tool_length_include_c270> endif
  #<skip_c315> = 0.0
  o<skip_c315_nonzero_b> if [ABS[#<sweep_b>] GT 0.001]
    #<skip_c315> = 1.0
  o<skip_c315_nonzero_b> endif
  o<run_c315_when_safe> if [#<skip_c315> LT 0.5]
    o<tcpc_measure_pose> call [#<sweep_b>] [315.0]
  o<run_c315_when_safe> endif
  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
o<tcpc_tool_length_c_sweep_at_b> endsub

o<tcpc_pair_c_quadrants_at_b> sub
  #<pair_sweep_b> = #1

  (C0 guards every B transition. Avoid C45/C225 near the sphere stand.)
  o<tcpc_measure_pose> call [#<pair_sweep_b>] [0.0]
  o<tcpc_measure_pose> call [#<pair_sweep_b>] [90.0]
  o<tcpc_measure_pose> call [#<pair_sweep_b>] [180.0]
  o<tcpc_measure_pose> call [#<pair_sweep_b>] [270.0]
  o<tcpc_measure_pose> call [#<pair_sweep_b>] [0.0]
o<tcpc_pair_c_quadrants_at_b> endsub

o<tcpc_pair_trim_group_at_b> sub
  #<pair_trim_b> = #1

  (Keep every B transition at C0, then sample the proven +/-20 deg C trim.)
  o<tcpc_measure_pose> call [#<pair_trim_b>] [0.0]
  o<tcpc_measure_pose> call [#<pair_trim_b>] [20.0]
  o<tcpc_measure_pose> call [#<pair_trim_b>] [-20.0]
  o<tcpc_measure_pose> call [#<pair_trim_b>] [0.0]
o<tcpc_pair_trim_group_at_b> endsub

o<tcpc_tool_length_non_b0_groups> sub
  (Positive B groups, sweeping C at each B.)
  o<tcpc_tool_length_c_sweep_at_b> call [30.0] [0.0]
  o<tcpc_tool_length_c_sweep_at_b> call [60.0] [0.0]
  o<tcpc_tool_length_c_sweep_at_b> call [90.0] [0.0]

  (Negative B groups, sweeping C at each B.)
  o<tcpc_tool_length_c_sweep_at_b> call [-90.0] [0.0]
  o<tcpc_tool_length_c_sweep_at_b> call [-60.0] [0.0]
  o<tcpc_tool_length_c_sweep_at_b> call [-30.0] [0.0]

  (Final B0 closure.)
  o<tcpc_tool_length_c_sweep_at_b> call [0.0] [0.0]
o<tcpc_tool_length_non_b0_groups> endsub

o<tcpc_full_safe_grid_non_b0_groups> sub
  (Positive B groups, sweeping all safe C points at each B.)
  o<tcpc_tool_length_c_sweep_at_b> call [30.0] [1.0]
  o<tcpc_tool_length_c_sweep_at_b> call [60.0] [1.0]
  o<tcpc_tool_length_c_sweep_at_b> call [90.0] [1.0]

  (Negative B groups, sweeping all safe C points at each B.)
  o<tcpc_tool_length_c_sweep_at_b> call [-90.0] [1.0]
  o<tcpc_tool_length_c_sweep_at_b> call [-60.0] [1.0]
  o<tcpc_tool_length_c_sweep_at_b> call [-30.0] [1.0]

  (Final B0 full C closure.)
  o<tcpc_tool_length_c_sweep_at_b> call [0.0] [1.0]
o<tcpc_full_safe_grid_non_b0_groups> endsub

o<tcpc_full_safe_grid_resume_after_bminus90_c45> sub
  (Resume after B-90 C45 completed and B-90 C90 missed first -U touch.)
  (Operator start: B0 C0, 4-5 mm above the sphere.)
  (Fresh B0 C0 gives a current center without repeating the completed grid.)
  o<tcpc_measure_pose> call [0.0] [0.0]

  (Finish the interrupted B-90 C group from C90 onward.)
  o<tcpc_measure_pose> call [-90.0] [90.0]
  o<tcpc_measure_pose> call [-90.0] [180.0]
  o<tcpc_measure_pose> call [-90.0] [225.0]
  o<tcpc_measure_pose> call [-90.0] [270.0]
  o<tcpc_measure_pose> call [-90.0] [0.0]

  (Remaining negative B groups.)
  o<tcpc_tool_length_c_sweep_at_b> call [-60.0] [1.0]
  o<tcpc_tool_length_c_sweep_at_b> call [-30.0] [1.0]

  (Final B0 full C closure.)
  o<tcpc_tool_length_c_sweep_at_b> call [0.0] [1.0]
o<tcpc_full_safe_grid_resume_after_bminus90_c45> endsub

o<tcpc_tool_length_c90_c270_at_b> sub
  #<sweep_b> = #1

  (Probe C0 before changing C so B transitions happen at the clear center.)
  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [90.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [270.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
o<tcpc_tool_length_c90_c270_at_b> endsub

o<tcpc_tool_length_c90_c270_supplement> sub
