    (abort, Live kinematics Z tool offset changed during paired sphere run)
  o<pair_kins_tlo_live> endif
  o<pair_tlo_x_live> if [ABS[#<_hal[motion.tooloffset.x]>] GT 0.002]
    (abort, Paired sphere run requires zero active X tool offset)
  o<pair_tlo_x_live> endif
  o<pair_tlo_y_live> if [ABS[#<_hal[motion.tooloffset.y]>] GT 0.002]
    (abort, Paired sphere run requires zero active Y tool offset)
  o<pair_tlo_y_live> endif
  o<pair_tlo_abc_live> if [[ABS[#<_hal[motion.tooloffset.a]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.b]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.c]>] GT 0.002]]
    (abort, Paired sphere run requires zero active A B and C tool offsets)
  o<pair_tlo_abc_live> endif
  o<pair_tlo_uvw_live> if [[ABS[#<_hal[motion.tooloffset.u]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.v]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.w]>] GT 0.002]]
    (abort, Paired sphere run requires zero active U V and W tool offsets)
  o<pair_tlo_uvw_live> endif

  #720 = #<_hal[headheadtwp.tcpc_enabled]>
  #721 = #<_hal[headheadtwp.active]>
  #722 = #<_hal[headheadtwp.motion_enabled]>
  #723 = #<_hal[headheadtwp.valid]>
  #724 = #<_hal[b-ssi-invalid]>
  #725 = #<_hal[c-ssi-invalid]>
  o<pair_tcpc_live> if [#720 LT 0.5]
    (abort, TCPC is not enabled during paired sphere run)
  o<pair_tcpc_live> endif
  o<pair_twp_clear_live> if [[#721 + #722 + #723] GT 0.5]
    (abort, TWP state is present during paired sphere run)
  o<pair_twp_clear_live> endif
  o<pair_ssi_valid_live> if [[#724 + #725] GT 0.5]
    (abort, Rotary SSI feedback is invalid during paired sphere run)
  o<pair_ssi_valid_live> endif

  o<pair_probe_gates_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5]]
    (abort, Paired sphere probe gates are not clear before motion)
  o<pair_probe_gates_clear> endif
  o<pair_probe_inputs_clear> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
    (abort, Paired sphere probe input is active before a probe move)
  o<pair_probe_inputs_clear> endif

  o<pair_pose_check> if [#<check_pose> GT 0.5]
    #<b_cmd_error> = ABS[[[#<_hal[headheadtwp.current_joint_b]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<b_fb_error> = ABS[[[#<_hal[joint.3.pos-fb]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<b_ssi_error> = ABS[[[#<_hal[b-ssi-zeroed-position]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<c_cmd_error> = ABS[[[#<_hal[headheadtwp.current_joint_c]> - #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    #<c_fb_error> = ABS[[[#<_hal[joint.4.pos-fb]> - #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    (The physical C SSI zeroed signal has the opposite polarity to joint C.)
    #<c_ssi_error> = ABS[[[#<_hal[c-ssi-zeroed-position]> + #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    o<pair_b_pose_live> if [[#<b_cmd_error> GT 0.01] OR [#<b_fb_error> GT 0.01] OR [#<b_ssi_error> GT 0.01]]
      (abort, B command feedback or SSI is outside paired pose tolerance)
    o<pair_b_pose_live> endif
    o<pair_c_pose_live> if [[#<c_cmd_error> GT 0.01] OR [#<c_fb_error> GT 0.01] OR [#<c_ssi_error> GT 0.01]]
      (abort, C command feedback or SSI is outside paired pose tolerance)
    o<pair_c_pose_live> endif
  o<pair_pose_check> endif
o<tcpc_pair_live_guard> endsub

o<tcpc_pair_release_guard> sub
  #<release_target_b> = #1
  #<release_target_c> = #2

  (A valid wireless contact can repeat during the HAL post-G38 ignore window.)
  (After retract, require two consecutive clear samples 0.05 s apart within)
  (the configured post-contact timeout. The pre-G38 guard proves longer clear.)
  M66 E0 L0
  o<pair_release_hal_window_match> if [ABS[#<_hal[tcpc_probe_gate_ignore.width]> - #756] GT 0.001]
    (abort, Paired probe release wait does not match the HAL ignore window)
  o<pair_release_hal_window_match> endif
  o<pair_release_gate_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
    (abort, Paired sphere probe gate remained active after retract)
  o<pair_release_gate_clear> endif

  #<release_elapsed> = 0.0
  #<release_clear_count> = 0.0
  o<pair_release_wait> while [[#<release_elapsed> LT #756] AND [#<release_clear_count> LT 1.5]]
    G4 P0.05
    M66 E0 L0
    o<pair_release_gate_still_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
      (abort, Paired sphere probe gate reactivated after retract)
    o<pair_release_gate_still_clear> endif
    o<pair_release_sample_clear> if [[#<_hal[t_probe-in]> LT 0.5] AND [#<_hal[probe-mux]> LT 0.5]]
      #<release_clear_count> = [#<release_clear_count> + 1.0]
    o<pair_release_sample_clear> else
      #<release_clear_count> = 0.0
    o<pair_release_sample_clear> endif
    #<release_elapsed> = [#<release_elapsed> + 0.05]
  o<pair_release_wait> endwhile
  o<pair_release_timeout> if [#<release_clear_count> LT 1.5]
    (abort, Paired sphere probe did not release within post-contact timeout)
  o<pair_release_timeout> endif

  o<tcpc_pair_live_guard> call [1.0] [#<release_target_b>] [#<release_target_c>]
o<tcpc_pair_release_guard> endsub

o<tcpc_pair_probe_settle_guard> sub
  #<settle_target_b> = #1
  #<settle_target_c> = #2

  (Require a continuous raw-clear window at rest immediately before G38.)
  M66 E0 L0
  o<pair_settle_hal_width> if [ABS[#<_hal[tcpc_probe_fault_pause.width]> - 0.50] GT 0.001]
    (abort, Paired probe abnormal-pulse event latch is not 0.5 seconds)
  o<pair_settle_hal_width> endif
  o<pair_settle_ignore_width> if [ABS[#<_hal[tcpc_probe_gate_ignore.width]> - #756] GT 0.001]
    (abort, Paired probe post-contact ignore does not match the runner)
  o<pair_settle_ignore_width> endif

  #<settle_clear_elapsed> = 0.0
  #<settle_total_elapsed> = 0.0
  o<pair_settle_wait> while [[#<settle_clear_elapsed> LT #736] AND [#<settle_total_elapsed> LT #737]]
    G4 P#738
    M66 E0 L0
    #<settle_sample_ok> = 1.0
    o<pair_settle_probe_inputs> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
      #<settle_sample_ok> = 0.0
    o<pair_settle_probe_inputs> endif
    o<pair_settle_control_inputs> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5] OR [#<_hal[tcpc_probe_fault_pause.out]> GT 0.5]]
      #<settle_sample_ok> = 0.0
    o<pair_settle_control_inputs> endif
    o<pair_settle_ignore_active> if [#<_hal[tcpc_probe_gate_ignore.out]> GT 0.5]
      #<settle_sample_ok> = 0.0
    o<pair_settle_ignore_active> endif
    o<pair_settle_sample_clear> if [#<settle_sample_ok> GT 0.5]
      #<settle_clear_elapsed> = [#<settle_clear_elapsed> + #738]
    o<pair_settle_sample_clear> else
      #<settle_clear_elapsed> = 0.0
    o<pair_settle_sample_clear> endif
    #<settle_total_elapsed> = [#<settle_total_elapsed> + #738]
  o<pair_settle_wait> endwhile

  o<pair_settle_timeout> if [#<settle_clear_elapsed> LT #736]
    (abort, Paired probe did not remain continuously clear for 20 seconds)
  o<pair_settle_timeout> endif

  o<tcpc_pair_live_guard> call [1.0] [#<settle_target_b>] [#<settle_target_c>]

  (Synchronize and close the sampling-to-G38 gap with one final hard check.)
  M66 E0 L0
  o<pair_settle_final_probe_inputs> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
    (abort, Paired probe input changed after the clear settle interval)
  o<pair_settle_final_probe_inputs> endif
  o<pair_settle_final_gates> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5]]
    (abort, Paired probe gate changed after the clear settle interval)
  o<pair_settle_final_gates> endif
  o<pair_settle_final_monitors> if [[#<_hal[tcpc_probe_fault_pause.out]> GT 0.5] OR [#<_hal[tcpc_probe_gate_ignore.out]> GT 0.5]]
    (abort, Paired probe monitor changed after the clear settle interval)
  o<pair_settle_final_monitors> endif
o<tcpc_pair_probe_settle_guard> endsub

o<tcpc_vector_sphere_pass> sub
  #<pass_id> = #1
  #<start_x> = #2
  #<start_y> = #3
  #<start_z> = #4
  #<accepted> = #5

  G90
  F#507
  (Recheck before the pass-start positioning move as well as before G38.)
  o<tcpc_pair_live_guard> call [1.0] [#520] [#521]
  G1 X#<start_x> Y#<start_y> Z#<start_z>

  (Refresh all safety-critical live state immediately before probing.)
  o<tcpc_pair_live_guard> call [1.0] [#520] [#521]

  (Top touch along W.)
  #122 = [#530 * #508]
  #123 = [#531 * #508]
  #124 = [#532 * #508]
  G91
  F#506
  o<tcpc_pair_probe_settle_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124

  o<top_fail> if [#5070 EQ 0]
    G90
    F#507
    G1 X#<start_x> Y#<start_y> Z#<start_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, Top vector touch did not record point data)
  o<top_fail> endif

  #<top_x> = #5061
  #<top_y> = #5062
  #<top_z> = #5063
  #612 = [[[#<top_x> - #<start_x>] * #530] + [[#<top_y> - #<start_y>] * #531] + [[#<top_z> - #<start_z>] * #532]]
  #<top_abs_x> = [#<top_x> + #540]
  #<top_abs_y> = [#<top_y> + #541]
  #<top_abs_z> = [#<top_z> + #542]

  #<top_center_x> = [#<top_x> + [#530 * #505]]
  #<top_center_y> = [#<top_y> + [#531 * #505]]
  #<top_center_z> = [#<top_z> + [#532 * #505]]

  #<top_clear_x> = [#<top_center_x> - [#530 * #513]]
  #<top_clear_y> = [#<top_center_y> - [#531 * #513]]
  #<top_clear_z> = [#<top_center_z> - [#532 * #513]]

  G90
  F#507
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Probe from -U side toward +U.)
  #<um_start_x> = [#<top_center_x> - [#533 * #514]]
  #<um_start_y> = [#<top_center_y> - [#534 * #514]]
  #<um_start_z> = [#<top_center_z> - [#535 * #514]]
  #<um_clear_x> = [#<um_start_x> - [#530 * #513]]
  #<um_clear_y> = [#<um_start_y> - [#531 * #513]]
  #<um_clear_z> = [#<um_start_z> - [#532 * #513]]
  o<tcpc_pair_release_guard> call [#520] [#521]
  G90
  F#507
  G1 X#<um_clear_x> Y#<um_clear_y> Z#<um_clear_z>
  G1 X#<um_start_x> Y#<um_start_y> Z#<um_start_z>
  #122 = [#533 * #511]
  #123 = [#534 * #511]
  #124 = [#535 * #511]
  G91
  F#506
  o<tcpc_pair_probe_settle_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<um_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, -U side touch did not record point data)
  o<um_fail> endif
  #<um_x> = #5061
  #<um_y> = #5062
  #<um_z> = #5063
  #613 = [[[#<um_x> - #<um_start_x>] * #533] + [[#<um_y> - #<um_start_y>] * #534] + [[#<um_z> - #<um_start_z>] * #535]]
  #125 = [-#533 * #512]
  #126 = [-#534 * #512]
  #127 = [-#535 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<um_clear_x> Y#<um_clear_y> Z#<um_clear_z>
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Probe from +U side toward -U.)
  #<up_start_x> = [#<top_center_x> + [#533 * #514]]
  #<up_start_y> = [#<top_center_y> + [#534 * #514]]
  #<up_start_z> = [#<top_center_z> + [#535 * #514]]
  #<up_clear_x> = [#<up_start_x> - [#530 * #513]]
  #<up_clear_y> = [#<up_start_y> - [#531 * #513]]
  #<up_clear_z> = [#<up_start_z> - [#532 * #513]]
  o<tcpc_pair_release_guard> call [#520] [#521]
  G90
  F#507
  G1 X#<up_clear_x> Y#<up_clear_y> Z#<up_clear_z>
  G1 X#<up_start_x> Y#<up_start_y> Z#<up_start_z>
  #122 = [-#533 * #511]
  #123 = [-#534 * #511]
  #124 = [-#535 * #511]
  G91
  F#506
  o<tcpc_pair_probe_settle_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<up_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, +U side touch did not record point data)
  o<up_fail> endif
  #<up_x> = #5061
  #<up_y> = #5062
  #<up_z> = #5063
  #614 = [[[#<up_start_x> - #<up_x>] * #533] + [[#<up_start_y> - #<up_y>] * #534] + [[#<up_start_z> - #<up_z>] * #535]]
  #125 = [#533 * #512]
  #126 = [#534 * #512]
  #127 = [#535 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<up_clear_x> Y#<up_clear_y> Z#<up_clear_z>
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Probe from -V side toward +V.)
  #<vm_start_x> = [#<top_center_x> - [#536 * #514]]
  #<vm_start_y> = [#<top_center_y> - [#537 * #514]]
  #<vm_start_z> = [#<top_center_z> - [#538 * #514]]
  #<vm_clear_x> = [#<vm_start_x> - [#530 * #513]]
  #<vm_clear_y> = [#<vm_start_y> - [#531 * #513]]
  #<vm_clear_z> = [#<vm_start_z> - [#532 * #513]]
  o<tcpc_pair_release_guard> call [#520] [#521]
  G90
  F#507
  G1 X#<vm_clear_x> Y#<vm_clear_y> Z#<vm_clear_z>
  G1 X#<vm_start_x> Y#<vm_start_y> Z#<vm_start_z>
  #122 = [#536 * #511]
  #123 = [#537 * #511]
  #124 = [#538 * #511]
  G91
  F#506
  o<tcpc_pair_probe_settle_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<vm_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, -V side touch did not record point data)
  o<vm_fail> endif
  #<vm_x> = #5061
  #<vm_y> = #5062
  #<vm_z> = #5063
  #615 = [[[#<vm_x> - #<vm_start_x>] * #536] + [[#<vm_y> - #<vm_start_y>] * #537] + [[#<vm_z> - #<vm_start_z>] * #538]]
  #125 = [-#536 * #512]
  #126 = [-#537 * #512]
  #127 = [-#538 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<vm_clear_x> Y#<vm_clear_y> Z#<vm_clear_z>
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Probe from +V side toward -V.)
  #<vp_start_x> = [#<top_center_x> + [#536 * #514]]
  #<vp_start_y> = [#<top_center_y> + [#537 * #514]]
  #<vp_start_z> = [#<top_center_z> + [#538 * #514]]
  #<vp_clear_x> = [#<vp_start_x> - [#530 * #513]]
  #<vp_clear_y> = [#<vp_start_y> - [#531 * #513]]
  #<vp_clear_z> = [#<vp_start_z> - [#532 * #513]]
  o<tcpc_pair_release_guard> call [#520] [#521]
  G90
  F#507
  G1 X#<vp_clear_x> Y#<vp_clear_y> Z#<vp_clear_z>
  G1 X#<vp_start_x> Y#<vp_start_y> Z#<vp_start_z>
  #122 = [-#536 * #511]
  #123 = [-#537 * #511]
  #124 = [-#538 * #511]
  G91
  F#506
  o<tcpc_pair_probe_settle_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<vp_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, +V side touch did not record point data)
  o<vp_fail> endif
  #<vp_x> = #5061
  #<vp_y> = #5062
  #<vp_z> = #5063
  #616 = [[[#<vp_start_x> - #<vp_x>] * #536] + [[#<vp_start_y> - #<vp_y>] * #537] + [[#<vp_start_z> - #<vp_z>] * #538]]
  #125 = [#536 * #512]
  #126 = [#537 * #512]
  #127 = [#538 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<vp_clear_x> Y#<vp_clear_y> Z#<vp_clear_z>

  G90
  F#507
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Synchronize the final retract and verify release before live-state capture.)
  o<tcpc_pair_release_guard> call [#520] [#521]

  #<um_abs_x> = [#<um_x> + #540]
  #<um_abs_y> = [#<um_y> + #541]
  #<um_abs_z> = [#<um_z> + #542]
  #<up_abs_x> = [#<up_x> + #540]
  #<up_abs_y> = [#<up_y> + #541]
  #<up_abs_z> = [#<up_z> + #542]
  #<vm_abs_x> = [#<vm_x> + #540]
  #<vm_abs_y> = [#<vm_y> + #541]
  #<vm_abs_z> = [#<vm_z> + #542]
  #<vp_abs_x> = [#<vp_x> + #540]
  #<vp_abs_y> = [#<vp_y> + #541]
  #<vp_abs_z> = [#<vp_z> + #542]

  #<top_center_abs_x> = [#<top_center_x> + #540]
  #<top_center_abs_y> = [#<top_center_y> + #541]
  #<top_center_abs_z> = [#<top_center_z> + #542]

  #<uc_x> = [[#<um_abs_x> + #<up_abs_x>] / 2.0]
  #<uc_y> = [[#<um_abs_y> + #<up_abs_y>] / 2.0]
  #<uc_z> = [[#<um_abs_z> + #<up_abs_z>] / 2.0]
  #<vc_x> = [[#<vm_abs_x> + #<vp_abs_x>] / 2.0]
  #<vc_y> = [[#<vm_abs_y> + #<vp_abs_y>] / 2.0]
  #<vc_z> = [[#<vm_abs_z> + #<vp_abs_z>] / 2.0]

  #<u_err_x> = [#<uc_x> - #<top_center_abs_x>]
  #<u_err_y> = [#<uc_y> - #<top_center_abs_y>]
  #<u_err_z> = [#<uc_z> - #<top_center_abs_z>]
  #<v_err_x> = [#<vc_x> - #<top_center_abs_x>]
  #<v_err_y> = [#<vc_y> - #<top_center_abs_y>]
  #<v_err_z> = [#<vc_z> - #<top_center_abs_z>]

  #600 = #<top_center_x>
  #601 = #<top_center_y>
  #602 = #<top_center_z>
  #603 = [[#<uc_x> + #<vc_x>] / 2.0]
  #604 = [[#<uc_y> + #<vc_y>] / 2.0]
  #605 = [[#<uc_z> + #<vc_z>] / 2.0]
  #606 = [[#<u_err_x> * #533] + [#<u_err_y> * #534] + [#<u_err_z> * #535]]
  #607 = [[#<v_err_x> * #536] + [#<v_err_y> * #537] + [#<v_err_z> * #538]]

  #<u_dx> = [#<up_abs_x> - #<um_abs_x>]
  #<u_dy> = [#<up_abs_y> - #<um_abs_y>]
  #<u_dz> = [#<up_abs_z> - #<um_abs_z>]
  #<v_dx> = [#<vp_abs_x> - #<vm_abs_x>]
  #<v_dy> = [#<vp_abs_y> - #<vm_abs_y>]
  #<v_dz> = [#<vp_abs_z> - #<vm_abs_z>]

  #608 = [[#<u_dx> * #533] + [#<u_dy> * #534] + [#<u_dz> * #535]]
  #609 = [[#<v_dx> * #536] + [#<v_dy> * #537] + [#<v_dz> * #538]]
  #610 = [#608 - [2.0 * #504]]
  #611 = [#609 - [2.0 * #504]]

  (Capture rotary command/feedback at full useful resolution.)
  #150 = #<_hal[joint.3.pos-cmd]>
  #151 = #<_hal[joint.3.pos-fb]>
  #152 = #<_hal[joint.3.motor-pos-cmd]>
  #153 = #<_hal[joint.3.motor-pos-fb]>
  #154 = #<_hal[joint.4.pos-cmd]>
  #155 = #<_hal[joint.4.pos-fb]>
  #156 = #<_hal[joint.4.motor-pos-cmd]>
  #157 = #<_hal[joint.4.motor-pos-fb]>
  #158 = #<_hal[b-ssi-abs-position]>
  #159 = #<_hal[b-ssi-zeroed-position]>
  #160 = #<_hal[c-ssi-abs-position]>
  #161 = #<_hal[c-ssi-zeroed-position]>
  #162 = #<_hal[hm2_7i95.0.ssi.00.abs.rawcounts]>
  #163 = #<_hal[hm2_7i95.0.ssi.01.abs.rawcounts]>
  #164 = [[#151 - #150] * 1000000.0]
  #165 = [[#155 - #154] * 1000000.0]
  #166 = [#151 * 1000000.0]
  #167 = [#155 * 1000000.0]
  #196 = #5401
  #197 = #5402
  #198 = #5403
  #199 = #5410
  #200 = #<_hal[motion.tooloffset.x]>
  #201 = #<_hal[motion.tooloffset.y]>
  #202 = #<_hal[motion.tooloffset.z]>

  (Capture X/Y/Z command and feedback for axis-mechanics diagnostics.)
  #184 = #<_abs_x>
  #185 = #<_abs_y>
  #186 = #<_abs_z>
  #187 = #<_hal[joint.0.motor-pos-cmd]>
  #188 = #<_hal[joint.0.motor-pos-fb]>
  #189 = [#188 - #187]
  #190 = #<_hal[joint.1.motor-pos-cmd]>
  #191 = #<_hal[joint.1.motor-pos-fb]>
  #192 = [#191 - #190]
  #193 = #<_hal[joint.2.motor-pos-cmd]>
  #194 = #<_hal[joint.2.motor-pos-fb]>
  #195 = [#194 - #193]

  (Modes 15-18 use their own compact campaign log below. Keep their rows out of the)
  (historical single-length detail files.)
  o<legacy_detail_logging> if [#714 LT 0.5]
  (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_probe_basic/tcpc-b-angle-scaling-diagnostic-2pass-raw-points.csv)
