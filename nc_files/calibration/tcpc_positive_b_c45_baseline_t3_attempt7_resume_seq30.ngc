  (DEBUG, TCPC_VECTOR diam_u=#610 diam_v=#611)

o<tcpc_vector_sphere_pass> endsub

o<tcpc_measure_pose> sub
  #<target_b> = #1
  #<target_c> = #2
  #<pre_descent_hold> = #3
  #<top_clear_hold> = #4

  (Fail before any retract, index, or positioning move if live state changed.)
  o<tcpc_pair_selector_guard> call
  o<pair_first_pose_start_guard> if [#700 LT 0.5]
    o<tcpc_pair_live_guard> call [1.0] [#<target_b>] [#<target_c>]
  o<pair_first_pose_start_guard> else
    o<tcpc_pair_live_guard> call [0.0] [0.0] [0.0]
  o<pair_first_pose_start_guard> endif

  (For later poses, retract along current W to the known top-clear point,)
  (then lift in machine Z, index, XY, and lower Z. A Z-only lift is not)
  (a safe pull-away when B is near +/-90.)
  o<use_high_z_transit> if [#700 GT 0.5]
    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<current_b> = #<_abs_b>
    #<current_c> = #<_abs_c>
    #<current_w_x> = [-SIN[#<current_b>] * COS[#<current_c>]]
    #<current_w_y> = [-SIN[#<current_b>] * SIN[#<current_c>]]
    #<current_w_z> = [-COS[#<current_b>]]
    #<current_clear_x> = [#701 - #540 - [#<current_w_x> * #513]]
    #<current_clear_y> = [#702 - #541 - [#<current_w_y> * #513]]
    #<current_clear_z> = [#703 - #542 - [#<current_w_z> * #513]]

    G90
    F#507
    G1 X#<current_clear_x> Y#<current_clear_y> Z#<current_clear_z>

    #<safe_z> = [#<_z> + #515]
    G1 Z#<safe_z>

    F#705
    G1 B#<target_b> C#<target_c>

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<start_w_x> = [-SIN[#<target_b>] * COS[#<target_c>]]
    #<start_w_y> = [-SIN[#<target_b>] * SIN[#<target_c>]]
    #<start_w_z> = [-COS[#<target_b>]]
    #<next_start_x> = [#701 - #540 - [#<start_w_x> * #513]]
    #<next_start_y> = [#702 - #541 - [#<start_w_y> * #513]]
    #<next_start_z> = [#703 - #542 - [#<start_w_z> * #513]]
    F#507
    G1 X#<next_start_x> Y#<next_start_y>
    o<baseline_pre_descent_hold> if [#<pre_descent_hold> GT 0.5]
      (MSG, Inspect sphere-post and tool-body path before controlled descent.)
      #771 = #<_abs_x>
      #772 = #<_abs_y>
      #773 = #<_abs_z>
      M0
      o<tcpc_pair_hold_position_guard> call
      o<tcpc_pair_selector_guard> call
      o<tcpc_pair_live_guard> call [1.0] [#<target_b>] [#<target_c>]
      F200.0
    o<baseline_pre_descent_hold> endif
    G1 Z#<next_start_z>
    F#507
  o<use_high_z_transit> else
    (First pose starts from the operator-set position near the sphere.)
    G90
    F#705
    G1 B#<target_b> C#<target_c>

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]
  o<use_high_z_transit> endif

  (Verify commanded, feedback, and SSI pose before either probe pass.)
  o<tcpc_pair_live_guard> call [1.0] [#<target_b>] [#<target_c>]

  o<pause_before_probe> if [[#704 GT 0.5] OR [#<top_clear_hold> GT 0.5]]
    (MSG, Inspect sphere-post and tool-body clearance before probing.)
    #771 = #<_abs_x>
    #772 = #<_abs_y>
    #773 = #<_abs_z>
    M0
    o<tcpc_pair_hold_position_guard> call
    o<tcpc_pair_selector_guard> call
    o<tcpc_pair_live_guard> call [1.0] [#<target_b>] [#<target_c>]
  o<pause_before_probe> endif

  #520 = #<_abs_b>
  #521 = #<_abs_c>

  (W points along the probe vector toward the table at this B/C pose.)
  #530 = [-SIN[#520] * COS[#521]]
  #531 = [-SIN[#520] * SIN[#521]]
  #532 = [-COS[#520]]

  (U is perpendicular to W in the tilt plane.)
  #533 = [COS[#520] * COS[#521]]
  #534 = [COS[#520] * SIN[#521]]
  #535 = [-SIN[#520]]

  (V is perpendicular to W and U.)
  #536 = [-SIN[#521]]
  #537 = [COS[#521]]
  #538 = 0.0

  #550 = #<_x>
  #551 = #<_y>
  #552 = #<_z>

  #<pose_acquisition_try> = 0.0
  #<pose_acquisition_ok> = 0.0
  #<pose_reject_stage> = 0.0
  #<pose_reject_reason> = 0.0

  (Retry one complete two-pass pose after a bounded quality rejection.)
  o<pose_acquisition_loop> while [[#<pose_acquisition_try> LT #739] AND [#<pose_acquisition_ok> LT 0.5]]
    #<pose_acquisition_try> = [#<pose_acquisition_try> + 1.0]
    #<pose_quality_ok> = 1.0
    #<pose_reject_stage> = 0.0
    #<pose_reject_reason> = 0.0
    #629 = 0.0

    (Run pass 1 from the frozen current/operator start point.)
    o<tcpc_vector_sphere_pass> call [1.0] [#550] [#551] [#552] [0.0]
    #<pose_reject_stage> = 1.0
    o<pose_p1_travel_quality> if [[#612 LT #759] OR [#613 LT #759] OR [#614 LT #759] OR [#615 LT #759] OR [#616 LT #759]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 1.0
    o<pose_p1_travel_quality> endif
    o<pose_p1_center_quality> if [[ABS[#606] GT 2.0] OR [ABS[#607] GT 2.0]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 2.0
    o<pose_p1_center_quality> endif
    o<pose_p1_diameter_quality> if [[#610 LT 29.5] OR [#610 GT 31.0] OR [#611 LT 29.5] OR [#611 GT 31.0]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 3.0
    o<pose_p1_diameter_quality> endif

    o<pose_pass1_quality_ok> if [#<pose_quality_ok> GT 0.5]
      (Build corrected center from local U/V midpoint errors.)
      #620 = [[#606 * #533] + [#607 * #536]]
      #621 = [[#606 * #534] + [#607 * #537]]
      #622 = [[#606 * #535] + [#607 * #538]]
      #623 = [#600 + #620]
      #624 = [#601 + #621]
      #625 = [#602 + #622]

      (Start pass 2 at top clearance above the corrected center.)
      #626 = [#623 - [#530 * #513]]
      #627 = [#624 - [#531 * #513]]
      #628 = [#625 - [#532 * #513]]

      (DEBUG, TCPC_VECTOR correction #620 #621 #622)
      o<tcpc_vector_sphere_pass> call [2.0] [#626] [#627] [#628] [1.0]
      #<pose_reject_stage> = 2.0
      o<pose_p2_travel_quality> if [[#612 LT #759] OR [#613 LT #759] OR [#614 LT #759] OR [#615 LT #759] OR [#616 LT #759]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 4.0
      o<pose_p2_travel_quality> endif
      o<pose_p2_center_quality> if [[ABS[#606] GT 0.10] OR [ABS[#607] GT 0.10]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 5.0
      o<pose_p2_center_quality> endif
      o<pose_p2_diameter_quality> if [[#610 LT 29.9] OR [#610 GT 30.5] OR [#611 LT 29.9] OR [#611 GT 30.5]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 6.0
      o<pose_p2_diameter_quality> endif
      #629 = SQRT[[[#603 - [#623 + #540]] * [#603 - [#623 + #540]]] + [[#604 - [#624 + #541]] * [#604 - [#624 + #541]]] + [[#605 - [#625 + #542]] * [#605 - [#625 + #542]]]]
      o<pose_p2_center_agreement> if [#629 GT 0.10]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 7.0
      o<pose_p2_center_agreement> endif
    o<pose_pass1_quality_ok> endif

    o<pose_quality_accept> if [#<pose_quality_ok> GT 0.5]
      #<pose_acquisition_ok> = 1.0
    o<pose_quality_accept> else
      (DEBUG, TCPC_VECTOR reject try=#<pose_acquisition_try> stage=#<pose_reject_stage> reason=#<pose_reject_reason> travel=#612/#613/#614/#615/#616 err=#606/#607 diam=#610/#611 center_delta=#629)
      o<pose_quality_retry_available> if [#<pose_acquisition_try> LT #739]
        (DEBUG, TCPC_VECTOR retrying complete pose after settle)
        o<tcpc_pair_live_guard> call [1.0] [#520] [#521]
        G90
        F#507
        G1 X#550 Y#551 Z#552
        o<tcpc_pair_release_guard> call [#520] [#521]
      o<pose_quality_retry_available> endif
    o<pose_quality_accept> endif
  o<pose_acquisition_loop> endwhile

  o<pose_quality_retry_exhausted> if [#<pose_acquisition_ok> LT 0.5]
    (abort, Sphere pose quality failed twice; retain partial and restart with a new attempt)
  o<pose_quality_retry_exhausted> endif

  #700 = 1.0
  #701 = #603
  #702 = #604
  #703 = #605

  o<pair_summary_logging> if [#714 GT 0.5]
    (Refresh the logged fields and reject state changes after the accepted pass.)
    o<tcpc_pair_selector_guard> call
    o<tcpc_pair_live_guard> call [1.0] [#520] [#521]
    #726 = [#726 + 1.0]
    (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-positive-b-c45-baseline-results.csv)
    (LOG,#715,#716,#711,#727,#726,#520,#521,#719,#516,#502,#501,#718,#720,#721,#722,#723,#724,#725,#603,#604,#605,#606,#607,#610,#611,#517,#518,#519,#150,#151,#154,#155,#159,#161,#184,#185,#186,#187,#188,#189,#190,#191,#192,#193,#194,#195)
    (LOGCLOSE)
  o<pair_summary_logging> endif

o<tcpc_measure_pose> endsub

o<tcpc_baseline_closure_guard> sub
  #<closure_dx> = [#701 - #1]
  #<closure_dy> = [#702 - #2]
  #<closure_dz> = [#703 - #3]
  #<closure_norm> = SQRT[[#<closure_dx> * #<closure_dx>] + [#<closure_dy> * #<closure_dy>] + [#<closure_dz> * #<closure_dz>]]
  (DEBUG, BASELINE C0 closure dx=#<closure_dx> dy=#<closure_dy> dz=#<closure_dz> norm=#<closure_norm>)
  o<baseline_closure_limit> if [#<closure_norm> GT 0.05]
    (abort, Baseline C0 closure exceeds 0.05 mm; retain partial and restart with a new attempt)
  o<baseline_closure_limit> endif
o<tcpc_baseline_closure_guard> endsub

o<tcpc_baseline_b0_group> sub
  #726 = 0.0
  o<tcpc_measure_pose> call [0.0] [0.0] [0.0] [0.0]
  #780 = #701
  #781 = #702
  #782 = #703
  #<group_open_x> = #701
  #<group_open_y> = #702
  #<group_open_z> = #703
  o<tcpc_measure_pose> call [0.0] [45.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [90.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [135.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [180.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [225.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [270.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [315.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [0.0] [0.0] [0.0]
  o<tcpc_baseline_closure_guard> call [#<group_open_x>] [#<group_open_y>] [#<group_open_z>]
o<tcpc_baseline_b0_group> endsub

o<tcpc_baseline_tilt_group> sub
  #<baseline_b> = #1
  #<first_slot> = #2
  #<hold_first_tilt> = #3
  #<hold_watch_sectors> = #4
  #726 = [#<first_slot> - 1.0]
  o<tcpc_measure_pose> call [#<baseline_b>] [0.0] [0.0] [#<hold_first_tilt>]
  #<group_open_x> = #701
  #<group_open_y> = #702
  #<group_open_z> = #703
  o<tcpc_measure_pose> call [#<baseline_b>] [45.0] [#<hold_watch_sectors>] [#<hold_watch_sectors>]
  o<tcpc_measure_pose> call [#<baseline_b>] [90.0] [0.0] [0.0]
  #726 = [#<first_slot> + 3.0]
  o<tcpc_measure_pose> call [#<baseline_b>] [180.0] [0.0] [0.0]
  o<tcpc_measure_pose> call [#<baseline_b>] [225.0] [#<hold_watch_sectors>] [#<hold_watch_sectors>]
  o<tcpc_measure_pose> call [#<baseline_b>] [270.0] [0.0] [0.0]
  #726 = [#<first_slot> + 7.0]
  o<tcpc_measure_pose> call [#<baseline_b>] [0.0] [0.0] [0.0]
  o<tcpc_baseline_closure_guard> call [#<group_open_x>] [#<group_open_y>] [#<group_open_z>]
o<tcpc_baseline_tilt_group> endsub

o<tcpc_baseline_return_top_clear> sub
  o<tcpc_pair_selector_guard> call
  o<tcpc_pair_live_guard> call [1.0] [0.0] [0.0]
  #540 = [#<_abs_x> - #<_x>]
  #541 = [#<_abs_y> - #<_y>]
  #542 = [#<_abs_z> - #<_z>]
  #<final_w_x> = [-SIN[#<_abs_b>] * COS[#<_abs_c>]]
  #<final_w_y> = [-SIN[#<_abs_b>] * SIN[#<_abs_c>]]
  #<final_w_z> = [-COS[#<_abs_b>]]
  #<final_clear_x> = [#701 - #540 - [#<final_w_x> * #513]]
  #<final_clear_y> = [#702 - #541 - [#<final_w_y> * #513]]
  #<final_clear_z> = [#703 - #542 - [#<final_w_z> * #513]]
  G90
  F#507
  G1 X#<final_clear_x> Y#<final_clear_y> Z#<final_clear_z>
  o<tcpc_pair_live_guard> call [1.0] [0.0] [0.0]
o<tcpc_baseline_return_top_clear> endsub

(The historical mode bodies below are retained as source history but are)
(unreachable: this dedicated file releases only mode 19.)
(#711=0 runs C0 only. #711=1 runs C0 then C180. #711=2 runs C180 only.)
(#711=3 runs only C90/C270 with B0, B+90, B-90, B0 at each C.)
(#711=4 runs C0, C180, and C90/C270 side validation.)
(#711=5 runs only C180 high-B and C270 B+90 targeted repeat.)
(#711=6 runs B0 C0/C90/C180/C270/C0 reference only.)
(#711=7 runs B0/B+10/B-10/B+30/B-30 at C every 45 degrees.)
(#711=8 runs the tool-length baseline core.)
(#711=9 resumes the tool-length baseline with a fresh B0 C0 center.)
(#711=12 runs a focused extended-candidate spot-check.)
(#711=13 runs full safe-grid extended-candidate validation.)
(#711=14 resumes the full safe-grid validation after B-90 C45.)
(#711=15 runs paired stage A at B0.)
(#711=16 runs paired stage B at B+/-5 and C+/-20.)
(#711=17 runs paired stage C-low at B+/-10 and C quadrants.)
(#711=18 runs paired stage C at B+/-30 and C quadrants.)
(#711=19 runs the dedicated positive-B C45 short/long baseline.)
