  o<tcpc_tool_length_c90_c270_at_b> call [30.0]
  o<tcpc_tool_length_c90_c270_at_b> call [60.0]
  o<tcpc_tool_length_c90_c270_at_b> call [90.0]
  o<tcpc_tool_length_c90_c270_at_b> call [-90.0]
  o<tcpc_tool_length_c90_c270_at_b> call [-60.0]
  o<tcpc_tool_length_c90_c270_at_b> call [-30.0]
  o<tcpc_measure_pose> call [0.0] [0.0]
o<tcpc_tool_length_c90_c270_supplement> endsub

o<tcpc_tool_length_c90_c270_after_bminus60> sub
