  #114 = 3.0
  #115 = #<up_abs_x>
  #116 = #<up_abs_y>
  #117 = #<up_abs_z>
  (LOG,#110,#111,#112,#113,#114,#115,#116,#117)
  #114 = 4.0
  #115 = #<vm_abs_x>
  #116 = #<vm_abs_y>
  #117 = #<vm_abs_z>
  (LOG,#110,#111,#112,#113,#114,#115,#116,#117)
  #114 = 5.0
