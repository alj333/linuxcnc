  o<cand17> endif
  o<cand18> if [ABS[#<_hal[headheadkins.bcross.sinb-cos2c.z]> + 0.003817324701821] GT 0.000000001]
    (abort, R2 candidate pin mismatch 18 bcross sinb-cos2c z)
  o<cand18> endif
  o<cand19> if [ABS[#<_hal[headheadkins.bmid.base.x]> - 0.049306651723101] GT 0.000000001]
    (abort, R2 candidate pin mismatch 19 bmid base x)
  o<cand19> endif
  o<cand20> if [ABS[#<_hal[headheadkins.bmid.base.y]> - 0.071617640658233] GT 0.000000001]
