    (abort, R2 candidate pin mismatch 23 bmid cosc y)
  o<cand23> endif
  o<cand24> if [ABS[#<_hal[headheadkins.bmid.cosc.z]> - 0.003604714378862] GT 0.000000001]
    (abort, R2 candidate pin mismatch 24 bmid cosc z)
  o<cand24> endif
  o<cand25> if [ABS[#<_hal[headheadkins.bmid.sinc.x]> + 0.032916420628586] GT 0.000000001]
    (abort, R2 candidate pin mismatch 25 bmid sinc x)
  o<cand25> endif
