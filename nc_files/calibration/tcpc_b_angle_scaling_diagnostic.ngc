  (LOGCLOSE)

  (DEBUG, TCPC_VECTOR pass #<pass_id> accepted #<accepted>)
  (DEBUG, TCPC_VECTOR center #603 #604 #605)
  (DEBUG, TCPC_VECTOR err_u=#606 err_v=#607)
  (DEBUG, TCPC_VECTOR diam_u=#610 diam_v=#611)

o<tcpc_vector_sphere_pass> endsub

o<tcpc_measure_pose> sub
  #<target_b> = #1
  #<target_c> = #2

  (For later poses, retract along current W to the known top-clear point,)
  (then lift in machine Z, index, XY, and lower Z. A Z-only lift is not)
  (a safe pull-away when B is near +/-90.)
  o<use_high_z_transit> if [#700 GT 0.5]
    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<current_b> = #<_abs_b>
    #<current_c> = #<_abs_c>
    #<current_w_x> = [-SIN[#<current_b>] * COS[#<current_c>]]
    #<current_w_y> = [-SIN[#<current_b>] * SIN[#<current_c>]]
    #<current_w_z> = [-COS[#<current_b>]]
    #<current_clear_x> = [#701 - #540 - [#<current_w_x> * #513]]
    #<current_clear_y> = [#702 - #541 - [#<current_w_y> * #513]]
    #<current_clear_z> = [#703 - #542 - [#<current_w_z> * #513]]

    G90
    F#507
    G1 X#<current_clear_x> Y#<current_clear_y> Z#<current_clear_z>

    #<safe_z> = [#<_z> + #515]
    G1 Z#<safe_z>

    F#705
    G1 B#<target_b> C#<target_c>

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<start_w_x> = [-SIN[#<target_b>] * COS[#<target_c>]]
    #<start_w_y> = [-SIN[#<target_b>] * SIN[#<target_c>]]
    #<start_w_z> = [-COS[#<target_b>]]
    #<next_start_x> = [#701 - #540 - [#<start_w_x> * #513]]
    #<next_start_y> = [#702 - #541 - [#<start_w_y> * #513]]
    #<next_start_z> = [#703 - #542 - [#<start_w_z> * #513]]
    F#507
    G1 X#<next_start_x> Y#<next_start_y>
    G1 Z#<next_start_z>
  o<use_high_z_transit> else
    (First pose starts from the operator-set position near the sphere.)
    G90
    F#705
    G1 B#<target_b> C#<target_c>

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]
  o<use_high_z_transit> endif

  o<pause_before_probe> if [#704 GT 0.5]
    (MSG, TCPC expanded-pose check paused before probing)
    M0
  o<pause_before_probe> endif

  #520 = #<_abs_b>
  #521 = #<_abs_c>

  (W points along the probe vector toward the table at this B/C pose.)
  #530 = [-SIN[#520] * COS[#521]]
  #531 = [-SIN[#520] * SIN[#521]]
  #532 = [-COS[#520]]

  (U is perpendicular to W in the tilt plane.)
  #533 = [COS[#520] * COS[#521]]
  #534 = [COS[#520] * SIN[#521]]
  #535 = [-SIN[#520]]

  (V is perpendicular to W and U.)
  #536 = [-SIN[#521]]
  #537 = [COS[#521]]
  #538 = 0.0

  #550 = #<_x>
  #551 = #<_y>
  #552 = #<_z>

  (Run first pass from the current/operator start point.)
  o<tcpc_vector_sphere_pass> call [1.0] [#550] [#551] [#552] [0.0]

  (Pass 1 sanity checks before any automatic correction move.)
  o<safe_u_move> if [ABS[#606] GT 2.0]
    (abort, Pass 1 U centering correction over 2 mm)
  o<safe_u_move> endif
  o<safe_v_move> if [ABS[#607] GT 2.0]
    (abort, Pass 1 V centering correction over 2 mm)
  o<safe_v_move> endif
  o<safe_u_diam_low> if [#610 LT 29.9]
    (abort, Pass 1 U corrected diameter below safe range)
  o<safe_u_diam_low> endif
  o<safe_u_diam_high> if [#610 GT 30.5]
    (abort, Pass 1 U corrected diameter above safe range)
  o<safe_u_diam_high> endif
  o<safe_v_diam_low> if [#611 LT 29.9]
    (abort, Pass 1 V corrected diameter below safe range)
  o<safe_v_diam_low> endif
  o<safe_v_diam_high> if [#611 GT 30.5]
    (abort, Pass 1 V corrected diameter above safe range)
  o<safe_v_diam_high> endif

  (Build corrected center from local U/V midpoint errors.)
  #620 = [[#606 * #533] + [#607 * #536]]
  #621 = [[#606 * #534] + [#607 * #537]]
  #622 = [[#606 * #535] + [#607 * #538]]
  #623 = [#600 + #620]
  #624 = [#601 + #621]
  #625 = [#602 + #622]

  (Start pass 2 at top clearance above the corrected center.)
  #626 = [#623 - [#530 * #513]]
  #627 = [#624 - [#531 * #513]]
  #628 = [#625 - [#532 * #513]]

  (DEBUG, TCPC_VECTOR correction #620 #621 #622)
  o<tcpc_vector_sphere_pass> call [2.0] [#626] [#627] [#628] [1.0]

  (Pass 2 sanity checks before accepting this center for the next pose.)
  o<safe_p2_u_move> if [ABS[#606] GT 0.10]
    (abort, Pass 2 U centering residual over 0.10 mm)
  o<safe_p2_u_move> endif
  o<safe_p2_v_move> if [ABS[#607] GT 0.10]
    (abort, Pass 2 V centering residual over 0.10 mm)
  o<safe_p2_v_move> endif
  o<safe_p2_u_diam_low> if [#610 LT 29.9]
    (abort, Pass 2 U corrected diameter below safe range)
  o<safe_p2_u_diam_low> endif
  o<safe_p2_u_diam_high> if [#610 GT 30.5]
    (abort, Pass 2 U corrected diameter above safe range)
  o<safe_p2_u_diam_high> endif
  o<safe_p2_v_diam_low> if [#611 LT 29.9]
    (abort, Pass 2 V corrected diameter below safe range)
  o<safe_p2_v_diam_low> endif
  o<safe_p2_v_diam_high> if [#611 GT 30.5]
    (abort, Pass 2 V corrected diameter above safe range)
  o<safe_p2_v_diam_high> endif

  #700 = 1.0
  #701 = #603
  #702 = #604
  #703 = #605

o<tcpc_measure_pose> endsub

(Run the short B-angle scaling sequence.)
(#711=0 runs C0 only. #711=1 runs C0 then C180. #711=2 runs C180 only.)
(#711=3 runs only C90/C270 with B0, B+90, B-90, B0 at each C.)
(#711=4 runs C0, C180, and C90/C270 side validation.)
(#711=5 runs only C180 high-B and C270 B+90 targeted repeat.)
(#711=6 runs B0 C0/C90/C180/C270/C0 reference only.)
(#711=7 runs B0/B+10/B-10/B+30/B-30 at C every 45 degrees.)
#712 = 0.0
#713 = 0.0
o<c0_requested_low_mode> if [#711 LT 1.5]
  #712 = 1.0
o<c0_requested_low_mode> endif
o<c0_requested_all_mode> if [#711 GT 3.5]
  o<c0_requested_all_mode_not_targeted> if [#711 LT 4.5]
    #712 = 1.0
  o<c0_requested_all_mode_not_targeted> endif
o<c0_requested_all_mode> endif
o<c180_requested_middle_mode> if [#711 GT 0.5]
  o<c180_requested_not_side_only> if [#711 LT 2.5]
    #713 = 1.0
  o<c180_requested_not_side_only> endif
o<c180_requested_middle_mode> endif
o<c180_requested_all_mode> if [#711 GT 3.5]
  o<c180_requested_all_mode_not_targeted> if [#711 LT 4.5]
    #713 = 1.0
  o<c180_requested_all_mode_not_targeted> endif
o<c180_requested_all_mode> endif

o<run_c0_sequence> if [#712 GT 0.5]
  o<tcpc_measure_pose> call [0.0] [0.0]
  o<tcpc_measure_pose> call [30.0] [0.0]
  o<tcpc_measure_pose> call [-30.0] [0.0]
  o<tcpc_measure_pose> call [60.0] [0.0]
  o<tcpc_measure_pose> call [-60.0] [0.0]
  o<tcpc_measure_pose> call [90.0] [0.0]
  o<tcpc_measure_pose> call [-90.0] [0.0]
  o<tcpc_measure_pose> call [0.0] [0.0]
o<run_c0_sequence> endif

o<run_c180_repeat> if [#713 GT 0.5]
  o<tcpc_measure_pose> call [0.0] [180.0]
  o<tcpc_measure_pose> call [30.0] [180.0]
  o<tcpc_measure_pose> call [-30.0] [180.0]
  o<tcpc_measure_pose> call [60.0] [180.0]
  o<tcpc_measure_pose> call [-60.0] [180.0]
  o<tcpc_measure_pose> call [90.0] [180.0]
  o<tcpc_measure_pose> call [-90.0] [180.0]
  o<tcpc_measure_pose> call [0.0] [180.0]
o<run_c180_repeat> endif

o<run_side_high_b> if [#711 GT 2.5]
  o<run_side_high_b_not_targeted> if [#711 LT 4.5]
    o<tcpc_measure_pose> call [0.0] [90.0]
    o<tcpc_measure_pose> call [90.0] [90.0]
    o<tcpc_measure_pose> call [-90.0] [90.0]
    o<tcpc_measure_pose> call [0.0] [90.0]
    o<tcpc_measure_pose> call [0.0] [270.0]
    o<tcpc_measure_pose> call [90.0] [270.0]
    o<tcpc_measure_pose> call [-90.0] [270.0]
    o<tcpc_measure_pose> call [0.0] [270.0]
  o<run_side_high_b_not_targeted> endif
o<run_side_high_b> endif

o<run_refined_targeted_repeat> if [#711 GT 4.5]
  o<run_refined_targeted_repeat_only> if [#711 LT 5.5]
    (Targeted repeat of the remaining high-error refined-candidate poses.)
    (C180 group: B0, B+60, B-60, B+90, B-90, B0.)
    o<tcpc_measure_pose> call [0.0] [180.0]
    o<tcpc_measure_pose> call [60.0] [180.0]
    o<tcpc_measure_pose> call [-60.0] [180.0]
    o<tcpc_measure_pose> call [90.0] [180.0]
    o<tcpc_measure_pose> call [-90.0] [180.0]
    o<tcpc_measure_pose> call [0.0] [180.0]

    (C270 group: B0, B+90, B0.)
    o<tcpc_measure_pose> call [0.0] [270.0]
    o<tcpc_measure_pose> call [90.0] [270.0]
    o<tcpc_measure_pose> call [0.0] [270.0]
  o<run_refined_targeted_repeat_only> endif
o<run_refined_targeted_repeat> endif

o<run_b0_reference_check> if [#711 GT 5.5]
  o<run_b0_reference_check_only> if [#711 LT 6.5]
    (B0-only C-quadrant reference check for session/thermal/sphere movement.)
    (Run with the refined candidate disabled unless deliberately testing it.)
    o<tcpc_measure_pose> call [0.0] [0.0]
    o<tcpc_measure_pose> call [0.0] [90.0]
    o<tcpc_measure_pose> call [0.0] [180.0]
    o<tcpc_measure_pose> call [0.0] [270.0]
    o<tcpc_measure_pose> call [0.0] [0.0]
  o<run_b0_reference_check_only> endif
o<run_b0_reference_check> endif

o<tcpc_c45_sweep_at_b> sub
  #<sweep_b> = #1
  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
  o<skip_bminus30_c45> if [ABS[#<sweep_b> + 30.0] GT 0.001]
    o<tcpc_measure_pose> call [#<sweep_b>] [45.0]
  o<skip_bminus30_c45> endif
  o<tcpc_measure_pose> call [#<sweep_b>] [90.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [135.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [180.0]
  o<skip_bplus30_c225> if [ABS[#<sweep_b> - 30.0] GT 0.001]
    o<tcpc_measure_pose> call [#<sweep_b>] [225.0]
  o<skip_bplus30_c225> endif
  o<tcpc_measure_pose> call [#<sweep_b>] [270.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [315.0]
  o<tcpc_measure_pose> call [#<sweep_b>] [0.0]
o<tcpc_c45_sweep_at_b> endsub

o<run_detailed_c45_sweep> if [#711 GT 6.5]
  (Detailed C sweep for C-center/reference and low-B TCPC diagnostics.)
  (Sequence per B group: C0/C45/C90/C135/C180/C225/C270/C315/C0.)
  (Run with headheadkins.sim-bharm-enable FALSE unless deliberately testing it.)
  (Safety skips: B-30 C45 and B+30 C225 are omitted for sphere stand clearance.)
  (C45 and C225 align near the sphere stand; monitor the first sweep closely.)
  o<tcpc_c45_sweep_at_b> call [0.0]
  o<tcpc_c45_sweep_at_b> call [10.0]
  o<tcpc_c45_sweep_at_b> call [-10.0]
  o<tcpc_c45_sweep_at_b> call [30.0]
  o<tcpc_c45_sweep_at_b> call [-30.0]
o<run_detailed_c45_sweep> endif

G90
F#705
G1 B0 C0

M65 P0
M65 P1
(DEBUG, TCPC_B_ANGLE_SCALING_DIAGNOSTIC complete)
M2
