%
(TCPC H3 B45/C45 tip-hold check)
(No probing. No physical tool installed. Selects T3 and applies G43 H3.)

G17 G21 G40 G49 G54 G64 P0.001 G80 G90 G92.1 G94

o<preview_guard> if [#<_task> EQ 0]
  (DEBUG, TCPC_H3_B45_C45_TIP_HOLD preview only)
  M2
o<preview_guard> endif

o<tlo_start_check> if [ABS[#<_hal[motion.tooloffset.z]>] GT 0.001]
  (abort, B45/C45 tip-hold requires zero active Z tool offset at start)
o<tlo_start_check> endif
o<tcpc_off_check> if [#<_hal[headheadtwp.tcpc_enabled]> GT 0.5]
  (abort, B45/C45 tip-hold must start with TCPC off)
o<tcpc_off_check> endif
o<twp_off_check> if [#<_hal[headheadtwp.motion_enabled]> GT 0.5]
  (abort, B45/C45 tip-hold must start with TWP motion off)
o<twp_off_check> endif
o<b_zero_check> if [ABS[#<_hal[headheadtwp.current_joint_b]>] GT 0.05]
  (abort, B45/C45 tip-hold must start near B0)
o<b_zero_check> endif
o<c_zero_check> if [ABS[#<_hal[headheadtwp.current_joint_c]>] GT 0.05]
  (abort, B45/C45 tip-hold must start near C0)
o<c_zero_check> endif

(MSG, No physical tool. Virtual T3/H3. B45 C45 should hold TCP.)
M0

M61 Q3
M66 E0 L0 (force sync after selected-tool change)
o<tool_3_check> if [ABS[#<_current_tool> - 3] GT 0.5]
  (abort, M61 Q3 did not set current tool 3)
o<tool_3_check> endif

G0 B0.0 C0.0
G43 H3
M66 E0 L0 (force sync after applying H3 tool length)
o<h3_z_check> if [ABS[#<_hal[motion.tooloffset.z]> - 128.606729] GT 0.002]
  (abort, G43 H3 did not apply expected H3 Z tool length)
o<h3_z_check> endif

#<start_x> = #<_x>
#<start_y> = #<_y>
#<start_z> = #<_z>

G43.4
o<tcpc_on_check> if [#<_hal[headheadtwp.tcpc_enabled]> LT 0.5]
  (abort, G43.4 did not enable TCPC)
o<tcpc_on_check> endif

M66 E0 L0
(DEBUG, B45CHK B0)
(DEBUG, AX=#<_hal[axis.x.pos-cmd]> AY=#<_hal[axis.y.pos-cmd]> AZ=#<_hal[axis.z.pos-cmd]>)
(DEBUG, JX=#<_hal[joint.0.motor-pos-cmd]> JY=#<_hal[joint.1.motor-pos-cmd]> JZ=#<_hal[joint.2.motor-pos-cmd]>)
(DEBUG, TLOZ=#<_hal[motion.tooloffset.z]> KTZ=#<_hal[headheadkins.tool-offset.z]>)
(MSG, Logged B0. Continue to move B45 C45 with programmed XYZ held fixed.)
M0

F480
G1 X[#<start_x>] Y[#<start_y>] Z[#<start_z>] B45.0 C45.0
M66 E0 L0
(DEBUG, B45CHK B45C45)
(DEBUG, AX=#<_hal[axis.x.pos-cmd]> AY=#<_hal[axis.y.pos-cmd]> AZ=#<_hal[axis.z.pos-cmd]>)
(DEBUG, JX=#<_hal[joint.0.motor-pos-cmd]> JY=#<_hal[joint.1.motor-pos-cmd]> JZ=#<_hal[joint.2.motor-pos-cmd]>)
(DEBUG, TLOZ=#<_hal[motion.tooloffset.z]> KTZ=#<_hal[headheadkins.tool-offset.z]>)
(MSG, At B45 C45. TCP should remain fixed; UI tool tip should stay on the path while tool top moves.)
M0

G1 X[#<start_x>] Y[#<start_y>] Z[#<start_z>] B0.0 C0.0
M66 E0 L0
(DEBUG, B45CHK B0R)
(DEBUG, AX=#<_hal[axis.x.pos-cmd]> AY=#<_hal[axis.y.pos-cmd]> AZ=#<_hal[axis.z.pos-cmd]>)
(DEBUG, JX=#<_hal[joint.0.motor-pos-cmd]> JY=#<_hal[joint.1.motor-pos-cmd]> JZ=#<_hal[joint.2.motor-pos-cmd]>)
(DEBUG, TLOZ=#<_hal[motion.tooloffset.z]> KTZ=#<_hal[headheadkins.tool-offset.z]>)
(MSG, Returned to B0 C0. Continue to clear TCPC and G43.)
M0

G49.1
o<tcpc_off_end_check> if [#<_hal[headheadtwp.tcpc_enabled]> GT 0.5]
  (abort, G49.1 did not disable TCPC)
o<tcpc_off_end_check> endif

G49
M66 E0 L0 (force sync after clearing tool length)
o<tlo_end_check> if [ABS[#<_hal[motion.tooloffset.z]>] GT 0.001]
  (abort, G49 did not clear virtual H3 tool length)
o<tlo_end_check> endif
M61 Q0

(DEBUG, TCPC_H3_B45_C45_TIP_HOLD complete)
M30
%
