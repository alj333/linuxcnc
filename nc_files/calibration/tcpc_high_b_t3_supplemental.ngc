o<b_ssi_valid_required> endif
o<c_ssi_valid_required> if [#<_hal[c-ssi-invalid]> GT 0.5]
  (abort, Sphere diagnostic requires valid C SSI feedback)
o<c_ssi_valid_required> endif
o<start_b_zero_required> if [ABS[[[#<_hal[headheadtwp.current_joint_b]> + 540.0] MOD 360.0] - 180.0] GT 0.05]
  (abort, Sphere diagnostic must start near B0)
o<start_b_zero_required> endif
o<start_c_zero_required> if [ABS[[[#<_hal[headheadtwp.current_joint_c]> + 540.0] MOD 360.0] - 180.0] GT 0.05]
