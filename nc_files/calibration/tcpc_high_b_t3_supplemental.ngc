o<tcpc_pair_live_guard> sub
  #<check_pose> = #1
  #<guard_target_b> = #2
  #<guard_target_c> = #3

  (Drain queued motion before sampling live HAL state. Post-contact release)
  (checking is handled separately by tcpc_pair_release_guard.)
  M66 E0 L0

  o<tcpc_pair_coordinate_guard> call

  o<pair_machine_on> if [#<_hal[halui.machine.is-on]> LT 0.5]
    (abort, Paired sphere run requires the machine enabled)
  o<pair_machine_on> endif
  o<pair_all_homed> if [[#<_hal[joint.0.homed]> + #<_hal[joint.1.homed]> + #<_hal[joint.2.homed]> + #<_hal[joint.3.homed]> + #<_hal[joint.4.homed]>] LT 4.5]
    (abort, Paired sphere run requires all five joints homed)
  o<pair_all_homed> endif
  o<pair_spindle_off> if [#<_hal[spindle.0.on]> GT 0.5]
    (abort, Paired sphere run requires the spindle stopped)
  o<pair_spindle_off> endif

  #718 = #<_hal[headheadkins.sim-bharm-enable]>
  o<pair_correction_live> if [#718 LT 0.5]
    (abort, Persistent correction is not enabled for paired sphere run)
  o<pair_correction_live> endif
  #719 = #<_hal[iocontrol.0.tool-number]>
  o<pair_tool_live> if [ABS[#719 - #500] GT 0.1]
    (abort, Live tool number changed during paired sphere run)
  o<pair_tool_live> endif

  o<pair_diameter_unchanged> if [[ABS[#501 - #758] GT 0.000001] OR [ABS[#501 - 6.0] GT 0.000001]]
    (abort, Frozen 6 mm paired probe diameter changed during the run)
  o<pair_diameter_unchanged> endif

  #502 = #3032
  o<pair_calibration_live> if [ABS[#502 - #717] GT 0.0005]
    (abort, Live #3032 changed from the frozen paired probe offset)
  o<pair_calibration_live> endif

  #517 = #<_hal[motion.tooloffset.z]>
  #518 = #<_hal[halui.tool.length_offset.z]>
  #519 = #<_hal[headheadkins.active-tool-offset.z]>
  o<pair_motion_tlo_live> if [ABS[#517 - #516] GT 0.002]
    (abort, Live motion Z tool offset changed during paired sphere run)
  o<pair_motion_tlo_live> endif
  o<pair_halui_tlo_live> if [ABS[#518 - #516] GT 0.002]
    (abort, Live HALUI Z tool offset changed during paired sphere run)
  o<pair_halui_tlo_live> endif
  o<pair_kins_tlo_live> if [ABS[#519 - #516] GT 0.002]
    (abort, Live kinematics Z tool offset changed during paired sphere run)
  o<pair_kins_tlo_live> endif
  o<pair_tlo_x_live> if [ABS[#<_hal[motion.tooloffset.x]>] GT 0.002]
    (abort, Paired sphere run requires zero active X tool offset)
  o<pair_tlo_x_live> endif
  o<pair_tlo_y_live> if [ABS[#<_hal[motion.tooloffset.y]>] GT 0.002]
    (abort, Paired sphere run requires zero active Y tool offset)
  o<pair_tlo_y_live> endif
  o<pair_tlo_abc_live> if [[ABS[#<_hal[motion.tooloffset.a]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.b]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.c]>] GT 0.002]]
    (abort, Paired sphere run requires zero active A B and C tool offsets)
  o<pair_tlo_abc_live> endif
  o<pair_tlo_uvw_live> if [[ABS[#<_hal[motion.tooloffset.u]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.v]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.w]>] GT 0.002]]
    (abort, Paired sphere run requires zero active U V and W tool offsets)
  o<pair_tlo_uvw_live> endif

  #720 = #<_hal[headheadtwp.tcpc_enabled]>
  #721 = #<_hal[headheadtwp.active]>
  #722 = #<_hal[headheadtwp.motion_enabled]>
  #723 = #<_hal[headheadtwp.valid]>
  #724 = #<_hal[b-ssi-invalid]>
  #725 = #<_hal[c-ssi-invalid]>
  o<pair_tcpc_live> if [#720 LT 0.5]
    (abort, TCPC is not enabled during paired sphere run)
  o<pair_tcpc_live> endif
  o<pair_twp_clear_live> if [[#721 + #722 + #723] GT 0.5]
    (abort, TWP state is present during paired sphere run)
  o<pair_twp_clear_live> endif
  o<pair_ssi_valid_live> if [[#724 + #725] GT 0.5]
    (abort, Rotary SSI feedback is invalid during paired sphere run)
  o<pair_ssi_valid_live> endif

  o<pair_probe_gates_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5]]
    (abort, Paired sphere probe gates are not clear before motion)
  o<pair_probe_gates_clear> endif
  o<pair_probe_inputs_clear> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
    (abort, Paired sphere probe input is active before a probe move)
  o<pair_probe_inputs_clear> endif

  o<pair_pose_check> if [#<check_pose> GT 0.5]
    #<b_cmd_error> = ABS[[[#<_hal[headheadtwp.current_joint_b]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<b_fb_error> = ABS[[[#<_hal[joint.3.pos-fb]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<b_ssi_error> = ABS[[[#<_hal[b-ssi-zeroed-position]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<c_cmd_error> = ABS[[[#<_hal[headheadtwp.current_joint_c]> - #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    #<c_fb_error> = ABS[[[#<_hal[joint.4.pos-fb]> - #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    (The physical C SSI zeroed signal has the opposite polarity to joint C.)
    #<c_ssi_error> = ABS[[[#<_hal[c-ssi-zeroed-position]> + #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    o<pair_b_pose_live> if [[#<b_cmd_error> GT 0.01] OR [#<b_fb_error> GT 0.01] OR [#<b_ssi_error> GT 0.01]]
      (abort, B command feedback or SSI is outside paired pose tolerance)
    o<pair_b_pose_live> endif
    o<pair_c_pose_live> if [[#<c_cmd_error> GT 0.01] OR [#<c_fb_error> GT 0.01] OR [#<c_ssi_error> GT 0.01]]
      (abort, C command feedback or SSI is outside paired pose tolerance)
    o<pair_c_pose_live> endif
  o<pair_pose_check> endif
o<tcpc_pair_live_guard> endsub

o<tcpc_pair_release_guard> sub
  #<release_target_b> = #1
  #<release_target_c> = #2

  (A valid wireless contact can repeat during the HAL post-G38 ignore window.)
  (After retract, require two consecutive clear samples 0.05 s apart within)
  (the configured post-contact timeout. The pre-G38 guard rechecks clear state.)
  M66 E0 L0
  o<pair_release_hal_window_match> if [ABS[#<_hal[tcpc_probe_gate_ignore.width]> - #756] GT 0.001]
    (abort, Paired probe release wait does not match the HAL ignore window)
  o<pair_release_hal_window_match> endif
  o<pair_release_gate_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
    (abort, Paired sphere probe gate remained active after retract)
  o<pair_release_gate_clear> endif

  #<release_elapsed> = 0.0
  #<release_clear_count> = 0.0
  o<pair_release_wait> while [[#<release_elapsed> LT #756] AND [#<release_clear_count> LT 1.5]]
    G4 P0.05
    M66 E0 L0
    o<pair_release_gate_still_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
      (abort, Paired sphere probe gate reactivated after retract)
    o<pair_release_gate_still_clear> endif
    o<pair_release_sample_clear> if [[#<_hal[t_probe-in]> LT 0.5] AND [#<_hal[probe-mux]> LT 0.5]]
      #<release_clear_count> = [#<release_clear_count> + 1.0]
    o<pair_release_sample_clear> else
      #<release_clear_count> = 0.0
    o<pair_release_sample_clear> endif
    #<release_elapsed> = [#<release_elapsed> + 0.05]
  o<pair_release_wait> endwhile
  o<pair_release_timeout> if [#<release_clear_count> LT 1.5]
    (abort, Paired sphere probe did not release within post-contact timeout)
  o<pair_release_timeout> endif

  o<tcpc_pair_live_guard> call [1.0] [#<release_target_b>] [#<release_target_c>]
o<tcpc_pair_release_guard> endsub

o<tcpc_pair_probe_ready_guard> sub
  #<ready_target_b> = #1
  #<ready_target_c> = #2

  (Do not dwell or retry here. Require synchronized clear state before G38.)
  M66 E0 L0
  o<pair_ready_hal_width> if [ABS[#<_hal[tcpc_probe_fault_pause.width]> - 0.50] GT 0.001]
    (abort, Paired probe abnormal-pulse event latch is not 0.5 seconds)
  o<pair_ready_hal_width> endif
  o<pair_ready_ignore_width> if [ABS[#<_hal[tcpc_probe_gate_ignore.width]> - #756] GT 0.001]
    (abort, Paired probe post-contact ignore does not match the runner)
  o<pair_ready_ignore_width> endif

  o<tcpc_pair_live_guard> call [1.0] [#<ready_target_b>] [#<ready_target_c>]

  (Close the live-guard-to-G38 gap with one final synchronized hard check.)
  M66 E0 L0
  o<pair_ready_final_probe_inputs> if [[#<_hal[t_probe-in]> GT 0.5] OR [#<_hal[probe-mux]> GT 0.5] OR [#<_hal[motion.probe-input]> GT 0.5]]
    (abort, Paired probe input is active immediately before G38)
  o<pair_ready_final_probe_inputs> endif
  o<pair_ready_final_gates> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5]]
    (abort, Paired probe gate request is active immediately before G38)
  o<pair_ready_final_gates> endif
  o<pair_ready_final_fault> if [#<_hal[tcpc_probe_fault_pause.out]> GT 0.5]
    (abort, Paired probe abnormal-pulse event is active immediately before G38)
  o<pair_ready_final_fault> endif
o<tcpc_pair_probe_ready_guard> endsub

o<tcpc_vector_sphere_pass4> sub
  #<pass_id> = #1
  #<start_x> = #2
  #<start_y> = #3
  #<start_z> = #4
  #<accepted> = #5

  G90
  F#507
  o<tcpc_pair_live_guard> call [1.0] [#520] [#521]
  G1 X#<start_x> Y#<start_y> Z#<start_z>
  o<tcpc_pair_live_guard> call [1.0] [#520] [#521]

  (Contact 1: W surface from the reviewed top-clear point.)
  #122 = [#530 * #508]
  #123 = [#531 * #508]
  #124 = [#532 * #508]
  G91
  F#506
  o<tcpc_pair_probe_ready_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<top4_fail> if [#5070 EQ 0]
    G90
    F#507
    G1 X#<start_x> Y#<start_y> Z#<start_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, Four-contact W touch did not record point data)
  o<top4_fail> endif

  #<qw_x> = #5061
  #<qw_y> = #5062
  #<qw_z> = #5063
  #612 = [[[#<qw_x> - #<start_x>] * #530] + [[#<qw_y> - #<start_y>] * #531] + [[#<qw_z> - #<start_z>] * #532]]
  #<qw_abs_x> = [#<qw_x> + #540]
  #<qw_abs_y> = [#<qw_y> + #541]
  #<qw_abs_z> = [#<qw_z> + #542]

  (The W contact provides the W coordinate and the first center estimate.)
  #<top_center_x> = [#<qw_x> + [#530 * #505]]
  #<top_center_y> = [#<qw_y> + [#531 * #505]]
  #<top_center_z> = [#<qw_z> + [#532 * #505]]
  #<top_center_abs_x> = [#<qw_abs_x> + [#530 * #505]]
  #<top_center_abs_y> = [#<qw_abs_y> + [#531 * #505]]
  #<top_center_abs_z> = [#<qw_abs_z> + [#532 * #505]]
  #<top_clear_x> = [#<top_center_x> - [#530 * #513]]
  #<top_clear_y> = [#<top_center_y> - [#531 * #513]]
  #<top_clear_z> = [#<top_center_z> - [#532 * #513]]

  G90
  F#507
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Contact 2: start on the safe -U side and probe +U.)
  (For positive B, -U is the upper side. The underside +U start is omitted.)
  #<um_start_x> = [#<top_center_x> - [#533 * #514]]
  #<um_start_y> = [#<top_center_y> - [#534 * #514]]
  #<um_start_z> = [#<top_center_z> - [#535 * #514]]
  #<um_clear_x> = [#<um_start_x> - [#530 * #513]]
  #<um_clear_y> = [#<um_start_y> - [#531 * #513]]
  #<um_clear_z> = [#<um_start_z> - [#532 * #513]]
  o<tcpc_pair_release_guard> call [#520] [#521]
  G90
  F#507
  G1 X#<um_clear_x> Y#<um_clear_y> Z#<um_clear_z>
  G1 X#<um_start_x> Y#<um_start_y> Z#<um_start_z>
  #122 = [#533 * #511]
  #123 = [#534 * #511]
  #124 = [#535 * #511]
  G91
  F#506
  o<tcpc_pair_probe_ready_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<um4_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, Four-contact safe U touch did not record point data)
  o<um4_fail> endif
  #<qu_x> = #5061
  #<qu_y> = #5062
  #<qu_z> = #5063
  #613 = [[[#<qu_x> - #<um_start_x>] * #533] + [[#<qu_y> - #<um_start_y>] * #534] + [[#<qu_z> - #<um_start_z>] * #535]]
  #125 = [-#533 * #512]
  #126 = [-#534 * #512]
  #127 = [-#535 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<um_clear_x> Y#<um_clear_y> Z#<um_clear_z>
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Contact 3: -V side toward +V.)
  #<vm_start_x> = [#<top_center_x> - [#536 * #514]]
  #<vm_start_y> = [#<top_center_y> - [#537 * #514]]
  #<vm_start_z> = [#<top_center_z> - [#538 * #514]]
  #<vm_clear_x> = [#<vm_start_x> - [#530 * #513]]
  #<vm_clear_y> = [#<vm_start_y> - [#531 * #513]]
  #<vm_clear_z> = [#<vm_start_z> - [#532 * #513]]
  o<tcpc_pair_release_guard> call [#520] [#521]
  G90
  F#507
  G1 X#<vm_clear_x> Y#<vm_clear_y> Z#<vm_clear_z>
  G1 X#<vm_start_x> Y#<vm_start_y> Z#<vm_start_z>
  #122 = [#536 * #511]
  #123 = [#537 * #511]
  #124 = [#538 * #511]
  G91
  F#506
  o<tcpc_pair_probe_ready_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<vm4_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, Four-contact -V touch did not record point data)
  o<vm4_fail> endif
  #<qvm_x> = #5061
  #<qvm_y> = #5062
  #<qvm_z> = #5063
  #615 = [[[#<qvm_x> - #<vm_start_x>] * #536] + [[#<qvm_y> - #<vm_start_y>] * #537] + [[#<qvm_z> - #<vm_start_z>] * #538]]
  #125 = [-#536 * #512]
  #126 = [-#537 * #512]
  #127 = [-#538 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<vm_clear_x> Y#<vm_clear_y> Z#<vm_clear_z>
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>

  (Contact 4: +V side toward -V.)
  #<vp_start_x> = [#<top_center_x> + [#536 * #514]]
  #<vp_start_y> = [#<top_center_y> + [#537 * #514]]
  #<vp_start_z> = [#<top_center_z> + [#538 * #514]]
  #<vp_clear_x> = [#<vp_start_x> - [#530 * #513]]
  #<vp_clear_y> = [#<vp_start_y> - [#531 * #513]]
  #<vp_clear_z> = [#<vp_start_z> - [#532 * #513]]
  o<tcpc_pair_release_guard> call [#520] [#521]
  G90
  F#507
  G1 X#<vp_clear_x> Y#<vp_clear_y> Z#<vp_clear_z>
  G1 X#<vp_start_x> Y#<vp_start_y> Z#<vp_start_z>
  #122 = [-#536 * #511]
  #123 = [-#537 * #511]
  #124 = [-#538 * #511]
  G91
  F#506
  o<tcpc_pair_probe_ready_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  o<vp4_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    (abort, Four-contact +V touch did not record point data)
  o<vp4_fail> endif
  #<qvp_x> = #5061
  #<qvp_y> = #5062
  #<qvp_z> = #5063
  #616 = [[[#<vp_start_x> - #<qvp_x>] * #536] + [[#<vp_start_y> - #<qvp_y>] * #537] + [[#<vp_start_z> - #<qvp_z>] * #538]]
  #125 = [#536 * #512]
  #126 = [#537 * #512]
  #127 = [#538 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<vp_clear_x> Y#<vp_clear_y> Z#<vp_clear_z>
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
  o<tcpc_pair_release_guard> call [#520] [#521]

  #<qu_abs_x> = [#<qu_x> + #540]
  #<qu_abs_y> = [#<qu_y> + #541]
  #<qu_abs_z> = [#<qu_z> + #542]
  #<qvm_abs_x> = [#<qvm_x> + #540]
  #<qvm_abs_y> = [#<qvm_y> + #541]
  #<qvm_abs_z> = [#<qvm_z> + #542]
  #<qvp_abs_x> = [#<qvp_x> + #540]
  #<qvp_abs_y> = [#<qvp_y> + #541]
  #<qvp_abs_z> = [#<qvp_z> + #542]

  (Certified-radius single-side reconstruction in the orthonormal W/U/V basis.)
  #<center_w> = [[[#<qw_abs_x> * #530] + [#<qw_abs_y> * #531] + [#<qw_abs_z> * #532]] + #505]
  #<center_u> = [[[#<qu_abs_x> * #533] + [#<qu_abs_y> * #534] + [#<qu_abs_z> * #535]] + #505]
  #<center_v> = [[[[#<qvm_abs_x> * #536] + [#<qvm_abs_y> * #537] + [#<qvm_abs_z> * #538]] + [[#<qvp_abs_x> * #536] + [#<qvp_abs_y> * #537] + [#<qvp_abs_z> * #538]]] / 2.0]
  #603 = [[#530 * #<center_w>] + [#533 * #<center_u>] + [#536 * #<center_v>]]
  #604 = [[#531 * #<center_w>] + [#534 * #<center_u>] + [#537 * #<center_v>]]
  #605 = [[#532 * #<center_w>] + [#535 * #<center_u>] + [#538 * #<center_v>]]

  #600 = [#<top_center_abs_x> - #540]
  #601 = [#<top_center_abs_y> - #541]
  #602 = [#<top_center_abs_z> - #542]
  #<corr_x> = [#603 - #<top_center_abs_x>]
  #<corr_y> = [#604 - #<top_center_abs_y>]
  #<corr_z> = [#605 - #<top_center_abs_z>]
  #606 = [[#<corr_x> * #533] + [#<corr_y> * #534] + [#<corr_z> * #535]]
  #607 = [[#<corr_x> * #536] + [#<corr_y> * #537] + [#<corr_z> * #538]]
  #630 = SQRT[[#<corr_x> * #<corr_x>] + [#<corr_y> * #<corr_y>] + [#<corr_z> * #<corr_z>]]

  (Only V has two measured opposing contacts; never report a U diameter.)
  #<v_dx> = [#<qvp_abs_x> - #<qvm_abs_x>]
  #<v_dy> = [#<qvp_abs_y> - #<qvm_abs_y>]
  #<v_dz> = [#<qvp_abs_z> - #<qvm_abs_z>]
  #609 = [[#<v_dx> * #536] + [#<v_dy> * #537] + [#<v_dz> * #538]]
  #611 = [#609 - [2.0 * #504]]
  #614 = 0.0

  (Full radial residuals expose inconsistent contacts not visible in projections.)
  #<rw> = SQRT[[[#603 - #<qw_abs_x>] * [#603 - #<qw_abs_x>]] + [[#604 - #<qw_abs_y>] * [#604 - #<qw_abs_y>]] + [[#605 - #<qw_abs_z>] * [#605 - #<qw_abs_z>]]]
  #<ru> = SQRT[[[#603 - #<qu_abs_x>] * [#603 - #<qu_abs_x>]] + [[#604 - #<qu_abs_y>] * [#604 - #<qu_abs_y>]] + [[#605 - #<qu_abs_z>] * [#605 - #<qu_abs_z>]]]
  #<rvm> = SQRT[[[#603 - #<qvm_abs_x>] * [#603 - #<qvm_abs_x>]] + [[#604 - #<qvm_abs_y>] * [#604 - #<qvm_abs_y>]] + [[#605 - #<qvm_abs_z>] * [#605 - #<qvm_abs_z>]]]
  #<rvp> = SQRT[[[#603 - #<qvp_abs_x>] * [#603 - #<qvp_abs_x>]] + [[#604 - #<qvp_abs_y>] * [#604 - #<qvp_abs_y>]] + [[#605 - #<qvp_abs_z>] * [#605 - #<qvp_abs_z>]]]
  #631 = ABS[#<rw> - #505]
  #632 = ABS[#<ru> - #505]
  #633 = ABS[#<rvm> - #505]
  #634 = ABS[#<rvp> - #505]

  (Capture rotary, endpoint, and linear-axis state for the accepted-row schema.)
  #150 = #<_hal[joint.3.pos-cmd]>
  #151 = #<_hal[joint.3.pos-fb]>
  #154 = #<_hal[joint.4.pos-cmd]>
  #155 = #<_hal[joint.4.pos-fb]>
  #159 = #<_hal[b-ssi-zeroed-position]>
  #161 = #<_hal[c-ssi-zeroed-position]>
  #184 = #<_abs_x>
  #185 = #<_abs_y>
  #186 = #<_abs_z>
  #187 = #<_hal[joint.0.motor-pos-cmd]>
  #188 = #<_hal[joint.0.motor-pos-fb]>
  #189 = [#188 - #187]
  #190 = #<_hal[joint.1.motor-pos-cmd]>
  #191 = #<_hal[joint.1.motor-pos-fb]>
  #192 = [#191 - #190]
  #193 = #<_hal[joint.2.motor-pos-cmd]>
  #194 = #<_hal[joint.2.motor-pos-fb]>
  #195 = [#194 - #193]

  (DEBUG, TCPC_VECTOR4 pass #<pass_id> accepted #<accepted>)
  (DEBUG, TCPC_VECTOR4 center #603 #604 #605 correction_norm=#630)
  (DEBUG, TCPC_VECTOR4 v_diam=#611 radial_residuals=#631/#632/#633/#634)
o<tcpc_vector_sphere_pass4> endsub


o<tcpc_measure_pose> sub
  #<target_b> = #1
  #<target_c> = #2
  (Arguments #3 and #4 are reserved; pose inspection M0s are disabled.)

  (Fail before any retract, index, or positioning move if live state changed.)
  o<tcpc_pair_selector_guard> call
  o<pair_first_pose_start_guard> if [#700 LT 0.5]
    o<tcpc_pair_live_guard> call [1.0] [0.0] [0.0]
  o<pair_first_pose_start_guard> else
    o<tcpc_pair_live_guard> call [0.0] [0.0] [0.0]
  o<pair_first_pose_start_guard> endif

  (For later poses, retract along current W to the known top-clear point,)
  (then lift in machine Z, index, XY, and lower Z. A Z-only lift is not)
  (a safe pull-away when B is near +/-90.)
  o<use_high_z_transit> if [#700 GT 0.5]
    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<current_b> = #<_abs_b>
    #<current_c> = #<_abs_c>
    #<current_w_x> = [-SIN[#<current_b>] * COS[#<current_c>]]
    #<current_w_y> = [-SIN[#<current_b>] * SIN[#<current_c>]]
    #<current_w_z> = [-COS[#<current_b>]]
    #<current_clear_x> = [#701 - #540 - [#<current_w_x> * #513]]
    #<current_clear_y> = [#702 - #541 - [#<current_w_y> * #513]]
    #<current_clear_z> = [#703 - #542 - [#<current_w_z> * #513]]

    G90
    F#507
    G1 X#<current_clear_x> Y#<current_clear_y> Z#<current_clear_z>

    #<safe_z> = [#<_z> + #515]
    G1 Z#<safe_z>

    F#705
    G1 B#<target_b> C#<target_c>

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<start_w_x> = [-SIN[#<target_b>] * COS[#<target_c>]]
    #<start_w_y> = [-SIN[#<target_b>] * SIN[#<target_c>]]
    #<start_w_z> = [-COS[#<target_b>]]
    #<next_start_x> = [#701 - #540 - [#<start_w_x> * #513]]
    #<next_start_y> = [#702 - #541 - [#<start_w_y> * #513]]
    #<next_start_z> = [#703 - #542 - [#<start_w_z> * #513]]
    F#507
    G1 X#<next_start_x> Y#<next_start_y>
    F200.0
    G1 Z#<next_start_z>
    F#507
  o<use_high_z_transit> else
    (First pose starts from the operator-set position near the sphere.)
    G90
    F#705
    G1 B#<target_b> C#<target_c>

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]
  o<use_high_z_transit> endif

  (Verify commanded, feedback, and SSI pose before either probe pass.)
  o<tcpc_pair_live_guard> call [1.0] [#<target_b>] [#<target_c>]

  #520 = #<_abs_b>
  #521 = #<_abs_c>

  (W points along the probe vector toward the table at this B/C pose.)
  #530 = [-SIN[#520] * COS[#521]]
  #531 = [-SIN[#520] * SIN[#521]]
  #532 = [-COS[#520]]

  (U is perpendicular to W in the tilt plane.)
  #533 = [COS[#520] * COS[#521]]
  #534 = [COS[#520] * SIN[#521]]
  #535 = [-SIN[#520]]

  (V is perpendicular to W and U.)
  #536 = [-SIN[#521]]
  #537 = [COS[#521]]
  #538 = 0.0

  #550 = #<_x>
  #551 = #<_y>
  #552 = #<_z>

  #<pose_acquisition_try> = 0.0
  #<pose_acquisition_ok> = 0.0
  #<pose_reject_stage> = 0.0
  #<pose_reject_reason> = 0.0

  (Retry one complete two-pass pose after a bounded quality rejection.)
  o<pose_acquisition_loop> while [[#<pose_acquisition_try> LT #739] AND [#<pose_acquisition_ok> LT 0.5]]
    #<pose_acquisition_try> = [#<pose_acquisition_try> + 1.0]
    #<pose_quality_ok> = 1.0
    #<pose_reject_stage> = 0.0
    #<pose_reject_reason> = 0.0
    #629 = 0.0

    (Run pass 1 from the frozen current/operator start point.)
    o<tcpc_vector_sphere_pass4> call [1.0] [#550] [#551] [#552] [0.0]
    #<pose_reject_stage> = 1.0
    o<pose_p1_travel_quality> if [[#612 LT #759] OR [#613 LT #759] OR [#615 LT #759] OR [#616 LT #759]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 1.0
    o<pose_p1_travel_quality> endif
    o<pose_p1_center_quality> if [#630 GE 2.0]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 2.0
    o<pose_p1_center_quality> endif
    o<pose_p1_diameter_quality> if [[#611 LT 29.5] OR [#611 GT 31.0]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 3.0
    o<pose_p1_diameter_quality> endif
    o<pose_p1_radial_quality> if [[#631 GT 1.0] OR [#632 GT 1.0] OR [#633 GT 1.0] OR [#634 GT 1.0]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 4.0
    o<pose_p1_radial_quality> endif

    o<pose_pass1_quality_ok> if [#<pose_quality_ok> GT 0.5]
      (Use the complete four-contact reconstructed center for pass 2.)
      #623 = [#603 - #540]
      #624 = [#604 - #541]
      #625 = [#605 - #542]
      #620 = [#623 - #600]
      #621 = [#624 - #601]
      #622 = [#625 - #602]

      (Start pass 2 at top clearance above the corrected center.)
      #626 = [#623 - [#530 * #513]]
      #627 = [#624 - [#531 * #513]]
      #628 = [#625 - [#532 * #513]]

      (DEBUG, TCPC_VECTOR4 correction #620 #621 #622)
      o<tcpc_vector_sphere_pass4> call [2.0] [#626] [#627] [#628] [1.0]
      #<pose_reject_stage> = 2.0
      o<pose_p2_travel_quality> if [[#612 LT #759] OR [#613 LT #759] OR [#615 LT #759] OR [#616 LT #759]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 5.0
      o<pose_p2_travel_quality> endif
      o<pose_p2_diameter_quality> if [[#611 LT 29.9] OR [#611 GT 30.5]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 6.0
      o<pose_p2_diameter_quality> endif
      o<pose_p2_radial_quality> if [[#630 GT 0.25] OR [#631 GT 0.25] OR [#632 GT 0.25] OR [#633 GT 0.25] OR [#634 GT 0.25]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 7.0
      o<pose_p2_radial_quality> endif
      #629 = SQRT[[[#603 - [#623 + #540]] * [#603 - [#623 + #540]]] + [[#604 - [#624 + #541]] * [#604 - [#624 + #541]]] + [[#605 - [#625 + #542]] * [#605 - [#625 + #542]]]]
      o<pose_p2_center_agreement> if [#629 GT 0.10]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 8.0
      o<pose_p2_center_agreement> endif
    o<pose_pass1_quality_ok> endif

    o<pose_quality_accept> if [#<pose_quality_ok> GT 0.5]
      #<pose_acquisition_ok> = 1.0
    o<pose_quality_accept> else
      (DEBUG, TCPC_VECTOR4 reject try=#<pose_acquisition_try> stage=#<pose_reject_stage> reason=#<pose_reject_reason> travel=#612/#613/#615/#616 correction_norm=#630 v_diam=#611 radial=#631/#632/#633/#634 center_delta=#629)
      o<pose_quality_retry_available> if [#<pose_acquisition_try> LT #739]
        (DEBUG, TCPC_VECTOR4 retrying complete pose after release check)
        o<tcpc_pair_live_guard> call [1.0] [#520] [#521]
        G90
        F#507
        G1 X#550 Y#551 Z#552
        o<tcpc_pair_release_guard> call [#520] [#521]
      o<pose_quality_retry_available> endif
    o<pose_quality_accept> endif
  o<pose_acquisition_loop> endwhile

  o<pose_quality_retry_exhausted> if [#<pose_acquisition_ok> LT 0.5]
    (abort, Sphere pose quality failed twice; retain partial and restart with a new attempt)
  o<pose_quality_retry_exhausted> endif

  #700 = 1.0
  #701 = #603
  #702 = #604
  #703 = #605

  o<pair_summary_logging> if [#714 GT 0.5]
    (Refresh the logged fields and reject state changes after the accepted pass.)
    o<tcpc_pair_selector_guard> call
    o<tcpc_pair_live_guard> call [1.0] [#520] [#521]
    #726 = [#726 + 1.0]
    (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-high-b-t3-supplemental-results.csv)
    (LOG,1.0,#715,#711,#727,#726,#728,#729,#738,4.0,1.0,#520,#521,#719,#516,#502,#501,#505,#603,#604,#605,#606,#607,#630,#611,#629,#631,#632,#633,#634,#612,#613,#615,#616)
    (LOGCLOSE)
    (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-high-b-t3-supplemental-state.csv)
    (LOG,1.0,#715,#711,#727,#726,#520,#521,#718,#720,#721,#722,#723,#724,#725,#517,#518,#519,#150,#151,#154,#155,#159,#161,#184,#185,#186,#187,#188,#189,#190,#191,#192,#193,#194,#195)
    (LOGCLOSE)
  o<pair_summary_logging> endif

o<tcpc_measure_pose> endsub

o<tcpc_baseline_closure_guard> sub
  #<closure_dx> = [#701 - #1]
  #<closure_dy> = [#702 - #2]
  #<closure_dz> = [#703 - #3]
  #<closure_norm> = SQRT[[#<closure_dx> * #<closure_dx>] + [#<closure_dy> * #<closure_dy>] + [#<closure_dz> * #<closure_dz>]]
  (DEBUG, BASELINE C0 closure dx=#<closure_dx> dy=#<closure_dy> dz=#<closure_dz> norm=#<closure_norm>)
  o<baseline_closure_limit> if [#<closure_norm> GT 0.250]
    (abort, Baseline C0 closure exceeds 0.250 mm; retain partial and restart with a new attempt)
  o<baseline_closure_limit> endif
o<tcpc_baseline_closure_guard> endsub

o<tcpc_high_b_closure_guard> sub
  #<closure_dx> = [#701 - #1]
  #<closure_dy> = [#702 - #2]
  #<closure_dz> = [#703 - #3]
  #<closure_norm> = SQRT[[#<closure_dx> * #<closure_dx>] + [#<closure_dy> * #<closure_dy>] + [#<closure_dz> * #<closure_dz>]]
  #<closure_pass> = 1.0
  o<high_b_closure_failed> if [#<closure_norm> GT 0.250]
    #<closure_pass> = 0.0
  o<high_b_closure_failed> endif

  (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-high-b-t3-supplemental-closures.csv)
  (LOG,1.0,#715,#711,#727,#4,#5,#6,#7,#8,#520,#521,#<closure_dx>,#<closure_dy>,#<closure_dz>,#<closure_norm>,0.250,#<closure_pass>)
  (LOGCLOSE)
  (DEBUG, TCPC_HIGH_B closure id=#4 open_seq=#5 close_seq=#6 dx=#<closure_dx> dy=#<closure_dy> dz=#<closure_dz> norm=#<closure_norm>)

  o<high_b_closure_limit> if [#<closure_pass> LT 0.5]
    (abort, High-B sphere closure exceeds 0.250 mm; retain partial and start a new attempt)
  o<high_b_closure_limit> endif
o<tcpc_high_b_closure_guard> endsub

