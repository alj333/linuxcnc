#<_twp_grid_eval_a2_x> = #<_hal[headheadkins.tool-offset.x]>
#<_twp_grid_eval_a2_y> = #<_hal[headheadkins.tool-offset.y]>
#<_twp_grid_eval_a2_z> = #<_hal[headheadkins.tool-offset.z]>

(A2: closing WORLD center after the complete low-angle TWP grid.)
#<_twp_grid_phase> = 99.0
o<twp_grid_measure_pair> call [0.0]
#<_twp_grid_a2_x> = [#<_twp_grid_measure_center_x> + #<_twp_grid_wcs_x> + #<_twp_grid_eval_a2_x>]
#<_twp_grid_a2_y> = [#<_twp_grid_measure_center_y> + #<_twp_grid_wcs_y> + #<_twp_grid_eval_a2_y>]
#<_twp_grid_a2_z> = [#<_twp_grid_measure_center_z> + #<_twp_grid_wcs_z>]
#<_twp_grid_a2_z> = [#<_twp_grid_a2_z> + #<_twp_grid_tool_length> + #<_twp_grid_eval_a2_z>]
#<_twp_grid_a2_pair> = #<_twp_grid_pair_delta>
#<_twp_grid_a2_diam> = #<_twp_grid_measure_vdiam>
#<_twp_grid_a2_residual> = #<_twp_grid_measure_residual>

(Move clear in world mode before evaluating or reporting any failed gate.)
G91
F#<_twp_grid_position_feed>
G1 Z25.0
G90
o<twp_grid_live_guard> call [0.0]

#<a_dx> = [#<_twp_grid_a2_x> - #<_twp_grid_a1_x>]
#<a_dy> = [#<_twp_grid_a2_y> - #<_twp_grid_a1_y>]
#<a_dz> = [#<_twp_grid_a2_z> - #<_twp_grid_a1_z>]
#<_twp_grid_world_closure> = SQRT[[#<a_dx> * #<a_dx>] + [#<a_dy> * #<a_dy>] + [#<a_dz> * #<a_dz>]]
#<_twp_grid_counter_end> = #<_hal[counter.2.position]>
#<counter_delta> = [#<_twp_grid_counter_end> - #<_twp_grid_counter_start>]
#<expected_edges> = [16.0 + [4.0 * [#<_twp_grid_pose_count> - #<_twp_grid_start_pose> + 1.0]]]

o<twp_grid_total_edges> if [ABS[#<counter_delta> - #<expected_edges>] GT 0.1]
  (abort, TWP sphere grid did not record the expected gated contacts)
o<twp_grid_total_edges> endif
o<twp_grid_last_pose_gate> if [ABS[#<_twp_grid_last_pose> - #<_twp_grid_pose_count>] GT 0.1]
  (abort, TWP sphere grid did not complete its final pose)
o<twp_grid_last_pose_gate> endif
o<twp_grid_world_closure_gate> if [#<_twp_grid_world_closure> GT #<_twp_grid_world_closure_limit>]
  (abort, TWP sphere grid WORLD return closure exceeds 0.100 mm)
o<twp_grid_world_closure_gate> endif

