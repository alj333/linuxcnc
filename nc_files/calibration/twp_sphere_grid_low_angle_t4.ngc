#<_twp_grid_world_high_y> = #<_twp_grid_a1_y>
#<_twp_grid_world_high_z> = [#<_twp_grid_a1_z> + #<_twp_grid_transition_radius>]
o<twp_grid_move_world_tool> call [#<_twp_grid_world_high_x>] [#<_twp_grid_world_high_y>] [#<_twp_grid_world_high_z>]
#<_twp_grid_last_pose> = 0.0

o<twp_grid_start_pose_low> if [#<_twp_grid_start_pose> LT 1.0]
  (abort, TWP grid start pose must be in the integral range 1 through 24)
o<twp_grid_start_pose_low> endif
o<twp_grid_start_pose_high> if [#<_twp_grid_start_pose> GT #<_twp_grid_pose_count>]
  (abort, TWP grid start pose must be in the integral range 1 through 24)
o<twp_grid_start_pose_high> endif
o<twp_grid_start_pose_integral> if [ABS[#<_twp_grid_start_pose> - FIX[#<_twp_grid_start_pose>]] GT 0.001]
  (abort, TWP grid start pose must be an integer)
o<twp_grid_start_pose_integral> endif

(Each positive B pose is immediately followed by its corresponding negative B pose.)
(C0 quadrant.)
o<twp_grid_pose_01> if [#<_twp_grid_start_pose> LE 1.0]
  o<twp_grid_run_pose> call [1.0] [5.0] [0.0] [90.0] [5.0] [-90.0]
o<twp_grid_pose_01> endif
o<twp_grid_pose_02> if [#<_twp_grid_start_pose> LE 2.0]
  o<twp_grid_run_pose> call [2.0] [-5.0] [0.0] [-90.0] [5.0] [90.0]
o<twp_grid_pose_02> endif
