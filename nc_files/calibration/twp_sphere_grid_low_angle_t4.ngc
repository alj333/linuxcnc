#<_twp_grid_counter_start> = #<_hal[counter.2.position]>

(A1: opening WORLD center at the standard B0/C0 start.)
#<_twp_grid_phase> = 0.0
o<twp_grid_measure_pair> call [0.0]
#<_twp_grid_a1_x> = [#<_twp_grid_measure_center_x> + #<_twp_grid_wcs_x> + #<_twp_grid_eval_a1_x>]
#<_twp_grid_a1_y> = [#<_twp_grid_measure_center_y> + #<_twp_grid_wcs_y> + #<_twp_grid_eval_a1_y>]
