(C90 quadrant.)
o<twp_grid_pose_07> if [#<_twp_grid_start_pose> LE 7.0]
  o<twp_grid_run_pose> call [7.0] [5.0] [90.0] [180.0] [5.0] [-90.0]
o<twp_grid_pose_07> endif
o<twp_grid_pose_08> if [#<_twp_grid_start_pose> LE 8.0]
  o<twp_grid_run_pose> call [8.0] [-5.0] [90.0] [0.0] [5.0] [90.0]
