  o<pair_mode_unchanged> if [ABS[#711 - #730] GT 0.000001]
    (abort, Paired stage changed during an operator hold; reload the program)
  o<pair_mode_unchanged> endif
  o<pair_campaign_unchanged> if [ABS[#715 - #731] GT 0.000001]
    (abort, Paired campaign changed during an operator hold; reload the program)
  o<pair_campaign_unchanged> endif
  o<pair_leg_unchanged> if [ABS[#716 - #732] GT 0.000001]
    (abort, Paired leg changed during an operator hold; reload the program)
  o<pair_leg_unchanged> endif
  o<pair_calibration_unchanged> if [ABS[#717 - #733] GT 0.000001]
    (abort, Expected probe offset changed during an operator hold; reload the program)
  o<pair_calibration_unchanged> endif
  o<pair_attempt_unchanged> if [ABS[#727 - #734] GT 0.000001]
    (abort, Paired attempt changed during an operator hold; reload the program)
  o<pair_attempt_unchanged> endif
  o<pair_flag_unchanged> if [[ABS[#714 - #735] GT 0.000001] OR [ABS[#714 - 1.0] GT 0.000001]]
    (abort, Paired-only mode flag changed during an operator hold)
  o<pair_flag_unchanged> endif
  o<pair_motion_constants_a> if [[ABS[#503 - #740] GT 0.000001] OR [ABS[#504 - #741] GT 0.000001] OR [ABS[#505 - #742] GT 0.000001] OR [ABS[#506 - #743] GT 0.000001]]
    (abort, Paired sphere geometry or probe feed changed during an operator hold)
  o<pair_motion_constants_a> endif
  o<pair_motion_constants_b> if [[ABS[#507 - #744] GT 0.000001] OR [ABS[#508 - #745] GT 0.000001] OR [ABS[#509 - #746] GT 0.000001] OR [ABS[#510 - #747] GT 0.000001]]
    (abort, Paired positioning feed or top clearance changed during an operator hold)
  o<pair_motion_constants_b> endif
  o<pair_motion_constants_c> if [[ABS[#511 - #748] GT 0.000001] OR [ABS[#512 - #749] GT 0.000001] OR [ABS[#513 - #750] GT 0.000001] OR [ABS[#514 - #751] GT 0.000001]]
    (abort, Paired side probe or clearance value changed during an operator hold)
  o<pair_motion_constants_c> endif
  o<pair_motion_constants_d> if [[ABS[#515 - #752] GT 0.000001] OR [ABS[#516 - #753] GT 0.000001] OR [ABS[#704 - #754] GT 0.000001] OR [ABS[#705 - #755] GT 0.000001]]
    (abort, Paired lift length pause or rotary feed changed during an operator hold)
  o<pair_motion_constants_d> endif
  o<pair_release_wait_unchanged> if [ABS[#756 - #757] GT 0.000001]
    (abort, Paired probe release wait changed during an operator hold)
  o<pair_release_wait_unchanged> endif
  o<pair_probe_quality_constants> if [[ABS[#739 - #786] GT 0.000001] OR [ABS[#759 - #787] GT 0.000001]]
    (abort, Paired probe retry or travel constants changed during the run)
  o<pair_probe_quality_constants> endif
  o<pair_probe_quiet_duration> if [[ABS[#777 - #794] GT 0.000001] OR [ABS[#777 - 15.0] GT 0.000001]]
    (abort, Automatic stationary probe quiet duration changed)
  o<pair_probe_quiet_duration> endif
  o<pair_probe_quiet_timeout> if [[ABS[#779 - #789] GT 0.000001] OR [ABS[#779 - 900.0] GT 0.000001]]
    (abort, Automatic stationary probe quiet timeout changed)
  o<pair_probe_quiet_timeout> endif
  o<pair_probe_quiet_sample> if [[ABS[#793 - #795] GT 0.000001] OR [ABS[#793 - 0.25] GT 0.000001]]
    (abort, Automatic stationary probe quiet sample period changed)
  o<pair_probe_quiet_sample> endif
  o<pair_resume_work_constants> if [[ABS[#774 - #827] GT 0.000001] OR [ABS[#775 - #828] GT 0.000001] OR [ABS[#776 - #829] GT 0.000001] OR [ABS[#778 - #830] GT 0.000001]]
    (abort, Frozen G54 work-start constants changed; reload the program)
  o<pair_resume_work_constants> endif
  o<pair_resume_absolute_constants> if [[ABS[#831 - #834] GT 0.000001] OR [ABS[#832 - #835] GT 0.000001] OR [ABS[#833 - #836] GT 0.000001]]
    (abort, Frozen absolute start constants changed; reload the program)
  o<pair_resume_absolute_constants> endif
  o<pair_a6_center_constants> if [[ABS[#837 - #840] GT 0.000001] OR [ABS[#838 - #841] GT 0.000001] OR [ABS[#839 - #842] GT 0.000001]]
    (abort, Immutable Attempt-6 sequence-23 center constants changed)
  o<pair_a6_center_constants> endif
  o<pair_g54_constants> if [[ABS[#843 - #846] GT 0.000001] OR [ABS[#844 - #847] GT 0.000001] OR [ABS[#845 - #848] GT 0.000001]]
    (abort, Frozen G54 offset constants changed; reload the program)
  o<pair_g54_constants> endif
  o<tcpc_pair_coordinate_guard> call
o<tcpc_pair_selector_guard> endsub

(Read-only runtime guard for the startup-only length-aware revision.)
o<tcpc_length_model_guard> sub
  (Revision, configuration, live length, q=0 bank, and cap guard.)
  M66 E0 L0
  o<lm_configured> if [#<_hal[headheadkins.length-model.configured]> LT 0.5]
    (abort, Length-aware kinematics is not configured)
  o<lm_configured> endif
  o<lm_valid> if [#<_hal[headheadkins.length-model.valid]> LT 0.5]
    (abort, Length-aware model is not valid for the active tool offset)
  o<lm_valid> endif
  o<lm_fault_clear> if [ABS[#<_hal[headheadkins.length-model.fault-code]>] GT 0.1]
    (abort, Length-aware model reports a nonzero fault code)
  o<lm_fault_clear> endif
  o<lm_id> if [ABS[#<_hal[headheadkins.length-model.id]> - 2026082601.0] GT 0.1]
    (abort, Length-aware coefficient model ID is not 2026082601)
  o<lm_id> endif
  o<lm_expected_id> if [ABS[#<_hal[headheadkins.length-model.expected-id]> - 2026082601.0] GT 0.1]
    (abort, Kinematics expected model ID is not 2026082601)
  o<lm_expected_id> endif
  o<lm_reference> if [ABS[#<_hal[headheadkins.length-model.reference]> - 229.407000] GT 0.000001]
    (abort, Length-aware reference length changed)
  o<lm_reference> endif
  o<lm_span> if [ABS[#<_hal[headheadkins.length-model.span]> - 100.800271] GT 0.000001]
    (abort, Length-aware T3-to-T4 span changed)
  o<lm_span> endif
  o<lm_minimum> if [ABS[#<_hal[headheadkins.length-model.minimum]> - 100.000000] GT 0.000001]
    (abort, Length-aware minimum length changed)
  o<lm_minimum> endif
  o<lm_maximum> if [ABS[#<_hal[headheadkins.length-model.maximum]> - 430.000000] GT 0.000001]
    (abort, Length-aware maximum length changed)
  o<lm_maximum> endif
  o<lm_tolerance> if [ABS[#<_hal[headheadkins.length-model.tolerance]> - 0.002000] GT 0.000001]
    (abort, Length-aware boundary tolerance changed)
  o<lm_tolerance> endif
  o<lm_diff_cap> if [ABS[#<_hal[headheadkins.length-model.max-diff-norm]> - 0.400000] GT 0.000001]
    (abort, Length-aware differential bank cap changed)
  o<lm_diff_cap> endif
  o<lm_total_cap> if [ABS[#<_hal[headheadkins.length-model.max-total-norm]> - 1.350000] GT 0.000001]
    (abort, Length-aware total empirical cap changed)
  o<lm_total_cap> endif
  o<lm_eval_length> if [ABS[#<_hal[headheadkins.tool-offset-eval.length]> - #516] GT 0.002]
    (abort, Length-aware evaluated tool length is not T4 H4)
  o<lm_eval_length> endif
  o<lm_q_zero> if [ABS[#<_hal[headheadkins.length-model.q]>] GT 0.000001]
    (abort, T4 length-aware scale q is not zero)
  o<lm_q_zero> endif
  o<lm_diff_x_zero> if [ABS[#<_hal[headheadkins.length-model.diff-offset.x]>] GT 0.000001]
    (abort, T4 differential bank X contribution is not zero)
  o<lm_diff_x_zero> endif
  o<lm_diff_y_zero> if [ABS[#<_hal[headheadkins.length-model.diff-offset.y]>] GT 0.000001]
    (abort, T4 differential bank Y contribution is not zero)
  o<lm_diff_y_zero> endif
  o<lm_diff_z_zero> if [ABS[#<_hal[headheadkins.length-model.diff-offset.z]>] GT 0.000001]
    (abort, T4 differential bank Z contribution is not zero)
  o<lm_diff_z_zero> endif
  o<lm_diff_norm_zero> if [ABS[#<_hal[headheadkins.length-model.diff-offset-norm]>] GT 0.000001]
    (abort, T4 differential bank norm is not zero)
  o<lm_diff_norm_zero> endif
  #<lm_total_numeric> = 0.0
  o<lm_total_numeric_range> if [[#<_hal[headheadkins.empirical-offset-norm]> GE 0.0] AND [#<_hal[headheadkins.empirical-offset-norm]> LE 1.350000]]
    #<lm_total_numeric> = 1.0
  o<lm_total_numeric_range> endif
  o<lm_total_numeric_required> if [#<lm_total_numeric> LT 0.5]
    (abort, Length-aware total empirical norm is nonfinite or above cap)
  o<lm_total_numeric_required> endif
  #<lm_x_numeric> = 0.0
  #<lm_y_numeric> = 0.0
  #<lm_z_numeric> = 0.0
  o<lm_x_numeric_range> if [[#<_hal[headheadkins.empirical-offset.x]> GE -1.350000] AND [#<_hal[headheadkins.empirical-offset.x]> LE 1.350000]]
    #<lm_x_numeric> = 1.0
  o<lm_x_numeric_range> endif
  o<lm_y_numeric_range> if [[#<_hal[headheadkins.empirical-offset.y]> GE -1.350000] AND [#<_hal[headheadkins.empirical-offset.y]> LE 1.350000]]
    #<lm_y_numeric> = 1.0
  o<lm_y_numeric_range> endif
  o<lm_z_numeric_range> if [[#<_hal[headheadkins.empirical-offset.z]> GE -1.350000] AND [#<_hal[headheadkins.empirical-offset.z]> LE 1.350000]]
    #<lm_z_numeric> = 1.0
  o<lm_z_numeric_range> endif
  o<lm_xyz_numeric_required> if [[#<lm_x_numeric> + #<lm_y_numeric> + #<lm_z_numeric>] LT 2.5]
    (abort, Length-aware empirical XYZ is nonfinite or outside total cap)
  o<lm_xyz_numeric_required> endif
o<tcpc_length_model_guard> endsub

o<tcpc_pair_live_guard> sub
  #<check_pose> = #1
  #<guard_target_b> = #2
  #<guard_target_c> = #3
  #<allow_gate_closed_noise> = #4

  (Drain queued motion before sampling live HAL state. Post-contact release)
  (checking is handled separately by tcpc_pair_release_guard.)
  M66 E0 L0

  o<tcpc_length_model_guard> call
  o<tcpc_pair_coordinate_guard> call

  o<pair_machine_on> if [#<_hal[halui.machine.is-on]> LT 0.5]
    (abort, Paired sphere run requires the machine enabled)
  o<pair_machine_on> endif
  o<pair_all_homed> if [[#<_hal[joint.0.homed]> + #<_hal[joint.1.homed]> + #<_hal[joint.2.homed]> + #<_hal[joint.3.homed]> + #<_hal[joint.4.homed]>] LT 4.5]
    (abort, Paired sphere run requires all five joints homed)
  o<pair_all_homed> endif
  o<pair_spindle_off> if [#<_hal[spindle.0.on]> GT 0.5]
    (abort, Paired sphere run requires the spindle stopped)
  o<pair_spindle_off> endif

  #718 = #<_hal[headheadkins.sim-bharm-enable]>
  o<pair_correction_live> if [#718 LT 0.5]
    (abort, Persistent correction is not enabled for paired sphere run)
  o<pair_correction_live> endif
  #719 = #<_hal[iocontrol.0.tool-number]>
  o<pair_tool_live> if [ABS[#719 - #500] GT 0.1]
    (abort, Live tool number changed during paired sphere run)
  o<pair_tool_live> endif

  o<pair_diameter_unchanged> if [[ABS[#501 - #758] GT 0.000001] OR [ABS[#501 - 6.0] GT 0.000001]]
    (abort, Frozen 6 mm paired probe diameter changed during the run)
  o<pair_diameter_unchanged> endif

  #502 = #3032
  o<pair_calibration_live> if [ABS[#502 - #717] GT 0.0005]
    (abort, Live #3032 changed from the frozen paired probe offset)
  o<pair_calibration_live> endif

  #517 = #<_hal[motion.tooloffset.z]>
  #518 = #<_hal[halui.tool.length_offset.z]>
  #519 = #<_hal[headheadkins.active-tool-offset.z]>
  o<pair_motion_tlo_live> if [ABS[#517 - #516] GT 0.002]
    (abort, Live motion Z tool offset changed during paired sphere run)
  o<pair_motion_tlo_live> endif
  o<pair_halui_tlo_live> if [ABS[#518 - #516] GT 0.002]
    (abort, Live HALUI Z tool offset changed during paired sphere run)
  o<pair_halui_tlo_live> endif
  o<pair_kins_tlo_live> if [ABS[#519 - #516] GT 0.002]
    (abort, Live kinematics Z tool offset changed during paired sphere run)
  o<pair_kins_tlo_live> endif
  o<pair_tlo_x_live> if [ABS[#<_hal[motion.tooloffset.x]>] GT 0.002]
    (abort, Paired sphere run requires zero active X tool offset)
  o<pair_tlo_x_live> endif
  o<pair_tlo_y_live> if [ABS[#<_hal[motion.tooloffset.y]>] GT 0.002]
    (abort, Paired sphere run requires zero active Y tool offset)
  o<pair_tlo_y_live> endif
  o<pair_tlo_abc_live> if [[ABS[#<_hal[motion.tooloffset.a]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.b]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.c]>] GT 0.002]]
    (abort, Paired sphere run requires zero active A B and C tool offsets)
  o<pair_tlo_abc_live> endif
  o<pair_tlo_uvw_live> if [[ABS[#<_hal[motion.tooloffset.u]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.v]>] GT 0.002] OR [ABS[#<_hal[motion.tooloffset.w]>] GT 0.002]]
    (abort, Paired sphere run requires zero active U V and W tool offsets)
  o<pair_tlo_uvw_live> endif

  #720 = #<_hal[headheadtwp.tcpc_enabled]>
  #721 = #<_hal[headheadtwp.active]>
  #722 = #<_hal[headheadtwp.motion_enabled]>
  #723 = #<_hal[headheadtwp.valid]>
  #724 = #<_hal[b-ssi-invalid]>
  #725 = #<_hal[c-ssi-invalid]>
  o<pair_tcpc_live> if [#720 LT 0.5]
    (abort, TCPC is not enabled during paired sphere run)
  o<pair_tcpc_live> endif
  o<pair_twp_clear_live> if [[#721 + #722 + #723] GT 0.5]
    (abort, TWP state is present during paired sphere run)
  o<pair_twp_clear_live> endif
  o<pair_ssi_valid_live> if [[#724 + #725] GT 0.5]
    (abort, Rotary SSI feedback is invalid during paired sphere run)
  o<pair_ssi_valid_live> endif

  o<pair_probe_gates_clear> if [[#<_hal[motion.digital-out-00]> GT 0.5] OR [#<_hal[motion.digital-out-01]> GT 0.5]]
    (abort, Paired sphere probe gates are not clear before motion)
  o<pair_probe_gates_clear> endif
  o<pair_probe_gated_input_clear> if [#<_hal[motion.probe-input]> GT 0.5]
    (abort, Paired sphere gated probe input is active outside G38)
  o<pair_probe_gated_input_clear> endif
  o<pair_probe_raw_mux_clear> if [[[#<_hal[t_probe-in]> + #<_hal[probe-mux]>] GT 0.5] AND [#<allow_gate_closed_noise> LT 0.5]]
    (abort, Paired sphere raw or mux probe input is active before motion)
  o<pair_probe_raw_mux_clear> endif

  o<pair_pose_check> if [#<check_pose> GT 0.5]
    #<b_cmd_error> = ABS[[[#<_hal[headheadtwp.current_joint_b]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<b_fb_error> = ABS[[[#<_hal[joint.3.pos-fb]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<b_ssi_error> = ABS[[[#<_hal[b-ssi-zeroed-position]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<c_cmd_error> = ABS[[[#<_hal[headheadtwp.current_joint_c]> - #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    #<c_fb_error> = ABS[[[#<_hal[joint.4.pos-fb]> - #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    (The physical C SSI zeroed signal has the opposite polarity to joint C.)
    #<c_ssi_error> = ABS[[[#<_hal[c-ssi-zeroed-position]> + #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    o<pair_b_pose_live> if [[#<b_cmd_error> GT 0.01] OR [#<b_fb_error> GT 0.01] OR [#<b_ssi_error> GT 0.01]]
      (abort, B command feedback or SSI is outside paired pose tolerance)
    o<pair_b_pose_live> endif
    o<pair_c_pose_live> if [[#<c_cmd_error> GT 0.01] OR [#<c_fb_error> GT 0.01] OR [#<c_ssi_error> GT 0.01]]
      (abort, C command feedback or SSI is outside paired pose tolerance)
    o<pair_c_pose_live> endif
    #<lm_eval_b_error> = ABS[[[#<_hal[headheadkins.tool-offset-eval.b]> - #<guard_target_b> + 540.0] MOD 360.0] - 180.0]
    #<lm_eval_c_error> = ABS[[[#<_hal[headheadkins.tool-offset-eval.c]> - #<guard_target_c> + 540.0] MOD 360.0] - 180.0]
    o<pair_lm_b_pose_live> if [#<lm_eval_b_error> GT 0.01]
      (abort, Length-aware evaluated B is outside paired pose tolerance)
    o<pair_lm_b_pose_live> endif
    o<pair_lm_c_pose_live> if [#<lm_eval_c_error> GT 0.01]
      (abort, Length-aware evaluated C is outside paired pose tolerance)
    o<pair_lm_c_pose_live> endif
  o<pair_pose_check> endif
o<tcpc_pair_live_guard> endsub

o<tcpc_pair_release_guard> sub
  #<release_target_b> = #1
  #<release_target_c> = #2
  #<release_status_mode> = #3
  #971 = 0.0

  (Normal path: physical release plus the existing 10 second HAL ignore window.)
  (Any post-G38 matched gate-closed activity invokes stationary 15 second quiet.)
  M66 E0 L0
  o<pair_release_hal_window_match> if [ABS[#<_hal[tcpc_probe_gate_ignore.width]> - #756] GT 0.001]
    #971 = 1.0
    o<pair_release_window_hard_abort> if [#<release_status_mode> LT 0.5]
      (abort, Paired probe release wait does not match the HAL ignore window)
    o<pair_release_window_hard_abort> endif
  o<pair_release_hal_window_match> endif
  o<pair_release_gate_clear> if [[[#<_hal[motion.digital-out-00]> + #<_hal[motion.digital-out-01]> + #<_hal[tcpc-probe-gate-enable]> + #<_hal[motion.probe-input]>] GT 0.5]]
    (abort, Paired sphere probe gate remained active after retract)
  o<pair_release_gate_clear> endif

  #<release_elapsed> = 0.0
  #<release_clear_count> = 0.0
  #<release_extra_seen> = #998
  #<release_last_raw> = #923
  #<release_last_mux> = #924
  o<pair_release_wait> while [[[#<release_elapsed> LT #756] AND [#<release_clear_count> LT 1.5]] AND [#971 LT 0.5]]
    G4 P#793
    #<release_elapsed> = [#<release_elapsed> + #793]
    M66 E0 L0
    o<tcpc_probe_counter_guard> call
    #<release_raw> = #<_hal[counter.0.counts]>
    #<release_mux> = #<_hal[counter.1.counts]>
    #<release_gated> = #<_hal[counter.2.counts]>
    o<pair_release_raw_monotonic> if [#<release_raw> LT #<release_last_raw>]
      (abort, Raw probe counter moved backwards during release)
    o<pair_release_raw_monotonic> endif
    o<pair_release_mux_monotonic> if [#<release_mux> LT #<release_last_mux>]
      (abort, Probe mux counter moved backwards during release)
    o<pair_release_mux_monotonic> endif
    o<pair_release_gated_exact> if [ABS[#<release_gated> - #925] GT 0.000001]
      (abort, Gated probe counter changed outside G38 during release)
    o<pair_release_gated_exact> endif
    o<pair_release_gate_still_clear> if [[[#<_hal[motion.digital-out-00]> + #<_hal[motion.digital-out-01]> + #<_hal[tcpc-probe-gate-enable]> + #<_hal[motion.probe-input]>] GT 0.5]]
      (abort, Paired sphere probe gate reactivated after retract)
    o<pair_release_gate_still_clear> endif
    o<pair_release_counter_activity> if [[ABS[#<release_raw> - #923] GT 0.000001] OR [ABS[#<release_mux> - #924] GT 0.000001]]
      #<release_extra_seen> = 1.0
    o<pair_release_counter_activity> endif
    o<pair_release_sample_clear> if [[#<_hal[t_probe-in]> LT 0.5] AND [#<_hal[probe-mux]> LT 0.5]]
      #<release_clear_count> = [#<release_clear_count> + 1.0]
    o<pair_release_sample_clear> else
      #<release_clear_count> = 0.0
    o<pair_release_sample_clear> endif
    #<release_last_raw> = #<release_raw>
    #<release_last_mux> = #<release_mux>
  o<pair_release_wait> endwhile
  o<pair_release_timeout> if [#<release_clear_count> LT 1.5]
    #971 = 1.0
    o<pair_release_timeout_hard_abort> if [#<release_status_mode> LT 0.5]
      (abort, Paired sphere probe did not release within post-contact timeout)
    o<pair_release_timeout_hard_abort> endif
  o<pair_release_timeout> endif

  #<release_normal_complete> = 0.0
  #<release_level_sum> = [#<_hal[t_probe-in]> + #<_hal[probe-mux]> + #<_hal[tcpc-probe-abnormal-level]> + #<_hal[tcpc_probe_fault_pause.out]>]
  o<pair_release_boundary_level_activity> if [#<release_level_sum> GT 0.5]
    #<release_extra_seen> = 1.0
  o<pair_release_boundary_level_activity> endif
  o<pair_release_boundary_ready> if [[[#<release_extra_seen> LT 0.5] AND [#971 LT 0.5]] AND [[#<_hal[tcpc_probe_gate_ignore.out]> LT 0.5] AND [#<release_level_sum> LT 0.5]]]
    #<release_normal_complete> = 1.0
  o<pair_release_boundary_ready> endif
  o<pair_release_normal_wait> while [[[#<release_elapsed> LT #756] AND [#<release_normal_complete> LT 0.5]] AND [[#<release_extra_seen> LT 0.5] AND [#971 LT 0.5]]]
    G4 P#793
    #<release_elapsed> = [#<release_elapsed> + #793]
    M66 E0 L0
    o<tcpc_probe_counter_guard> call
    #<release_raw> = #<_hal[counter.0.counts]>
    #<release_mux> = #<_hal[counter.1.counts]>
    #<release_gated> = #<_hal[counter.2.counts]>
    o<pair_release_normal_raw_monotonic> if [#<release_raw> LT #<release_last_raw>]
      (abort, Raw probe counter moved backwards while waiting for ignore clear)
    o<pair_release_normal_raw_monotonic> endif
    o<pair_release_normal_mux_monotonic> if [#<release_mux> LT #<release_last_mux>]
      (abort, Probe mux counter moved backwards while waiting for ignore clear)
    o<pair_release_normal_mux_monotonic> endif
    o<pair_release_normal_gated_exact> if [ABS[#<release_gated> - #925] GT 0.000001]
      (abort, Gated probe counter changed outside G38 while waiting for ignore clear)
    o<pair_release_normal_gated_exact> endif
    o<pair_release_normal_gate_clear> if [[[#<_hal[motion.digital-out-00]> + #<_hal[motion.digital-out-01]> + #<_hal[tcpc-probe-gate-enable]> + #<_hal[motion.probe-input]>] GT 0.5]]
      (abort, Probe gate activated while waiting for post-contact ignore clear)
