  o<tcpc_contact_trace_begin> call [4.0] [0.0]
  o<tcpc_pair_probe_ready_guard> call [#520] [#521]
  o<tcpc_contact_trace_begin> call [4.0] [0.0]
  o<tcpc_pair_probe_final_guard> call [#520] [#521]
  G38.3 X#122 Y#123 Z#124
  #<trace_vp_travel> = #511
  o<trace_vp_touched> if [#5070 GT 0.5]
    #<trace_vp_travel> = [[[#<vp_start_x> - #5061] * #536] + [[#<vp_start_y> - #5062] * #537] + [[#<vp_start_z> - #5063] * #538]]
  o<trace_vp_touched> endif
  o<tcpc_contact_trace_post> call [#5070] [#<trace_vp_travel>]
  o<vp4_fail> if [#5070 EQ 0]
    F#507
    G1 X[-#122] Y[-#123] Z[-#124]
    G90
    G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
    M66 E0 L0
    M65 P0
    M65 P1
    o<tcpc_contact_trace_finish> call [1.0]
    (abort, Four-contact +V touch did not record point data)
  o<vp4_fail> endif
  #<qvp_x> = #5061
  #<qvp_y> = #5062
  #<qvp_z> = #5063
  #616 = [[[#<vp_start_x> - #<qvp_x>] * #536] + [[#<vp_start_y> - #<qvp_y>] * #537] + [[#<vp_start_z> - #<qvp_z>] * #538]]
  #125 = [#536 * #512]
  #126 = [#537 * #512]
  #127 = [#538 * #512]
  G91
  F#507
  G1 X#125 Y#126 Z#127
  G90
  G1 X#<vp_clear_x> Y#<vp_clear_y> Z#<vp_clear_z>
  G1 X#<top_clear_x> Y#<top_clear_y> Z#<top_clear_z>
  o<tcpc_pair_release_guard> call [#520] [#521] [1.0]
  o<tcpc_contact_trace_finish> call [0.0]

  #<qu_abs_x> = [#<qu_x> + #540]
  #<qu_abs_y> = [#<qu_y> + #541]
  #<qu_abs_z> = [#<qu_z> + #542]
  #<qvm_abs_x> = [#<qvm_x> + #540]
  #<qvm_abs_y> = [#<qvm_y> + #541]
  #<qvm_abs_z> = [#<qvm_z> + #542]
  #<qvp_abs_x> = [#<qvp_x> + #540]
  #<qvp_abs_y> = [#<qvp_y> + #541]
  #<qvp_abs_z> = [#<qvp_z> + #542]

  (Certified-radius single-side reconstruction in the orthonormal W/U/V basis.)
  #<center_w> = [[[#<qw_abs_x> * #530] + [#<qw_abs_y> * #531] + [#<qw_abs_z> * #532]] + #505]
  #<center_u> = [[[#<qu_abs_x> * #533] + [#<qu_abs_y> * #534] + [#<qu_abs_z> * #535]] - [#539 * #505]]
  #<center_v> = [[[[#<qvm_abs_x> * #536] + [#<qvm_abs_y> * #537] + [#<qvm_abs_z> * #538]] + [[#<qvp_abs_x> * #536] + [#<qvp_abs_y> * #537] + [#<qvp_abs_z> * #538]]] / 2.0]
  #603 = [[#530 * #<center_w>] + [#533 * #<center_u>] + [#536 * #<center_v>]]
  #604 = [[#531 * #<center_w>] + [#534 * #<center_u>] + [#537 * #<center_v>]]
  #605 = [[#532 * #<center_w>] + [#535 * #<center_u>] + [#538 * #<center_v>]]

  #600 = [#<top_center_abs_x> - #540]
  #601 = [#<top_center_abs_y> - #541]
  #602 = [#<top_center_abs_z> - #542]
  #<corr_x> = [#603 - #<top_center_abs_x>]
  #<corr_y> = [#604 - #<top_center_abs_y>]
  #<corr_z> = [#605 - #<top_center_abs_z>]
  #606 = [[#<corr_x> * #533] + [#<corr_y> * #534] + [#<corr_z> * #535]]
  #607 = [[#<corr_x> * #536] + [#<corr_y> * #537] + [#<corr_z> * #538]]
  #630 = SQRT[[#<corr_x> * #<corr_x>] + [#<corr_y> * #<corr_y>] + [#<corr_z> * #<corr_z>]]

  (Only V has two measured opposing contacts; never report a U diameter.)
  #<v_dx> = [#<qvp_abs_x> - #<qvm_abs_x>]
  #<v_dy> = [#<qvp_abs_y> - #<qvm_abs_y>]
  #<v_dz> = [#<qvp_abs_z> - #<qvm_abs_z>]
  #609 = [[#<v_dx> * #536] + [#<v_dy> * #537] + [#<v_dz> * #538]]
  #611 = [#609 - [2.0 * #504]]
  #614 = 0.0

  (Full radial residuals expose inconsistent contacts not visible in projections.)
  #<rw> = SQRT[[[#603 - #<qw_abs_x>] * [#603 - #<qw_abs_x>]] + [[#604 - #<qw_abs_y>] * [#604 - #<qw_abs_y>]] + [[#605 - #<qw_abs_z>] * [#605 - #<qw_abs_z>]]]
  #<ru> = SQRT[[[#603 - #<qu_abs_x>] * [#603 - #<qu_abs_x>]] + [[#604 - #<qu_abs_y>] * [#604 - #<qu_abs_y>]] + [[#605 - #<qu_abs_z>] * [#605 - #<qu_abs_z>]]]
  #<rvm> = SQRT[[[#603 - #<qvm_abs_x>] * [#603 - #<qvm_abs_x>]] + [[#604 - #<qvm_abs_y>] * [#604 - #<qvm_abs_y>]] + [[#605 - #<qvm_abs_z>] * [#605 - #<qvm_abs_z>]]]
  #<rvp> = SQRT[[[#603 - #<qvp_abs_x>] * [#603 - #<qvp_abs_x>]] + [[#604 - #<qvp_abs_y>] * [#604 - #<qvp_abs_y>]] + [[#605 - #<qvp_abs_z>] * [#605 - #<qvp_abs_z>]]]
  #631 = ABS[#<rw> - #505]
  #632 = ABS[#<ru> - #505]
  #633 = ABS[#<rvm> - #505]
  #634 = ABS[#<rvp> - #505]

  (Capture rotary, endpoint, and linear-axis state for the accepted-row schema.)
  #150 = #<_hal[joint.3.pos-cmd]>
  #151 = #<_hal[joint.3.pos-fb]>
  #154 = #<_hal[joint.4.pos-cmd]>
  #155 = #<_hal[joint.4.pos-fb]>
  #159 = #<_hal[b-ssi-zeroed-position]>
  #161 = #<_hal[c-ssi-zeroed-position]>
  #184 = #<_abs_x>
  #185 = #<_abs_y>
  #186 = #<_abs_z>
  #187 = #<_hal[joint.0.motor-pos-cmd]>
  #188 = #<_hal[joint.0.motor-pos-fb]>
  #189 = [#188 - #187]
  #190 = #<_hal[joint.1.motor-pos-cmd]>
  #191 = #<_hal[joint.1.motor-pos-fb]>
  #192 = [#191 - #190]
  #193 = #<_hal[joint.2.motor-pos-cmd]>
  #194 = #<_hal[joint.2.motor-pos-fb]>
  #195 = [#194 - #193]

  (DEBUG, TCPC_VECTOR4 pass #<pass_id> accepted #<accepted>)
  (DEBUG, TCPC_VECTOR4 center #603 #604 #605 correction_norm=#630)
  (DEBUG, TCPC_VECTOR4 v_diam=#611 radial_residuals=#631/#632/#633/#634)
o<tcpc_vector_sphere_pass4> endsub


o<tcpc_measure_pose> sub
  #<target_b> = #1
  #<target_c> = #2
  (Arguments #3 and #4 are reserved; pose inspection M0s are disabled.)

  (Fail before any retract, index, or positioning move if live state changed.)
  o<tcpc_pair_selector_guard> call
  o<tcpc_length_model_guard> call
  o<pair_first_pose_start_guard> if [#700 LT 0.5]
    o<tcpc_gap_motion_ready_guard> call [#<target_b>] [#<target_c>]
  o<pair_first_pose_start_guard> else
    o<tcpc_gap_motion_ready_guard> call [#<_abs_b>] [#<_abs_c>]
  o<pair_first_pose_start_guard> endif

  (For later poses, retract along current W to the known top-clear point,)
  (then lift in machine Z, index, XY, and lower Z. A Z-only lift is not)
  (a safe pull-away when B is near +/-90.)
  o<use_high_z_transit> if [#700 GT 0.5]
    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<current_b> = #<_abs_b>
    #<current_c> = #<_abs_c>
    #<current_w_x> = [-SIN[#<current_b>] * COS[#<current_c>]]
    #<current_w_y> = [-SIN[#<current_b>] * SIN[#<current_c>]]
    #<current_w_z> = [-COS[#<current_b>]]
    #<current_clear_x> = [#701 - #540 - [#<current_w_x> * #513]]
    #<current_clear_y> = [#702 - #541 - [#<current_w_y> * #513]]
    #<current_clear_z> = [#703 - #542 - [#<current_w_z> * #513]]

    G90
    F#507
    G1 X#<current_clear_x> Y#<current_clear_y> Z#<current_clear_z>
    o<tcpc_gap_motion_ready_guard> call [#<current_b>] [#<current_c>]

    #<safe_z> = [#<_z> + #515]
    G1 Z#<safe_z>
    o<tcpc_gap_motion_ready_guard> call [#<current_b>] [#<current_c>]

    F#705
    (For a B-sign change, stop at B0/C0 at high Z so the next block is)
    (approached outward from zero. Every measured block closes at C0.)
    o<primary_sign_change_zero_transit> if [[[#<current_b> * #<target_b>] LT -0.01] AND [ABS[#<current_c>] LT 0.05] AND [ABS[#<target_c>] LT 0.05]]
      G1 B0 C0
      o<tcpc_gap_motion_ready_guard> call [0.0] [0.0]
    o<primary_sign_change_zero_transit> endif
    G1 B#<target_b> C#<target_c>
    (Verify target rotary command/feedback/SSI while still at high Z.)
    o<tcpc_gap_motion_ready_guard> call [#<target_b>] [#<target_c>]

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]

    #<start_w_x> = [-SIN[#<target_b>] * COS[#<target_c>]]
    #<start_w_y> = [-SIN[#<target_b>] * SIN[#<target_c>]]
    #<start_w_z> = [-COS[#<target_b>]]
    #<next_start_x> = [#701 - #540 - [#<start_w_x> * #513]]
    #<next_start_y> = [#702 - #541 - [#<start_w_y> * #513]]
    #<next_start_z> = [#703 - #542 - [#<start_w_z> * #513]]
    F#507
    G1 X#<next_start_x> Y#<next_start_y>
    o<tcpc_gap_motion_ready_guard> call [#<target_b>] [#<target_c>]
    F200.0
    G1 Z#<next_start_z>
    o<tcpc_gap_motion_ready_guard> call [#<target_b>] [#<target_c>]
    F#507
  o<use_high_z_transit> else
    (First pose starts at the guarded operator-set validation position.)
    (Do not issue a redundant rotary command before the first touch.)
    G90

    #540 = [#<_abs_x> - #<_x>]
    #541 = [#<_abs_y> - #<_y>]
    #542 = [#<_abs_z> - #<_z>]
  o<use_high_z_transit> endif

  (Verify commanded, feedback, and SSI pose before either probe pass.)
  o<tcpc_gap_motion_ready_guard> call [#<target_b>] [#<target_c>]

  #520 = #<_abs_b>
  #521 = #<_abs_c>

  (W points along the probe vector toward the table at this B/C pose.)
  #530 = [-SIN[#520] * COS[#521]]
  #531 = [-SIN[#520] * SIN[#521]]
  #532 = [-COS[#520]]

  (U is perpendicular to W in the tilt plane.)
  #533 = [COS[#520] * COS[#521]]
  #534 = [COS[#520] * SIN[#521]]
  #535 = [-SIN[#520]]

  (V is perpendicular to W and U.)
  #536 = [-SIN[#521]]
  #537 = [COS[#521]]
  #538 = 0.0

  (Use the upper U side: -U for B>=0, +U for B<0.)
  #539 = -1.0
  #635 = 1.0
  o<negative_b_upper_u> if [#520 LT -0.001]
    #539 = 1.0
    #635 = 2.0
  o<negative_b_upper_u> endif

  #550 = #<_x>
  #551 = #<_y>
  #552 = #<_z>

  #<pose_acquisition_try> = 0.0
  #<pose_acquisition_ok> = 0.0
  #<pose_reject_stage> = 0.0
  #<pose_reject_reason> = 0.0

  (One complete two-pass acquisition; any quality rejection aborts this attempt.)
  o<pose_acquisition_loop> while [[#<pose_acquisition_try> LT #739] AND [#<pose_acquisition_ok> LT 0.5]]
    #<pose_acquisition_try> = [#<pose_acquisition_try> + 1.0]
    #<pose_quality_ok> = 1.0
    #<pose_reject_stage> = 0.0
    #<pose_reject_reason> = 0.0
    #629 = 0.0

    (Run pass 1 from the frozen current/operator start point.)
    o<tcpc_vector_sphere_pass4> call [1.0] [#550] [#551] [#552] [0.0] [#<pose_acquisition_try>]
    #<pose_reject_stage> = 1.0
    o<pose_p1_travel_quality> if [[#612 LT #759] OR [#613 LT #759] OR [#615 LT #759] OR [#616 LT #759]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 1.0
    o<pose_p1_travel_quality> endif
    o<pose_p1_center_quality> if [#630 GE 2.0]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 2.0
    o<pose_p1_center_quality> endif
    o<pose_p1_diameter_quality> if [[#611 LT 29.5] OR [#611 GT 31.0]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 3.0
    o<pose_p1_diameter_quality> endif
    o<pose_p1_radial_quality> if [[#631 GT 1.0] OR [#632 GT 1.0] OR [#633 GT 1.0] OR [#634 GT 1.0]]
      #<pose_quality_ok> = 0.0
      #<pose_reject_reason> = 4.0
    o<pose_p1_radial_quality> endif

    o<pose_pass1_quality_ok> if [#<pose_quality_ok> GT 0.5]
      (Use the complete four-contact reconstructed center for pass 2.)
      #623 = [#603 - #540]
      #624 = [#604 - #541]
      #625 = [#605 - #542]
      #620 = [#623 - #600]
      #621 = [#624 - #601]
      #622 = [#625 - #602]

      (Start pass 2 at top clearance above the corrected center.)
      #626 = [#623 - [#530 * #513]]
      #627 = [#624 - [#531 * #513]]
      #628 = [#625 - [#532 * #513]]

      (DEBUG, TCPC_VECTOR4 correction #620 #621 #622)
      o<tcpc_vector_sphere_pass4> call [2.0] [#626] [#627] [#628] [1.0] [#<pose_acquisition_try>]
      #<pose_reject_stage> = 2.0
      o<pose_p2_travel_quality> if [[#612 LT #759] OR [#613 LT #759] OR [#615 LT #759] OR [#616 LT #759]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 5.0
      o<pose_p2_travel_quality> endif
      o<pose_p2_diameter_quality> if [[#611 LT 29.9] OR [#611 GT 30.5]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 6.0
      o<pose_p2_diameter_quality> endif
      o<pose_p2_radial_quality> if [[#630 GT 0.25] OR [#631 GT 0.25] OR [#632 GT 0.25] OR [#633 GT 0.25] OR [#634 GT 0.25]]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 7.0
      o<pose_p2_radial_quality> endif
      #629 = SQRT[[[#603 - [#623 + #540]] * [#603 - [#623 + #540]]] + [[#604 - [#624 + #541]] * [#604 - [#624 + #541]]] + [[#605 - [#625 + #542]] * [#605 - [#625 + #542]]]]
      o<pose_p2_center_agreement> if [#629 GT 0.10]
        #<pose_quality_ok> = 0.0
        #<pose_reject_reason> = 8.0
      o<pose_p2_center_agreement> endif
    o<pose_pass1_quality_ok> endif

    o<pose_quality_accept> if [#<pose_quality_ok> GT 0.5]
      #<pose_acquisition_ok> = 1.0
    o<pose_quality_accept> else
      (DEBUG, TCPC_VECTOR4 reject try=#<pose_acquisition_try> stage=#<pose_reject_stage> reason=#<pose_reject_reason> travel=#612/#613/#615/#616 correction_norm=#630 v_diam=#611 radial=#631/#632/#633/#634 center_delta=#629)
      o<pose_quality_retry_available> if [#<pose_acquisition_try> LT #739]
        (DEBUG, TCPC_VECTOR4 retrying complete pose after release check)
        o<tcpc_gap_motion_ready_guard> call [#520] [#521]
        G90
        F#507
        G1 X#550 Y#551 Z#552
        o<tcpc_gap_motion_ready_guard> call [#520] [#521]
        o<tcpc_pair_release_guard> call [#520] [#521] [0.0]
      o<pose_quality_retry_available> endif
    o<pose_quality_accept> endif
  o<pose_acquisition_loop> endwhile

  o<pose_quality_retry_exhausted> if [#<pose_acquisition_ok> LT 0.5]
    (abort, Sphere pose quality failed; retain partial and restart with a new attempt)
  o<pose_quality_retry_exhausted> endif

  #700 = 1.0
  #701 = #603
  #702 = #604
  #703 = #605

  o<pair_summary_logging> if [#714 GT 0.5]
    (Refresh the logged fields and reject state changes after the accepted pass.)
    o<tcpc_pair_selector_guard> call
    o<tcpc_gap_motion_ready_guard> call [#520] [#521]
    o<tcpc_length_model_guard> call
    (Freeze the guarded model snapshot before writing any accepted-row file.)
    #980 = #<_hal[headheadkins.length-model.id]>
    #981 = #<_hal[headheadkins.length-model.expected-id]>
    #982 = #<_hal[headheadkins.length-model.configured]>
    #983 = #<_hal[headheadkins.length-model.valid]>
    #984 = #<_hal[headheadkins.length-model.fault-code]>
    #985 = #<_hal[headheadkins.length-model.q]>
    #986 = #<_hal[headheadkins.tool-offset-eval.b]>
    #987 = #<_hal[headheadkins.tool-offset-eval.c]>
    #988 = #<_hal[headheadkins.tool-offset-eval.length]>
    #989 = #<_hal[headheadkins.length-model.diff-offset.x]>
    #990 = #<_hal[headheadkins.length-model.diff-offset.y]>
    #991 = #<_hal[headheadkins.length-model.diff-offset.z]>
    #992 = #<_hal[headheadkins.length-model.diff-offset-norm]>
    #993 = #<_hal[headheadkins.empirical-offset.x]>
    #994 = #<_hal[headheadkins.empirical-offset.y]>
    #995 = #<_hal[headheadkins.empirical-offset.z]>
    #996 = #<_hal[headheadkins.empirical-offset-norm]>
    #726 = [#726 + 1.0]
    #788 = [#788 + 1.0]
    (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-length-aware-t4-new-location-2026082701-attempt7-recovery-results.csv)
    (LOG,1.0,#715,#711,#727,#726,#728,#729,#738,4.0,#635,#520,#521,#719,#516,#502,#501,#505,#603,#604,#605,#606,#607,#630,#611,#629,#631,#632,#633,#634,#612,#613,#615,#616)
    (LOGCLOSE)
    (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-length-aware-t4-new-location-2026082701-attempt7-recovery-state.csv)
    (LOG,1.0,#715,#711,#727,#726,#520,#521,#718,#720,#721,#722,#723,#724,#725,#517,#518,#519,#150,#151,#154,#155,#159,#161,#184,#185,#186,#187,#188,#189,#190,#191,#192,#193,#194,#195)
    (LOGCLOSE)
    #977 = [#977 + 1.0]
    (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-length-aware-t4-new-location-2026082701-attempt7-recovery-model-state.csv)
    (LOG,1.0,#715,#711,#727,#726,#980,#981,#982,#983,#984,#985,#986,#987,#988,#989,#990,#991,#992,#993,#994,#995,#996)
    (LOGCLOSE)
  o<pair_summary_logging> endif

o<tcpc_measure_pose> endsub

o<tcpc_primary_closure_guard> sub
  #<closure_dx> = [#701 - #1]
  #<closure_dy> = [#702 - #2]
  #<closure_dz> = [#703 - #3]
  #<closure_norm> = SQRT[[#<closure_dx> * #<closure_dx>] + [#<closure_dy> * #<closure_dy>] + [#<closure_dz> * #<closure_dz>]]
  #<closure_pass> = 1.0
  o<primary_closure_failed> if [#<closure_norm> GT 0.050]
    #<closure_pass> = 0.0
  o<primary_closure_failed> endif
  o<tcpc_gap_motion_ready_guard> call [#520] [#521]
  (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-length-aware-t4-new-location-2026082701-attempt7-recovery-closures.csv)
  (LOG,1.0,#715,#711,#727,#4,#5,#6,#520,#521,#<closure_dx>,#<closure_dy>,#<closure_dz>,#<closure_norm>,0.050,#<closure_pass>)
  (LOGCLOSE)
  #978 = [#978 + 1.0]
  (DEBUG, TCPC_LENGTH_AWARE_T4 closure block=#4 open=#5 close=#6 norm=#<closure_norm>)
  o<primary_closure_limit> if [#<closure_pass> LT 0.5]
    (abort, T4 primary same-pose closure exceeds 0.050 mm; retain rows and restart with a new attempt)
  o<primary_closure_limit> endif
o<tcpc_primary_closure_guard> endsub

o<tcpc_external_continuity_guard> sub
  #<external_dx> = [#701 - #1]
  #<external_dy> = [#702 - #2]
  #<external_dz> = [#703 - #3]
  #<external_norm> = SQRT[[#<external_dx> * #<external_dx>] + [#<external_dy> * #<external_dy>] + [#<external_dz> * #<external_dz>]]
  #<external_pass> = 1.0
  o<external_continuity_failed> if [#<external_norm> GT 0.100]
    #<external_pass> = 0.0
  o<external_continuity_failed> endif
  o<tcpc_gap_motion_ready_guard> call [#520] [#521]
  (LOGAPPEND,/home/cnc5/linuxcnc-dev/configs/5th_axis_xyzbc_ssi_tcpc_probe_basic/tcpc-length-aware-t4-new-location-2026082701-attempt7-recovery-closures.csv)
  (LOG,1.0,#715,#711,#727,#4,#5,#6,#520,#521,#<external_dx>,#<external_dy>,#<external_dz>,#<external_norm>,0.100,#<external_pass>)
  (LOGCLOSE)
  #978 = [#978 + 1.0]
  (DEBUG, TCPC_LENGTH_AWARE_T4 external continuity block=#4 open=#5 close=#6 norm=#<external_norm>)
  o<external_continuity_limit> if [#<external_pass> LT 0.5]
    (abort, T4 cross-attempt continuity exceeds 0.100 mm; retain rows and restart with a new attempt)
  o<external_continuity_limit> endif
o<tcpc_external_continuity_guard> endsub

o<tcpc_primary_outer_reference> sub
  #<outer_slot> = #1
  #<outer_base> = [800 + [3 * [#<outer_slot> - 1]]]
